# 06_fit_final_clusters.py
"""
Fit the final k-means model and persist everything downstream needs.

Writes:
  <city>_regimes.csv                        daily features + regime + cluster_index
  <city>_cluster_centroids_standardized.csv centroids in z-space
  <city>_cluster_centroids_physical.csv     centroids in original units
  <city>_scaler.json                        mean/scale for reuse

FIX vs your original: the raw 0-indexed cluster label is now stored as its
own column. Script 08 previously recovered it by alphabetically sorting
regime strings ("SIN1".."SIN4"), which works only while k < 10 and would
silently mis-assign centroids at k >= 10.

Usage:
    python 06_fit_final_clusters.py --all
"""

import json

import numpy as np
import pandas as pd

from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

import config
import utils


def fit(city):

    utils.banner(f"FINAL CLUSTERING: {city}")

    cfg = config.city_config(city)

    final_k = cfg["final_k"]

    if final_k is None:
        raise ValueError(
            f"config.CITIES['{city}']['final_k'] is None.\n"
            f"Run 05_cluster_sweep.py, inspect the diagnostics, then set "
            f"final_k in config.py."
        )

    base = config.processed_dir(city)

    daily = pd.read_csv(
        base / f"{city}_daily_features.csv",
        parse_dates=["date"],
    )

    X = daily[config.FEATURES]

    scaler = StandardScaler()
    Z = scaler.fit_transform(X)

    model = KMeans(
        n_clusters=final_k,
        n_init=config.KMEANS_N_INIT,
        random_state=config.RANDOM_SEED,
    )

    labels = model.fit_predict(Z)

    # -----------------------------------------------------
    # ORDER CLUSTERS BY FREQUENCY
    # -----------------------------------------------------
    #
    # Makes labels stable and readable: regime 1 is always the most common.
    # Without this, k-means index order is arbitrary and the meaning of
    # "SIN1" could change if you re-run with a different seed.
    # -----------------------------------------------------

    order = (
        pd.Series(labels)
        .value_counts()
        .index
        .tolist()
    )

    remap = {old: new for new, old in enumerate(order)}

    cluster_index = np.array([remap[label] for label in labels])

    centers = model.cluster_centers_[order]

    prefix = cfg["label_prefix"]

    daily["cluster_index"] = cluster_index
    daily["regime"] = [f"{prefix}{i + 1}" for i in cluster_index]

    daily.to_csv(base / f"{city}_regimes.csv", index=False)

    # -----------------------------------------------------
    # CENTROIDS
    # -----------------------------------------------------

    centroids = pd.DataFrame(centers, columns=config.FEATURES)
    centroids.insert(0, "cluster_index", range(final_k))
    centroids.insert(
        1, "regime", [f"{prefix}{i + 1}" for i in range(final_k)]
    )

    centroids.to_csv(
        base / f"{city}_cluster_centroids_standardized.csv",
        index=False,
    )

    physical = pd.DataFrame(
        scaler.inverse_transform(centers),
        columns=config.FEATURES,
    )
    physical.insert(0, "cluster_index", range(final_k))
    physical.insert(
        1, "regime", [f"{prefix}{i + 1}" for i in range(final_k)]
    )

    physical.to_csv(
        base / f"{city}_cluster_centroids_physical.csv",
        index=False,
    )

    # -----------------------------------------------------
    # SCALER
    # -----------------------------------------------------

    with open(base / f"{city}_scaler.json", "w") as f:
        json.dump(
            {
                "features": config.FEATURES,
                "mean": scaler.mean_.tolist(),
                "scale": scaler.scale_.tolist(),
                "k": final_k,
                "random_seed": config.RANDOM_SEED,
                "inertia": float(model.inertia_),
            },
            f,
            indent=2,
        )

    # -----------------------------------------------------
    # REPORT
    # -----------------------------------------------------

    counts = daily["regime"].value_counts().sort_index()

    print(f"\n  k = {final_k}, n = {len(daily)} days\n")
    print("  regime   days    w_k")

    for regime, n in counts.items():
        print(f"  {regime:8s} {n:5d}  {n / len(daily):.3f}")

    print("\n  Centroids in physical units:")
    print(
        physical.drop(columns=["cluster_index"])
        .round(2)
        .to_string(index=False)
    )

    print(f"\n  Saved outputs to {base}")


def main():

    cities = utils.parse_cities("Fit final k-means clusters.")

    for city in cities:
        fit(city)


if __name__ == "__main__":
    main()

# utils.py
"""
Shared helpers for Phase 2.

Keeping time-zone conversion in ONE place matters: scripts 04 and 11 must
use identical local-time logic, or the days you cluster will not be the
days you extract for Phase 3.
"""

import argparse

import pandas as pd

import config


# ---------------------------------------------------------
# COMMAND-LINE INTERFACE
# ---------------------------------------------------------

def parse_cities(description, with_year=False):
    """Standard CLI: --city singapore | --all [--year 2021]"""

    parser = argparse.ArgumentParser(description=description)

    group = parser.add_mutually_exclusive_group(required=True)

    group.add_argument(
        "--city",
        choices=config.ALL_CITIES,
        help="Run for a single city.",
    )

    group.add_argument(
        "--all",
        action="store_true",
        help="Run for every city in config.CITIES.",
    )

    if with_year:
        parser.add_argument(
            "--year",
            type=int,
            default=None,
            help="Single year. Omit to run every year in config.YEARS.",
        )

    args = parser.parse_args()

    cities = config.ALL_CITIES if args.all else [args.city]

    if with_year:
        years = [args.year] if args.year else config.YEARS
        return cities, years

    return cities


# ---------------------------------------------------------
# TIME CONVERSION
# ---------------------------------------------------------

def to_local(times, city):
    """UTC timestamps -> naive local timestamps for this city."""

    cfg = config.city_config(city)

    times = pd.to_datetime(times)

    if config.USE_DST:
        return (
            times
            .tz_localize("UTC")
            .tz_convert(cfg["timezone"])
            .tz_localize(None)
        )

    return times + pd.Timedelta(hours=cfg["utc_offset_hours"])


def local_day_bounds_utc(date, city):
    """
    A local calendar date -> (utc_start, utc_end) covering that local day.

    Returns naive UTC timestamps suitable for xarray .sel(time=slice(...)).
    """

    cfg = config.city_config(city)

    local_start = pd.Timestamp(date).normalize()
    local_end = local_start + pd.Timedelta(hours=23)

    if config.USE_DST:
        tz = cfg["timezone"]
        utc_start = (
            local_start
            .tz_localize(tz, nonexistent="shift_forward", ambiguous=True)
            .tz_convert("UTC")
            .tz_localize(None)
        )
        utc_end = (
            local_end
            .tz_localize(tz, nonexistent="shift_forward", ambiguous=True)
            .tz_convert("UTC")
            .tz_localize(None)
        )
        return utc_start, utc_end

    offset = pd.Timedelta(hours=cfg["utc_offset_hours"])

    return local_start - offset, local_end - offset


def assign_block(hour):
    """Map a local hour to a 6-hour block index 1..4."""
    return int(hour) // config.BLOCK_HOURS + 1


# ---------------------------------------------------------
# DATA LOADING
# ---------------------------------------------------------

def find_raw_files(city, year):
    """
    Locate raw ERA5 files for a city/year.

    Accepts GRIB or NetCDF, per-year or multi-year, because the CDS API
    returns different things depending on the 'data_format' key and the
    dataset requested.
    """

    directory = config.raw_dir(city)

    if not directory.exists():
        raise FileNotFoundError(
            f"Raw directory does not exist: {directory}\n"
            f"Run 00_download_era5.py first, or move your existing "
            f"downloads into this folder."
        )

    patterns = [
        f"*{year}*.grib", f"*{year}*.grb", f"*{year}*.nc",
    ]

    files = []
    for pattern in patterns:
        files.extend(sorted(directory.glob(pattern)))

    if files:
        return files

    # Fall back to any multi-year file in the folder; the caller will
    # subset by year after opening.
    fallback = (
        sorted(directory.glob("*.grib"))
        + sorted(directory.glob("*.grb"))
        + sorted(directory.glob("*.nc"))
    )

    if not fallback:
        raise FileNotFoundError(
            f"No GRIB or NetCDF files found in {directory}"
        )

    print(
        f"  No file matching year {year}; falling back to "
        f"{len(fallback)} file(s) and subsetting by time."
    )

    return fallback


def open_any(path):
    """Open a GRIB or NetCDF file, returning a list of xarray Datasets."""

    import xarray as xr

    suffix = path.suffix.lower()

    if suffix in {".grib", ".grb", ".grib2"}:
        import cfgrib
        return cfgrib.open_datasets(str(path))

    if suffix == ".nc":
        return [xr.open_dataset(path)]

    raise ValueError(f"Unrecognised file type: {path}")


def standardize_time(ds):
    """ERA5 sometimes calls the time axis 'valid_time'. Normalise it."""

    if "valid_time" in ds.dims or "valid_time" in ds.coords:
        if "time" in ds.coords and "time" not in ds.dims:
            ds = ds.drop_vars("time")
        ds = ds.rename({"valid_time": "time"})

    if "time" not in ds.coords:
        raise ValueError(
            f"No usable time coordinate. Coords present: {list(ds.coords)}"
        )

    return ds


def spatial_dims(ds):
    """Return whichever horizontal dimension names this dataset uses."""

    candidates = ["latitude", "longitude", "lat", "lon", "x", "y"]

    return [d for d in candidates if d in ds.dims]


def banner(text):
    print("\n" + "=" * 68)
    print(text)
    print("=" * 68)

# 00_download_era5.py
"""
Download ERA5 single-level data for every city and year.

FIXES vs your original ERA5_data_script.py:
  1. Years are 2021-2025 (from config), not 2020-2024. Your original window
     was off by one year at both ends relative to the research plan.
  2. Files are written per city AND per year into data/raw/meteorology/<city>/,
     which is where script 02 looks for them. The original wrote one
     multi-year file into the current working directory.
  3. Uses 'data_format' (the current CDS API key). The old 'format' key is
     ignored by the new CDS backend, which is why you may have received GRIB
     when you asked for NetCDF.
  4. Skips files that already exist, so an interrupted run can resume.
  5. Requests one month at a time, then merges into a single per-year file.
     A whole-year request (12 months x 31 days x 24 hours x 5 variables) is
     rejected by the CDS backend with "403 cost limits exceeded"; a
     one-month request is well under that limit.
  6. Each monthly download actually arrives as a zip (despite the '.nc' name
     and 'download_format: unarchived') because this variable mix spans two
     GRIB stepTypes (instant: u10/v10/t2m/blh, accum: tp), and CDS splits
     those into separate files inside the zip. This script transparently
     unzips, merges the stepType groups, and concatenates months, so the
     final per-year file on disk is genuine single-group NetCDF and script
     02 needs no changes.

Requires a ~/.cdsapirc with your CDS credentials.
"""

import zipfile
from tempfile import TemporaryDirectory

import cdsapi
import xarray as xr

import config


DATA_FORMAT = "netcdf"      # "netcdf" or "grib" - script 02 handles both

MONTHS = [f"{m:02d}" for m in range(1, 13)]
DAYS = [f"{d:02d}" for d in range(1, 32)]
TIMES = [f"{h:02d}:00" for h in range(24)]


def load_month_dataset(path):
    """Open one month's download, transparently unzipping if needed."""

    if not zipfile.is_zipfile(path):
        return xr.load_dataset(path)

    with TemporaryDirectory() as tmp_dir:
        with zipfile.ZipFile(path) as zf:
            zf.extractall(tmp_dir)
            names = zf.namelist()

        groups = [xr.load_dataset(f"{tmp_dir}/{name}") for name in names]

    return xr.merge(groups, join="inner", compat="override")


def download(client, city, year):

    cfg = config.city_config(city)

    out_dir = config.raw_dir(city)
    out_dir.mkdir(parents=True, exist_ok=True)

    suffix = "nc" if DATA_FORMAT == "netcdf" else "grib"

    target = out_dir / f"{city}_era5_{year}.{suffix}"

    if target.exists():
        print(f"  Already present, skipping: {target.name}")
        return

    month_files = []

    for month in MONTHS:

        month_file = out_dir / f"_tmp_{city}_era5_{year}_{month}.{suffix}"
        month_files.append(month_file)

        if month_file.exists():
            print(f"  Month already present, skipping: {month_file.name}")
            continue

        print(f"  Requesting {city} {year}-{month} -> {month_file.name}")

        client.retrieve(
            "reanalysis-era5-single-levels",
            {
                "product_type": "reanalysis",
                "data_format": DATA_FORMAT,
                "download_format": "unarchived",
                "variable": config.ERA5_VARIABLES,
                "year": [str(year)],
                "month": [month],
                "day": DAYS,
                "time": TIMES,
                "area": cfg["area"],       # [North, West, South, East]
            },
            str(month_file),
        )

    print(f"  Merging {len(month_files)} months -> {target.name}")

    monthly = [load_month_dataset(f) for f in month_files]
    time_dim = "valid_time" if "valid_time" in monthly[0].dims else "time"

    ds = xr.concat(monthly, dim=time_dim).sortby(time_dim)
    ds.to_netcdf(target)

    for month_file in month_files:
        month_file.unlink()

    print(f"  Saved {target}")


def main():

    client = cdsapi.Client()

    for city in config.ALL_CITIES:

        print(f"\n--- {city.upper()} ---")

        for year in config.YEARS:
            download(client, city, year)

    print("\nAll downloads complete.")


if __name__ == "__main__":
    main()

