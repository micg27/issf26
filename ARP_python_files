            ax.set_xticks([])
            ax.set_yticks([])
    fig.suptitle(f"{city}: daily-mean local PM2.5 on candidate cells (representative days)")
    fig.tight_layout()
    fig.savefig(config.output_dir(city, "scenarios") / "examples.png", dpi=120)
    plt.close(fig)


