# transport.py
"""
Reduced-order 2D advection-diffusion model for PM2.5 on a city domain.

The state is the column-mean concentration C (ug/m3) of a well-mixed
boundary layer of depth h(x, y, t):

    dC/dt + u . grad C = K lap C + E / h - lam C + (w_e / h) (C_bg - C)

Advection is in ADVECTIVE form (u . grad C), not flux form (div(u C)).
The two differ by C div(u). The interpolated ERA5 10 m wind is divergent
(up to ~1e-4 s-1), and in flux form that term spuriously concentrates or
dilutes even a uniform field, by tens of percent per hour. Physically,
low-level convergence is balanced by vertical motion that carries air of
the same well-mixed concentration, so a uniform field must stay uniform.
The scheme computes TVD fluxes and then adds back C div(u) per axis.
For a uniform field the two cancel exactly.

    u, v   10 m wind from ERA5 (hourly, bilinear in space, linear in time)
    h      ERA5 boundary-layer height, floored at H_MIN_M
    E      surface emission flux (ug m-2 s-1)
    K      horizontal eddy diffusivity (m2 s-1)          -- calibrated
    lam    first-order loss rate (deposition etc., s-1)  -- calibrated
    w_e    entrainment velocity max(dh/dt, 0): a growing boundary layer
           mixes in background air from above
    C_bg   background (regional) concentration, also used at inflow edges

The equation is linear in (E, C_bg) with the initial state set to C_bg,
so a run with several "tracers" (unit emissions, unit background, one per
loss rate) gives every combination calibration needs from one pass.

Numerics: finite volumes on the 2 km domain raster. Advection is
dimensionally split with a second-order TVD scheme (MC limiter), so that
numerical diffusion stays well below the physical K being calibrated. A
first-order upwind scheme would add ~u*dx/2 ~ 3000 m2/s of numerical
diffusion at 3 m/s, swamping K. Diffusion is explicit. Sources, loss and
entrainment are integrated exactly over each step (exponential update).
Time step: the largest dt with Courant number <= CFL and diffusion
number <= 0.2, so that each hour divides into a whole number of steps.
"""

import numpy as np
import pandas as pd
import xarray as xr
from pyproj import Transformer
from scipy.interpolate import RegularGridInterpolator

H_MIN_M = 50.0        # floor on boundary-layer height (ERA5 nights reach ~10 m)
CFL = 0.8


# ---------------------------------------------------------
# METEOROLOGY ON THE DOMAIN
# ---------------------------------------------------------

def load_met(city, phase2_dir, utc_start, utc_end):
    """Hourly u10/v10/blh (UTC) from Phase 2's processed yearly files."""
    years = range(utc_start.year, utc_end.year + 1)
    files = [phase2_dir / city / f"{city}_hourly_{y}.nc" for y in years]
    ds = xr.open_mfdataset(files, combine="by_coords")[["u10", "v10", "blh"]]
    ds = ds.sel(time=slice(utc_start, utc_end)).load()
    n_expected = int((utc_end - utc_start) / pd.Timedelta(hours=1)) + 1
    assert ds.sizes["time"] == n_expected, (
        f"{city}: met has {ds.sizes['time']} hours in {utc_start}..{utc_end}, "
        f"expected {n_expected}"
    )
    return ds


def met_to_domain(met, domain):
    """Interpolate ERA5 fields onto domain cell centres.

    Bilinear in (lat, lon). Cells outside the ERA5 point grid take the
    nearest edge value (Singapore's ERA5 box has only 2 x 2 points, so its
    western third is extrapolated this way).
    Returns arrays shaped (n_hours, ny, nx).
    """
    to_ll = Transformer.from_crs(domain.attrs["crs"], "EPSG:4326", always_xy=True)
    X, Y = np.meshgrid(domain.x.values, domain.y.values)
    lon, lat = to_ll.transform(X, Y)

    lats = met.latitude.values
    lons = met.longitude.values
    order = np.argsort(lats)
    lats = lats[order]
    pts = np.column_stack([
        np.clip(lat.ravel(), lats.min(), lats.max()),
        np.clip(lon.ravel(), lons.min(), lons.max()),
    ])

    out = {}
    for var in ("u10", "v10", "blh"):
        a = met[var].values[:, order, :]
        fields = np.empty((a.shape[0],) + X.shape)
        for t in range(a.shape[0]):
            f = RegularGridInterpolator((lats, lons), a[t], method="linear")
            fields[t] = f(pts).reshape(X.shape)
        out[var] = fields
    out["blh"] = np.maximum(out["blh"], H_MIN_M)
    return out


# ---------------------------------------------------------
# NUMERICS
# ---------------------------------------------------------

def _mc_limited_slope(c, axis):
    """Monotonized-central limited slope along `axis` (zero at the edges)."""
    d_fwd = np.diff(c, axis=axis, append=np.take(c, [-1], axis=axis))
    d_bwd = np.diff(c, axis=axis, prepend=np.take(c, [0], axis=axis))
    d_cen = 0.5 * (d_fwd + d_bwd)
    same = np.sign(d_fwd) == np.sign(d_bwd)
    lim = np.minimum(np.minimum(2 * np.abs(d_fwd), 2 * np.abs(d_bwd)), np.abs(d_cen))
    return np.where(same, np.sign(d_cen) * lim, 0.0)


def _advect_1d(c, vel_face, dt, dx, bg, axis):
    """One TVD advection step along `axis` (last two axes are y, x).

    vel_face holds velocities on the n+1 faces along `axis` (positive
    toward increasing index). Ghost cells beyond the edges hold the
    background value, so inflow brings in background air and outflow
    leaves freely.
    """
    pad = [(0, 0)] * c.ndim
    pad[axis] = (2, 2)
    g = np.pad(c, pad, mode="constant")
    idx_lo = [slice(None)] * c.ndim
    idx_hi = [slice(None)] * c.ndim
    idx_lo[axis] = slice(0, 2)
    idx_hi[axis] = slice(-2, None)
    g[tuple(idx_lo)] = bg[(...,) + (None,) * (c.ndim - 1)] if np.ndim(bg) else bg
    g[tuple(idx_hi)] = bg[(...,) + (None,) * (c.ndim - 1)] if np.ndim(bg) else bg

    s = _mc_limited_slope(g, axis)
    n = c.shape[axis]
    left = [slice(None)] * c.ndim
    right = [slice(None)] * c.ndim
    left[axis] = slice(1, n + 2)      # cell to the left of each face
    right[axis] = slice(2, n + 3)     # cell to the right of each face
    cl, sl = g[tuple(left)], s[tuple(left)]
    cr, sr = g[tuple(right)], s[tuple(right)]

    nu = vel_face * dt / dx
    face_val = np.where(
        vel_face >= 0,
        cl + 0.5 * (1 - nu) * sl,
        cr - 0.5 * (1 + nu) * sr,
    )
    flux = vel_face * face_val
    lo = [slice(None)] * c.ndim
    hi = [slice(None)] * c.ndim
    lo[axis] = slice(0, n)
    hi[axis] = slice(1, n + 1)
    # Flux divergence plus the C div(u) correction -> advective form.
    vel_div = vel_face[tuple(hi)] - vel_face[tuple(lo)]
    return c - dt / dx * (flux[tuple(hi)] - flux[tuple(lo)] - c * vel_div)


def _diffuse(c, K, dt, dx, bg):
    g = np.pad(c, [(0, 0)] * (c.ndim - 2) + [(1, 1), (1, 1)], mode="edge")
    lap = (g[..., 2:, 1:-1] + g[..., :-2, 1:-1] + g[..., 1:-1, 2:] + g[..., 1:-1, :-2]
           - 4 * c) / dx**2
    return c + dt * K * lap


def _faces(field, axis):
    """Cell-centred field -> face values along axis (edges copied)."""
    inner = 0.5 * (np.take(field, range(field.shape[axis] - 1), axis=axis)
                   + np.take(field, range(1, field.shape[axis]), axis=axis))
    first = np.take(field, [0], axis=axis)
    last = np.take(field, [-1], axis=axis)
    return np.concatenate([first, inner, last], axis=axis)


# ---------------------------------------------------------
# RUN
# ---------------------------------------------------------

def run(fields, dx, emis, lam, K, bg, c0, sample_cells=None, store_hourly=False):
    """Integrate the model over all hours in `fields`.

    emis   (ntr, ny, nx) emission flux per tracer, ug m-2 s-1
    lam    (ntr,) loss rate per tracer, s-1
    K      scalar diffusivity, m2 s-1
    bg     (ntr,) background concentration per tracer, ug m-3
    c0     (ntr, ny, nx) initial state
    sample_cells (rows, cols): if given, return hour-mean concentrations at
           those cells, shape (n_hours - 1, ntr, n_cells); hour i is the
           mean over [t_i, t_i + 1 h).
    store_hourly: also return the hour-mean full fields
           (n_hours - 1, ntr, ny, nx).

    The number of hours integrated is len(fields["u10"]) - 1 (fields are
    instants at the start and end of each hour).
    """
    u_all, v_all, h_all = fields["u10"], fields["v10"], fields["blh"]
    n_hours = u_all.shape[0] - 1
    lam = np.asarray(lam, dtype=float)[:, None, None]
    bg = np.asarray(bg, dtype=float)
    c = np.array(c0, dtype=float)

    samples = [] if sample_cells is not None else None
    hourly = [] if store_hourly else None

    for i in range(n_hours):
        speed_max = max(np.abs(u_all[i:i + 2]).max(), np.abs(v_all[i:i + 2]).max(), 1e-6)
        dt_adv = CFL * dx / speed_max
        dt_dif = 0.2 * dx**2 / max(K, 1e-9)
        n_sub = int(np.ceil(3600.0 / min(dt_adv, dt_dif)))
        dt = 3600.0 / n_sub

        dhdt = (h_all[i + 1] - h_all[i]) / 3600.0
        acc = np.zeros_like(c)
        for k in range(n_sub):
            w = (k + 0.5) / n_sub
            u = (1 - w) * u_all[i] + w * u_all[i + 1]
            v = (1 - w) * v_all[i] + w * v_all[i + 1]
            h = (1 - w) * h_all[i] + w * h_all[i + 1]

            # x: columns, positive east. y: rows run north -> south, so
            # the "positive index" velocity along rows is -v.
            c = _advect_1d(c, _faces(u, axis=1)[None], dt, dx, bg, axis=2)
            c = _advect_1d(c, _faces(-v, axis=0)[None], dt, dx, bg, axis=1)
            if K > 0:
                c = _diffuse(c, K, dt, dx, bg)

            # Sources, loss and entrainment, exact over dt:
            #   dC/dt = S - k C,  S = E/h + w_e C_bg / h,  k = lam + w_e / h
            we_h = np.maximum(dhdt, 0.0) / h
            k_rate = lam + we_h[None]
            src = emis / h[None] + we_h[None] * bg[:, None, None]
            decay = np.exp(-k_rate * dt)
            c_eq = np.where(k_rate > 0, src / np.where(k_rate > 0, k_rate, 1), 0.0)
            c = np.where(k_rate > 0, c_eq + (c - c_eq) * decay, c + src * dt)

            acc += c
        mean_c = acc / n_sub
        if samples is not None:
            samples.append(mean_c[:, sample_cells[0], sample_cells[1]])
        if hourly is not None:
            hourly.append(mean_c.astype(np.float32))

    result = {"final": c}
    if samples is not None:
        result["samples"] = np.stack(samples)
    if hourly is not None:
        result["hourly"] = np.stack(hourly)
    return result

# test_transport.py
"""
Physics checks for transport.py: each case has an exact answer.

Usage:
    python test_transport.py
"""

import numpy as np

import transport as T

NY, NX, DX = 60, 80, 2000.0
YY, XX = np.mgrid[:NY, :NX]


def fields(u, v, h, n_instants):
    shape = (n_instants, NY, NX)
    return {"u10": np.full(shape, u), "v10": np.full(shape, v), "blh": np.full(shape, h)}


def blob(row, col, sigma_cells=3.0):
    return np.exp(-((XX - col) ** 2 + (YY - row) ** 2) / (2 * sigma_cells**2))[None]


def zeros():
    return np.zeros((1, NY, NX))


def test_background_stays_uniform():
    f = fields(3.0, -2.0, 500.0, 7)
    f["blh"] = np.linspace(100, 1000, 7)[:, None, None] * np.ones((7, NY, NX))  # entrainment on
    c = T.run(f, DX, zeros(), [0.0], 300.0, [10.0], np.full((1, NY, NX), 10.0))["final"]
    assert np.abs(c - 10).max() < 1e-9


def test_uniform_field_stays_uniform_in_divergent_wind():
    # Wind speeding up eastward and turning: strongly divergent. A uniform
    # field must stay uniform (no spurious concentration/dilution).
    f = fields(0.0, 0.0, 500.0, 7)
    f["u10"] = 1.0 + 6.0 * XX[None] / NX * np.ones((7, 1, 1))
    f["v10"] = -3.0 + 4.0 * YY[None] / NY * np.ones((7, 1, 1))
    c = T.run(f, DX, zeros(), [0.0], 300.0, [10.0], np.full((1, NY, NX), 10.0))["final"]
    assert np.abs(c - 10).max() < 1e-9


def test_advection_east_conserves_mass_and_moves_correctly():
    c0 = blob(30, 15)
    c = T.run(fields(4.0, 0.0, 500.0, 7), DX, zeros(), [0.0], 0.0, [0.0], c0)["final"][0]
    assert abs(c.sum() / c0.sum() - 1) < 1e-6
    shift = (c * XX).sum() / c.sum() - 15
    assert abs(shift - 4.0 * 6 * 3600 / DX) < 0.05          # 43.2 cells
    assert c.max() > 0.9                                      # low numerical diffusion


def test_northward_wind_moves_toward_row_zero():
    c0 = blob(30, 40)
    c = T.run(fields(0.0, 4.0, 500.0, 2), DX, zeros(), [0.0], 0.0, [0.0], c0)["final"][0]
    assert abs((c * YY).sum() / c.sum() - (30 - 4.0 * 3600 / DX)) < 0.05   # row 22.8


def test_emission_loss_steady_state():
    E, lam, h = 1e-3, 1 / 3600.0, 500.0
    c = T.run(fields(0.0, 0.0, h, 25), DX, np.full((1, NY, NX), E), [lam], 0.0, [0.0], zeros())["final"]
    assert abs(c[0, 30, 40] / (E / (h * lam)) - 1) < 1e-6


def test_diffusion_variance_growth():
    K, hours = 500.0, 3
    c0 = blob(30, 40)
    c = T.run(fields(0.0, 0.0, 500.0, hours + 1), DX, zeros(), [0.0], K, [0.0], c0)["final"][0]
    cx = (c * XX).sum() / c.sum()
    var = (c * (XX - cx) ** 2).sum() / c.sum() * DX**2
    growth = var - 9 * DX**2
    assert abs(growth / (2 * K * hours * 3600) - 1) < 0.01


if __name__ == "__main__":
    for name, fn in list(globals().items()):
        if name.startswith("test_"):
            fn()
            print(f"PASS {name}")

# 06_emission_ingredients.py
"""
Emission-predictability experiment (pre-stated in METHODS.md, 2026-10-04):
simulate each emission INGREDIENT once per day, so any mix of them can be
assembled later by linear superposition. Concentration is linear in
emissions, and a spatially uniform background cancels from every
reconstruction error, so local responses are all Phase 5 needs.

Tracers per day (31), each driven by that day's real weather with the
same 24 h spin-up, calibration and solver as 04_generate_scenarios.py:
    0        base: alpha x population
    1..20    base x independent mean-one lognormal noise per cell (sigma 0.5)
    21..25   unit (1 ug/s) source at each fixed site of set A
    26..30   unit source at each fixed site of set B
Fixed sites: J = 5 land cells per set, drawn once per city from the
domain land mask (seeded). They are the same on every day.

Stored: daily-mean local PM2.5 at candidate cells, per tracer.

Output: data/processed/phase3/<city>/<city>_ingredients_<period>.nc
    response (day, tracer, cell), base_total_ug_s, site rows/cols,
    date, regime, split, w_k

--k (Phase 8 sensitivity): run with diffusivity K (m2/s) instead of the
calibrated value; everything else is unchanged. Files get a "_K<value>" tag.

Usage:
    python 06_emission_ingredients.py --all --period train
    python 06_emission_ingredients.py --all --period test2025
    python 06_emission_ingredients.py --city singapore --period train --k 8000
"""

import argparse
import importlib.util
import json
from pathlib import Path

import numpy as np
import pandas as pd
import xarray as xr

import config
import transport

_spec = importlib.util.spec_from_file_location(
    "gen", Path(__file__).with_name("04_generate_scenarios.py"))
gen = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(gen)

N_AREA = 20
AREA_SIGMA = 0.5
SITES_PER_SET = 5
SITE_SETS = ("A", "B")


def parse_args():
    p = argparse.ArgumentParser(description="Simulate emission ingredients per day.")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--city", choices=config.ALL_CITIES)
    g.add_argument("--all", action="store_true")
    p.add_argument("--period", choices=["train", "test2025"], required=True)
    p.add_argument("--k", type=float, default=None, help="Phase 8: override K (m2/s)")
    a = p.parse_args()
    return (config.ALL_CITIES if a.all else [a.city]), a.period, a.k


def fixed_sites(land):
    rows, cols = np.nonzero(land)
    out = {}
    for k, name in enumerate(SITE_SETS):
        rng = np.random.default_rng([config.RANDOM_SEED, 62, k])
        pick = rng.choice(len(rows), SITES_PER_SET, replace=False)
        out[name] = (rows[pick], cols[pick])
    return out


def days_for(city, period, offset_h):
    reg = pd.read_csv(config.PHASE2_DIR / city / f"{city}_regimes_split.csv", parse_dates=["date"])
    weights = json.load(open(config.PHASE2_DIR / city / f"{city}_regime_weights.json"))["weights"]
    days = reg[reg["date"].dt.year == 2025] if period == "test2025" else reg[reg["split"] == "train"]
    days = days[["date", "regime", "split"]].reset_index(drop=True)
    first = pd.Timestamp(f"{config.phase2.START_YEAR}-01-01")
    ok = (days["date"] - pd.Timedelta(hours=offset_h + gen.SPINUP_HOURS)) >= first
    days = days[ok].reset_index(drop=True)
    days["w_k"] = days["regime"].map(weights)
    return days


def run(city, period, k_override=None):
    print(f"=== {city} {period}")
    cfg = config.city_config(city)
    pdir = config.processed_dir(city)
    domain = xr.open_dataset(pdir / f"{city}_domain.nc")
    cal = json.load(open(pdir / f"{city}_calibration.json"))
    cand = pd.read_csv(pdir / f"{city}_candidates.csv")
    cells = (cand["domain_row"].to_numpy(), cand["domain_col"].to_numpy())
    dx = domain.attrs["cell_size_m"]
    pop = domain["population"].values
    land = domain["land"].values.astype(bool)
    ny, nx = pop.shape
    K = cal["K_m2_s"] if k_override is None else k_override
    lam = 0.0 if cal["loss_efold_hours"] is None else 1 / (cal["loss_efold_hours"] * 3600)
    base = cal["alpha_ug_per_s_per_person"] * pop
    sites = fixed_sites(land)
    days = days_for(city, period, cfg["utc_offset_hours"])

    n_tr = 1 + N_AREA + SITES_PER_SET * len(SITE_SETS)
    D, C = len(days), len(cand)
    resp = np.empty((D, n_tr, C), dtype=np.float32)
    site_emis = np.zeros((SITES_PER_SET * len(SITE_SETS), ny, nx))
    for k, name in enumerate(SITE_SETS):
        r, c = sites[name]
        for j in range(SITES_PER_SET):
            site_emis[k * SITES_PER_SET + j, r[j], c[j]] = 1.0          # 1 ug/s

    for d, row in days.iterrows():
        emis = np.empty((n_tr, ny, nx))
        emis[0] = base
        for m in range(1, N_AREA + 1):
            rng = np.random.default_rng([config.RANDOM_SEED, 61, row["date"].year,
                                         row["date"].dayofyear, m])
            emis[m] = base * rng.lognormal(-AREA_SIGMA**2 / 2, AREA_SIGMA, base.shape)
        emis[N_AREA + 1:] = site_emis
        utc_start = (row["date"] - pd.Timedelta(hours=cfg["utc_offset_hours"])
                     - pd.Timedelta(hours=gen.SPINUP_HOURS))
        met = transport.load_met(city, config.PHASE2_DIR, utc_start,
                                 utc_start + pd.Timedelta(hours=gen.SPINUP_HOURS + 24))
        fields = transport.met_to_domain(met, domain)
        r = transport.run(fields, dx, emis / dx**2, np.full(n_tr, lam), K, np.zeros(n_tr),
                          np.zeros((n_tr, ny, nx)), sample_cells=cells)
        resp[d] = r["samples"][gen.SPINUP_HOURS:].mean(axis=0)
        print(f"  {d + 1}/{D} {row['date'].date()}", end="\r", flush=True)
    print()

    site_rows = np.concatenate([sites[s][0] for s in SITE_SETS])
    site_cols = np.concatenate([sites[s][1] for s in SITE_SETS])
    ds = xr.Dataset(
        {
            "response": (("day", "tracer", "cell"), resp,
                         {"units": "ug m-3 (daily mean, local only)",
                          "tracers": "0 base; 1-20 area-noise members; 21-25 site set A; 26-30 site set B",
                          "site_units": "site tracers are per 1 ug/s"}),
            "site_row": ("site", site_rows), "site_col": ("site", site_cols),
            "site_x": ("site", domain.x.values[site_cols]), "site_y": ("site", domain.y.values[site_rows]),
            "date": ("day", days["date"].to_numpy()),
            "regime": ("day", days["regime"].to_numpy().astype(str)),
            "split": ("day", days["split"].to_numpy().astype(str)),
            "w_k": ("day", days["w_k"].to_numpy()),
            "cell_id": ("cell", cand["id"].to_numpy()),
        },
        attrs={"city": city, "period": period, "K_m2_s": K, "base_total_ug_s": float(base.sum()),
               "area_sigma": AREA_SIGMA, "sites_per_set": SITES_PER_SET,
               "seeds": "area [SEED,61,year,doy,m]; sites [SEED,62,set]"},
    )
    tag = "" if k_override is None else f"_K{k_override:g}"
    path = pdir / f"{city}_ingredients_{period}{tag}.nc"
    ds.to_netcdf(path, encoding={"response": {"zlib": True, "complevel": 4}})
    print(f"  wrote {path} ({D} days x {n_tr} tracers)")


if __name__ == "__main__":
    cities, period, k = parse_args()
    for city in cities:
        run(city, period, k)

# 01_build_domain.py
"""
Build each city's transport-model domain and its population field.

The domain is a regular 2 km raster aligned exactly with the Phase 1
candidate grid (same origin and cell edges) plus a margin on every side.
Every domain cell gets:
    population     WorldPop 2023 people in the full 2 km square
    candidate_id   the Phase 1 grid `id` if the cell is a candidate, else -1
    land_frac      fraction of the cell covered by the city's land polygons
    land           land_frac >= 0.5, or any population (covers Johor/Batam,
                   which have no land polygon here); used to keep synthetic
                   point sources out of the sea

Population is aggregated by assigning each ~100 m WorldPop pixel to the
2 km cell containing its centre, so every person is counted exactly once
(no double counting across cell edges) and totals are conserved.

Outputs (data/processed/phase3/<city>/):
    <city>_domain.nc        2D fields on the model raster
    <city>_candidates.csv   one row per candidate cell (Phase 4/5 input)

Usage:
    python 01_build_domain.py --all
"""

import argparse

import geopandas as gpd
import numpy as np
import pandas as pd
import rasterio
import xarray as xr
from pyproj import Transformer
from shapely.geometry import box

import config


def parse_cities(description):
    parser = argparse.ArgumentParser(description=description)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--city", choices=config.ALL_CITIES)
    group.add_argument("--all", action="store_true")
    args = parser.parse_args()
    return config.ALL_CITIES if args.all else [args.city]


def load_candidates(city, cfg):
    grid = gpd.read_file(config.GRID_DIR / cfg["grid_file"])
    assert grid.crs.to_string() == cfg["crs"], f"{city} grid CRS is {grid.crs}"
    assert grid["id"].is_unique

    widths = (grid["right"] - grid["left"]).round(6).unique()
    heights = (grid["top"] - grid["bottom"]).round(6).unique()
    assert list(widths) == [config.CELL_SIZE_M] and list(heights) == [config.CELL_SIZE_M], (
        f"{city} cells are {widths} x {heights} m, expected {config.CELL_SIZE_M}"
    )
    return grid


def build_domain(city):
    cfg = config.city_config(city)
    grid = load_candidates(city, cfg)
    dx = config.CELL_SIZE_M
    m = config.DOMAIN_MARGIN_CELLS

    # Domain edges: candidate-grid bounding box + margin, on the grid's own
    # cell edges so every candidate cell is exactly one domain cell.
    x0 = grid["left"].min() - m * dx
    y_top = grid["top"].max() + m * dx
    nx = int(round((grid["right"].max() - grid["left"].min()) / dx)) + 2 * m
    ny = int(round((grid["top"].max() - grid["bottom"].min()) / dx)) + 2 * m

    x = x0 + dx * (np.arange(nx) + 0.5)          # cell centres, west -> east
    y = y_top - dx * (np.arange(ny) + 0.5)       # cell centres, north -> south

    candidate_id = np.full((ny, nx), -1, dtype=np.int64)
    pct_land = np.zeros((ny, nx))
    col = np.rint((grid["left"] - x0) / dx).astype(int)
    row = np.rint((y_top - grid["top"]) / dx).astype(int)
    candidate_id[row, col] = grid["id"].to_numpy()
    pct_land[row, col] = grid["pct_land"].to_numpy()

    population = aggregate_population(cfg, x0, y_top, nx, ny, dx)
    land_frac = land_fraction(cfg, x, y, dx)
    land = (land_frac >= 0.5) | (population > 0)

    ds = xr.Dataset(
        {
            "population": (("y", "x"), population, {"units": "people per cell",
                           "source": ", ".join(cfg["pop_files"])}),
            "candidate_id": (("y", "x"), candidate_id, {"missing": -1}),
            "pct_land": (("y", "x"), pct_land, {"units": "%",
                         "note": "candidate cells only; 0 elsewhere"}),
            "land_frac": (("y", "x"), land_frac, {"source": cfg["land_file"]}),
            "land": (("y", "x"), land.astype(np.int8),
                     {"rule": "land_frac >= 0.5 or population > 0"}),
        },
        coords={"x": x, "y": y},
        attrs={"city": city, "crs": cfg["crs"], "cell_size_m": dx,
               "margin_cells": m},
    )

    cand = grid[["id", "row_index", "col_index", "land_area_m2", "pct_land"]].copy()
    cand["domain_row"] = row
    cand["domain_col"] = col
    cand["x"] = x[col]
    cand["y"] = y[row]
    cand["population"] = population[row, col]

    out = config.processed_dir(city)
    ds.to_netcdf(out / f"{city}_domain.nc")
    cand.sort_values("id").to_csv(out / f"{city}_candidates.csv", index=False)

    print(f"{city}: domain {ny} x {nx} cells ({ny * dx / 1000:.0f} x {nx * dx / 1000:.0f} km), "
          f"{len(grid)} candidates")
    print(f"  population: domain {population.sum() / 1e6:.2f} M, "
          f"candidates {cand['population'].sum() / 1e6:.2f} M")
    print(f"  land: {land.sum()} of {land.size} cells; land polygons cover "
          f"{(land_frac * dx * dx).sum() / 1e6:.0f} km2")
    return ds


def land_fraction(cfg, x, y, dx):
    """Exact fraction of each domain cell covered by the land polygons."""
    land = gpd.read_file(config.RAW_DIR / cfg["land_file"]).to_crs(cfg["crs"])
    half = dx / 2
    domain_box = box(x.min() - half, y.min() - half, x.max() + half, y.max() + half)
    land = land[land.intersects(domain_box)]
    union = land.geometry.make_valid().union_all().intersection(domain_box)
    frac = np.zeros((len(y), len(x)))
    for i, yc in enumerate(y):
        for j, xc in enumerate(x):
            cell = box(xc - half, yc - half, xc + half, yc + half)
            if union.intersects(cell):
                frac[i, j] = union.intersection(cell).area / dx**2
    return frac


def aggregate_population(cfg, x0, y_top, nx, ny, dx):
    """Sum WorldPop pixels (from every country raster) into domain cells."""
    pop = np.zeros((ny, nx))
    for name in cfg["pop_files"]:
        part = aggregate_one_raster(config.POP_DIR / name, cfg, x0, y_top, nx, ny, dx)
        print(f"  {name}: {part.sum() / 1e6:.3f} M people in domain")
        pop += part
    return pop


def aggregate_one_raster(path, cfg, x0, y_top, nx, ny, dx):
    """Sum one raster's pixels into domain cells by pixel-centre location."""
    to_raster = Transformer.from_crs(cfg["crs"], "EPSG:4326", always_xy=True)
    to_city = Transformer.from_crs("EPSG:4326", cfg["crs"], always_xy=True)

    # Read only the raster window covering the domain (the AUS file is the
    # whole country), padded by a pixel so edge cells are complete.
    xs = [x0, x0 + nx * dx]
    ys = [y_top - ny * dx, y_top]
    lon, lat = to_raster.transform(*np.meshgrid(xs, ys))

    pop = np.zeros((ny, nx))
    with rasterio.open(path) as src:
        assert src.crs.to_epsg() == 4326
        window = rasterio.windows.from_bounds(
            lon.min(), lat.min(), lon.max(), lat.max(), transform=src.transform
        ).round_offsets().round_lengths()
        a = src.read(1, window=window, boundless=True, fill_value=src.nodata)
        t = src.window_transform(window)
        valid = (a != src.nodata) & np.isfinite(a) & (a > 0)
        r, c = np.nonzero(valid)
        plon, plat = rasterio.transform.xy(t, r, c, offset="center")
        px, py = to_city.transform(np.asarray(plon), np.asarray(plat))

    col = np.floor((px - x0) / dx).astype(int)
    row = np.floor((y_top - py) / dx).astype(int)
    inside = (col >= 0) & (col < nx) & (row >= 0) & (row < ny)
    np.add.at(pop, (row[inside], col[inside]), a[valid][inside])
    return pop


if __name__ == "__main__":
    for city in parse_cities("Build Phase 3 model domain and population field."):
        build_domain(city)

# 03_calibrate.py
"""
Calibrate the transport model against real hourly PM2.5.

Per the agreed design this is NOT a spatial emissions inversion: there are
far more cells than stations. Emissions are population x one scalar:

    E(cell) = alpha * population(cell) / cell_area      alpha: ug s-1 person-1

and the free parameters are
    alpha    emission per person                     (global)
    lam      first-order loss rate                   (global, grid search)
    b_d      background concentration on day d       (one per day)

Horizontal diffusivity K is FIXED at config.TRANSPORT_K_M2_S (CMAQ-based;
see config.py): a free fit drove K to the top of any range offered,
because the station networks can't identify it. Pass --k-grid to
re-run that diagnostic search over K as well.

b_d absorbs the regional / transboundary PM2.5 that local emissions can't
explain (and that population can't predict). It is spatially uniform, so
it carries no information about WHERE to place sensors: the spatial
pattern comes entirely from alpha * transport.

Because the model is linear in (alpha, b_d), each lam is fitted by
non-negative least squares on train-split days. lam is the grid value
with the lowest train RMSE. The 2025 holdout days are then scored with
alpha, K and lam frozen. b_d is re-fitted per test day, because it is
unknown in advance and is not the thing being validated. Skill is reported
against a background-only model (alpha = 0, b_d per day), so the test is
whether population-driven transport explains real variation beyond a flat
background. The background-only model predicts a single constant per day
(b_d), so it has no within-day correlation to report.

Each simulated day is the 24 local hours of the Phase 2 date, preceded by
a 24 h spin-up driven by the real previous-day weather, starting from the
background.

Outputs:
    data/processed/phase3/<city>/<city>_calibration.json   frozen parameters + scores
    outputs/phase3/<city>/calibration/grid_search.csv
    outputs/phase3/<city>/calibration/daily_background.csv
    outputs/phase3/<city>/calibration/obs_vs_model.png

Usage:
    python 03_calibrate.py --all
"""

import argparse
import json

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import xarray as xr
from scipy.optimize import nnls

import config
import transport

K_DIAGNOSTIC_GRID = [100.0, 300.0, 1000.0, 3000.0, 10000.0, 30000.0]   # m2 s-1, --k-grid only
LAM_GRID_HOURS = [np.inf, 24.0, 12.0, 6.0, 3.0, 1.5]            # e-folding time, h
SPINUP_HOURS = 24
SECONDS_PER_YEAR = 365.25 * 86400


def parse_args(description):
    parser = argparse.ArgumentParser(description=description)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--city", choices=config.ALL_CITIES)
    group.add_argument("--all", action="store_true")
    parser.add_argument("--k-grid", action="store_true",
                        help="diagnostic: also search K over K_DIAGNOSTIC_GRID")
    args = parser.parse_args()
    cities = config.ALL_CITIES if args.all else [args.city]
    k_grid = K_DIAGNOSTIC_GRID if args.k_grid else [config.TRANSPORT_K_M2_S]
    return cities, k_grid


def lam_per_second(hours):
    return 0.0 if np.isinf(hours) else 1.0 / (hours * 3600.0)


def station_cells(city, domain):
    st = pd.read_csv(config.processed_dir(city) / f"{city}_pm25_stations.csv")
    st = st[st["in_domain"]].reset_index(drop=True)
    dx = domain.attrs["cell_size_m"]
    x0 = float(domain.x[0]) - dx / 2
    y_top = float(domain.y[0]) + dx / 2
    st["col"] = np.floor((st["x"] - x0) / dx).astype(int)
    st["row"] = np.floor((y_top - st["y"]) / dx).astype(int)
    return st


def simulate_days(city, domain, days, stations, offset_h, k_grid):
    """Station hour-means for every (day, K, tracer). Shape (D, nK, 24, ntr, nst)."""
    dx = domain.attrs["cell_size_m"]
    pop = domain["population"].values
    ny, nx = pop.shape
    lams = np.array([lam_per_second(h) for h in LAM_GRID_HOURS])
    nl = len(lams)

    # Tracers: [unit emission for each lam] + [unit background for each lam]
    emis = np.zeros((2 * nl, ny, nx))
    emis[:nl] = pop / dx**2                      # alpha = 1 ug s-1 person-1
    bg = np.r_[np.zeros(nl), np.ones(nl)]
    c0 = bg[:, None, None] * np.ones((1, ny, nx))
    lam_tr = np.r_[lams, lams]
    cells = (stations["row"].to_numpy(), stations["col"].to_numpy())

    out = np.empty((len(days), len(k_grid), 24, 2 * nl, len(stations)))
    for d, date in enumerate(days):
        local_start = pd.Timestamp(date)
        utc_start = local_start - pd.Timedelta(hours=offset_h) - pd.Timedelta(hours=SPINUP_HOURS)
        utc_end = utc_start + pd.Timedelta(hours=SPINUP_HOURS + 24)
        met = transport.load_met(city, config.PHASE2_DIR, utc_start, utc_end)
        fields = transport.met_to_domain(met, domain)
        for k, K in enumerate(k_grid):
            r = transport.run(fields, dx, emis, lam_tr, K, bg, c0, sample_cells=cells)
            out[d, k] = r["samples"][SPINUP_HOURS:]
        print(f"  simulated {d + 1}/{len(days)} {local_start.date()}", end="\r")
    print()
    return out, nl


def observations(city, days, stations):
    """Observed hour-start PM2.5, shape (D, 24, nst), NaN where missing."""
    obs = pd.read_csv(config.processed_dir(city) / f"{city}_pm25_hourly.csv",
                      parse_dates=["time_local"])
    obs = obs[obs["station"].isin(stations["station"])]
    piv = obs.pivot_table(index="time_local", columns="station", values="pm25")
    piv = piv.reindex(columns=stations["station"])
    y = np.full((len(days), 24, len(stations)), np.nan)
    for d, date in enumerate(days):
        hours = pd.date_range(pd.Timestamp(date), periods=24, freq="h")
        y[d] = piv.reindex(hours).to_numpy()
    return y


def fit(sim_e, sim_b, y, alpha=None):
    """NNLS for alpha (unless given) and one background per day.

    sim_e, sim_b: (D, 24, nst) unit-emission / unit-background responses.
    Returns alpha, b (D,), prediction (D, 24, nst).
    """
    D = y.shape[0]
    ok = np.isfinite(y)
    rows_day = np.broadcast_to(np.arange(D)[:, None, None], y.shape)[ok]
    B = np.zeros((ok.sum(), D))
    B[np.arange(ok.sum()), rows_day] = sim_b[ok]
    target = y[ok]
    if alpha is None:
        A = np.column_stack([sim_e[ok], B])
        coef, _ = nnls(A, target)
        alpha, b = coef[0], coef[1:]
    else:
        b, _ = nnls(B, target - alpha * sim_e[ok])
    pred = alpha * sim_e + b[:, None, None] * sim_b
    return alpha, b, pred


def background_only(y):
    """Best single constant per day (least squares = the day's observed mean)."""
    return np.broadcast_to(np.nanmean(y, axis=(1, 2), keepdims=True), y.shape)


def scores(y, pred, within_day=True):
    ok = np.isfinite(y)
    err = pred[ok] - y[ok]
    out = {"rmse": float(np.sqrt(np.mean(err**2))), "bias": float(err.mean()),
           "n_obs": int(ok.sum())}
    if within_day:
        # Within-day anomalies: remove each day's mean, so the score
        # reflects hour-to-hour and station-to-station structure only.
        y_anom = y - np.nanmean(y, axis=(1, 2), keepdims=True)
        p_anom = pred - np.nanmean(np.where(ok, pred, np.nan), axis=(1, 2), keepdims=True)
        out["r_within_day"] = float(np.corrcoef(y_anom[ok], p_anom[ok])[0, 1])
    return out


def calibrate(city, k_grid):
    print(f"=== {city}")
    cfg = config.city_config(city)
    domain = xr.open_dataset(config.processed_dir(city) / f"{city}_domain.nc")
    stations = station_cells(city, domain)
    days_df = pd.read_csv(config.PHASE2_DIR / city / f"{city}_phase3_days.csv",
                          parse_dates=["date"])
    days = days_df["date"].tolist()
    is_train = (days_df["split"] == "train").to_numpy()

    sims, nl = simulate_days(city, domain, days, stations, cfg["utc_offset_hours"], k_grid)
    y = observations(city, days, stations)

    rows = []
    for k, K in enumerate(k_grid):
        for j, lam_h in enumerate(LAM_GRID_HOURS):
            se, sb = sims[:, k, :, j, :], sims[:, k, :, nl + j, :]
            a, _, pred = fit(se[is_train], sb[is_train], y[is_train])
            s = scores(y[is_train], pred)
            rows.append({"K_m2_s": K, "loss_efold_h": lam_h, "alpha": a, **s})
    grid = pd.DataFrame(rows)
    if len(k_grid) > 1:
        # Diagnostic run: record the (K, lam) grid only; don't overwrite
        # the calibration that downstream steps use.
        grid.to_csv(config.output_dir(city, "calibration") / "grid_search_K_diagnostic.csv",
                    index=False)
        print(grid.round(4).to_string(index=False))
        return
    best = grid.loc[grid["rmse"].idxmin()]
    k = k_grid.index(best["K_m2_s"])
    j = LAM_GRID_HOURS.index(best["loss_efold_h"])
    se, sb = sims[:, k, :, j, :], sims[:, k, :, nl + j, :]

    alpha, b_tr, pred_tr = fit(se[is_train], sb[is_train], y[is_train])
    _, b_te, pred_te = fit(se[~is_train], sb[~is_train], y[~is_train], alpha=alpha)
    null_tr = background_only(y[is_train])
    null_te = background_only(y[~is_train])
    # With lam = 0 the background tracer is exactly 1 everywhere, so the
    # full model contains background-only as the case alpha = 0. Its train
    # RMSE therefore can't be worse; if it is, the solver is broken.
    assert scores(y[is_train], pred_tr)["rmse"] <= scores(y[is_train], null_tr, False)["rmse"] + 1e-6, \
        "full model fits worse than background-only on train days"

    result = {
        "city": city,
        "K_m2_s": float(best["K_m2_s"]),
        "K_fixed": len(k_grid) == 1,
        "loss_efold_hours": None if np.isinf(best["loss_efold_h"]) else float(best["loss_efold_h"]),
        "alpha_ug_per_s_per_person": float(alpha),
        "alpha_kg_per_person_per_year": float(alpha * SECONDS_PER_YEAR / 1e9),
        "h_min_m": transport.H_MIN_M,
        "spinup_hours": SPINUP_HOURS,
        "stations": stations["station"].tolist(),
        "n_train_days": int(is_train.sum()),
        "n_test_days": int((~is_train).sum()),
        "train": scores(y[is_train], pred_tr),
        "train_background_only": scores(y[is_train], null_tr, within_day=False),
        "test": scores(y[~is_train], pred_te),
        "test_background_only": scores(y[~is_train], null_te, within_day=False),
        "background_mean_ug_m3": {"train": float(b_tr.mean()), "test": float(b_te.mean())},
    }
    with open(config.processed_dir(city) / f"{city}_calibration.json", "w") as f:
        json.dump(result, f, indent=2)

    out = config.output_dir(city, "calibration")
    grid.to_csv(out / "grid_search.csv", index=False)
    bdf = days_df[["date", "regime", "split"]].copy()
    b_all = np.empty(len(days))
    b_all[is_train], b_all[~is_train] = b_tr, b_te
    bdf["background_ug_m3"] = b_all
    bdf.to_csv(out / "daily_background.csv", index=False)
    plot(city, y, is_train, pred_tr, pred_te, null_te, stations, out)

    print(grid.round(4).to_string(index=False))
    print(json.dumps({k: v for k, v in result.items() if k != "stations"}, indent=2))


def plot(city, y, is_train, pred_tr, pred_te, null_te, stations, out):
    fig, axes = plt.subplots(1, 3, figsize=(15, 4.6))
    for ax, yy, pp, title in [
        (axes[0], y[is_train], pred_tr, "train (2021-24)"),
        (axes[1], y[~is_train], pred_te, "test (2025), full model"),
        (axes[2], y[~is_train], null_te, "test (2025), background only"),
    ]:
        ok = np.isfinite(yy)
        ax.scatter(yy[ok], pp[ok], s=3, alpha=0.3)
        hi = np.nanpercentile(yy, 99.5)
        ax.plot([0, hi], [0, hi], "k--", lw=1)
        ax.set_xlim(0, hi)
        ax.set_ylim(0, hi)
        s = scores(yy, pp, within_day="background" not in title)
        r_txt = f", within-day r {s['r_within_day']:.2f}" if "r_within_day" in s else ""
        ax.set_title(f"{title}\nRMSE {s['rmse']:.2f}{r_txt}")
        ax.set_xlabel("observed PM2.5 (ug/m3)")
        ax.set_ylabel("model PM2.5 (ug/m3)")
    fig.suptitle(f"{city}: hourly PM2.5 at {len(stations)} stations")
    fig.tight_layout()
    fig.savefig(out / "obs_vs_model.png", dpi=130)
    plt.close(fig)


if __name__ == "__main__":
    cities, k_grid = parse_args("Calibrate the transport model against real PM2.5.")
    for city in cities:
        calibrate(city, k_grid)

# 02_ingest_pm25.py
"""
Clean the real hourly PM2.5 observations used to calibrate the transport
model, into one long-format table per city.

Times are converted to FIXED local standard time (UTC+8 Singapore, UTC+10
Melbourne), matching Phase 2's USE_DST=False, and labelled by the START of
the averaging hour:

  Singapore (NEA, data.gov.sg "Historical 1-hr PM2.5"): wide table, one
    column per region, timestamps D/M/YYYY H:MM in SGT. NEA's 1-hr reading
    at time T is the average over the preceding hour, so the hour start is
    T - 1 h.
  Melbourne (EPA Victoria "All Sites" workbooks, one per year): one sheet
    per station. `datetime_AEST` is already fixed UTC+10 and is the hour
    START (the 2025 workbook's `date_hour_start_utc_id` column confirms the
    convention). Three quirks are handled explicitly (see CLAUDE.md):
      1. station IDs change between years -> match by station NAME;
      2. PM2.5 column is BPM2.5 (raw BAM) then SBPM25 (STP-corrected, same
         instrument) -> spliced into one series;
      3. a station split across two ID sheets in one year (Footscray 2021)
         -> one series.
    Station coordinates come from each workbook's Metadata sheet; a
    station that moved slightly between years keeps its per-year location.

Values outside [PM25_MIN, PM25_MAX] are dropped and counted.

Outputs (data/processed/phase3/<city>/):
    <city>_pm25_hourly.csv   time_local, station, lat, lon, pm25
    <city>_pm25_stations.csv one row per station: coords, coverage, in-domain flag

Usage:
    python 02_ingest_pm25.py --all
"""

import argparse
import re

import numpy as np
import openpyxl
import pandas as pd
import xarray as xr
from pyproj import Transformer

import config


def parse_cities(description):
    parser = argparse.ArgumentParser(description=description)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--city", choices=config.ALL_CITIES)
    group.add_argument("--all", action="store_true")
    args = parser.parse_args()
    return config.ALL_CITIES if args.all else [args.city]


# ---------------------------------------------------------
# SINGAPORE
# ---------------------------------------------------------

def load_singapore():
    raw = pd.read_csv(config.PM25_RAW_DIR / config.SINGAPORE_PM25_FILE)
    t_end = pd.to_datetime(raw["1hr_pm25"], format="%d/%m/%Y %H:%M", errors="coerce")
    bad = t_end.isna()
    # One known malformed row ("2016-04-04 010:00:00"), outside 2021-2025.
    print(f"  skipped {bad.sum()} unparseable timestamp(s): {raw.loc[bad, '1hr_pm25'].tolist()}")
    raw, t_end = raw[~bad], t_end[~bad]
    # The full record has 3 duplicated timestamps (2016-2018, with differing
    # values); only the study period has to be clean.
    t_start = t_end - pd.Timedelta(hours=1)
    in_period = t_start.dt.year.between(config.phase2.START_YEAR, config.phase2.END_YEAR)
    raw, t_end = raw[in_period], t_end[in_period]
    assert not t_end.duplicated().any(), "duplicate Singapore timestamps in study period"
    wide = raw.drop(columns="1hr_pm25")
    wide.index = t_end - pd.Timedelta(hours=1)

    long = (wide.rename_axis("time_local").reset_index()
                .melt(id_vars="time_local", var_name="station", value_name="pm25"))
    long["pm25"] = pd.to_numeric(long["pm25"], errors="coerce")
    long["lat"] = long["station"].map(lambda s: config.SINGAPORE_REGIONS[s][0])
    long["lon"] = long["station"].map(lambda s: config.SINGAPORE_REGIONS[s][1])
    return long


# ---------------------------------------------------------
# MELBOURNE
# ---------------------------------------------------------

def read_locations(wb):
    rows = list(wb["Metadata"].iter_rows(values_only=True))
    start = next(i for i, r in enumerate(rows) if r and r[0] == "location_id")
    locs = {}
    for r in rows[start + 1:]:
        if not r or r[0] is None:
            break
        locs[int(r[0])] = (r[1], float(r[2]), float(r[3]))
    return locs


def read_station_sheet(ws):
    it = ws.iter_rows(values_only=True)
    header = list(next(it))
    pm_cols = [c for c in config.MELBOURNE_PM25_COLUMNS if c in header]
    if not pm_cols:
        return None
    i_time = header.index("datetime_AEST")
    i_id = header.index("location_id")
    idx = [header.index(c) for c in pm_cols]
    records = []
    for r in it:
        if r[i_time] is None:
            continue
        # BPM2.5 and SBPM25 never overlap in time; take whichever is present.
        v = next((r[i] for i in idx if r[i] is not None), None)
        records.append((r[i_time], r[i_id], v))
    df = pd.DataFrame(records, columns=["time_local", "location_id", "pm25"])
    df["column"] = "+".join(pm_cols)
    return df


def load_melbourne():
    frames = []
    for path in sorted(config.PM25_RAW_DIR.glob(config.MELBOURNE_PM25_GLOB)):
        year = int(re.match(r"(\d{4})_", path.name).group(1))
        wb = openpyxl.load_workbook(path, read_only=True)
        locs = read_locations(wb)
        for sheet in wb.sheetnames:
            if sheet in ("Data Info Panel", "Metadata", "AllData"):
                continue
            df = read_station_sheet(wb[sheet])
            if df is None:
                continue
            ids = df["location_id"].dropna().astype(int).unique()
            assert len(ids) == 1, f"{path.name}/{sheet}: several location_ids {ids}"
            name, lat, lon = locs[ids[0]]
            df["station"], df["lat"], df["lon"], df["year_file"] = name, lat, lon, year
            print(f"  {year} {sheet:28s} {df['column'].iloc[0]:14s} {df['pm25'].notna().sum():6d} values")
            frames.append(df)
        wb.close()

    long = pd.concat(frames, ignore_index=True)
    long["time_local"] = pd.to_datetime(long["time_local"])
    long["pm25"] = pd.to_numeric(long["pm25"], errors="coerce")

    long = long.dropna(subset=["pm25"])

    # Consecutive yearly workbooks both contain the 31 Dec 23:00 AEST hour
    # (it is 1 Jan 00:00 in daylight-saving local time). The copies are
    # identical, so drop exact repeats.
    exact = long.duplicated(["station", "time_local", "pm25"])
    print(f"  dropped {exact.sum()} identical year-boundary repeats")
    long = long[~exact]

    # Quirk 3: a station split across two ID sheets in one year must not
    # produce conflicting hours. Fail loudly if any remain.
    dup = long.duplicated(["station", "time_local"], keep=False)
    assert not dup.any(), f"conflicting station-hours:\n{long[dup].head()}"
    return long.drop(columns=["location_id", "column", "year_file"])


# ---------------------------------------------------------
# COMMON
# ---------------------------------------------------------

def clean_and_save(city, long):
    n_raw = long["pm25"].notna().sum()
    bad = long["pm25"].notna() & ~long["pm25"].between(config.PM25_MIN, config.PM25_MAX)
    print(f"  dropped {bad.sum()} of {n_raw} values outside "
          f"[{config.PM25_MIN}, {config.PM25_MAX}] ug/m3 "
          f"(min {long.loc[bad, 'pm25'].min() if bad.any() else 'n/a'})")
    long = long[long["pm25"].notna() & ~bad]

    start = pd.Timestamp(f"{config.phase2.START_YEAR}-01-01")
    end = pd.Timestamp(f"{config.phase2.END_YEAR + 1}-01-01")
    long = long[(long["time_local"] >= start) & (long["time_local"] < end)]
    long = long.sort_values(["station", "time_local"])

    # Which stations sit inside the model domain?
    cfg = config.city_config(city)
    dom = xr.open_dataset(config.processed_dir(city) / f"{city}_domain.nc")
    half = dom.attrs["cell_size_m"] / 2
    to_city = Transformer.from_crs("EPSG:4326", cfg["crs"], always_xy=True)

    st = (long.groupby("station")
              .agg(lat=("lat", "median"), lon=("lon", "median"),
                   n_hours=("pm25", "size"),
                   first=("time_local", "min"), last=("time_local", "max"),
                   mean_pm25=("pm25", "mean"))
              .reset_index())
    st["x"], st["y"] = to_city.transform(st["lon"].to_numpy(), st["lat"].to_numpy())
    xmin, xmax = float(dom.x.min()) - half, float(dom.x.max()) + half
    ymin, ymax = float(dom.y.min()) - half, float(dom.y.max()) + half
    st["in_domain"] = st["x"].between(xmin, xmax) & st["y"].between(ymin, ymax)
    n_possible = (end - start) / pd.Timedelta(hours=1)
    st["coverage_pct"] = (100 * st["n_hours"] / n_possible).round(1)

    out = config.processed_dir(city)
    long[["time_local", "station", "lat", "lon", "pm25"]].to_csv(
        out / f"{city}_pm25_hourly.csv", index=False)
    st.to_csv(out / f"{city}_pm25_stations.csv", index=False)

    print(st[["station", "in_domain", "coverage_pct", "mean_pm25", "first", "last"]]
          .round({"mean_pm25": 1}).to_string(index=False))


if __name__ == "__main__":
    for city in parse_cities("Clean real hourly PM2.5 observations."):
        print(f"=== {city}")
        long = load_singapore() if city == "singapore" else load_melbourne()
        clean_and_save(city, long)

# 01_k_sensitivity.py
"""
Phase 8 (pre-stated in METHODS.md, 2026-10-25): sensitivity to the
spreading rate K. Reads the Phase 5 and Phase 7 results at K = 200, 1,000
(headline) and 8,000 m2/s and checks conclusions C1-C7 against the
pre-stated rules: a conclusion holds if, at both K = 200 and K = 8,000,
it meets its rule (same sign and significance as at the headline unless
the METHODS.md table says otherwise).

Output: data/processed/phase8/phase8_k_sensitivity.json
        data/processed/phase8/phase8_k_sensitivity_table.md

Usage:
    python 01_k_sensitivity.py
"""

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
P5 = ROOT / "data" / "processed" / "phase5"
P7 = ROOT / "data" / "processed" / "phase7"
OUT = ROOT / "data" / "processed" / "phase8"
K_VALUES = {200: "_K200", 1000: "", 8000: "_K8000"}
HEADLINE_N = {"singapore": 22, "melbourne": 8}
FIXED = ["L0", "L1", "L2_setA", "L2_setB", "L3_setA", "L3_setB", "L4_setA", "L4_setB"]
L0_L4 = ["L0", "L1", "L2_setA", "L2_setB", "L3_setA", "L3_setB", "L4_setA", "L4_setB"]
REALISTIC = ["L2_setA", "L2_setB", "L3_setA", "L3_setB", "L4_setA", "L4_setB"]
CRIT_PAIRS = ["equal_count_N22", "equal_count_N40", "equal_density_SG8_MEL32",
              "equal_density_SG22_MEL88", "equal_density_SG40_MEL160"]


def sig(ci):
    """+1 if the 95% CI is above zero, -1 if below, 0 if it includes zero."""
    return 1 if ci[0] > 0 else (-1 if ci[1] < 0 else 0)


def load(k):
    t = K_VALUES[k]
    return (json.load(open(P5 / f"phase5_results_all2025_trainall{t}.json")),
            json.load(open(P5 / f"phase5_emission_predictability{t}.json")),
            json.load(open(P7 / f"phase7_budget_sweep{t}.json")))


def estimates(k):
    ev, pred, sw = load(k)
    e = {}
    # C1: original design at real network size
    for c in HEADLINE_N:
        r = ev[c]
        e[f"C1_{c}"] = [r["improvement_greedy_vs_kmeans"], *r["ci95"]]
    # C2: L0-L4 at real network size, per city (9 level x set cells incl. L0 and L1 -> 8 cells)
    for c, n in HEADLINE_N.items():
        cells = {lv: pred[c][lv]["improvement"][str(n)] for lv in L0_L4}
        e[f"C2_{c}"] = cells
    # C3: Melbourne-benefits-more criterion at L2-L4
    d = pred["city_difference_mel_minus_sg"]
    e["C3"] = {lv: {p: d[lv][p] for p in CRIT_PAIRS} for lv in REALISTIC}
    # C4: Singapore minus Melbourne at own network size, L0-L4
    e["C4"] = {lv: [-d[lv]["own_network_size"][0], -d[lv]["own_network_size"][2],
                    -d[lv]["own_network_size"][1]] for lv in L0_L4}
    # C5: L5 at real network size
    for c, n in HEADLINE_N.items():
        e[f"C5_{c}"] = pred[c]["L5"]["improvement"][str(n)]
    # C6: N* density (original design, 1% rule, area-fair, greedy)
    cc = sw["city_comparison_area_fair"]["original"]["greedy"]
    e["C6"] = {"singapore": cc["density_singapore"], "melbourne": cc["density_melbourne"],
               "ci_singapore": cc["density_ci_singapore"], "ci_melbourne": cc["density_ci_melbourne"]}
    # C7: slope of improvement on ln N (original design, full sweep)
    for c in HEADLINE_N:
        s = sw[c]["original"]["slopes"]["full"]
        e[f"C7_{c}"] = [s["beta1"], *s["ci95"], s["per_doubling_pp"]]
    # descriptive: variogram range (km) of the original-design training maps and L0
    e["variogram_range_km"] = {c: {"original": sw[c]["original"]["variogram_range_km"],
                                   "L0": sw[c]["L0"]["variogram_range_km"]} for c in HEADLINE_N}
    e["test_rmse_original"] = {c: ev[c]["test_rmse"] for c in HEADLINE_N}
    return e


def verdicts(E):
    """Rule checks (METHODS.md "Phase 8 design"), per K value."""
    out = {}
    for k, e in E.items():
        v = {}
        v["C1"] = {c: sig(e[f"C1_{c}"][1:]) for c in HEADLINE_N}
        v["C2"] = {c: sum(sig(x[1:]) == 1 for x in e[f"C2_{c}"].values()) for c in HEADLINE_N}
        pos = sum(sig(x[1:]) == 1 for lv in e["C3"].values() for x in lv.values())
        neg = sum(sig(x[1:]) == -1 for lv in e["C3"].values() for x in lv.values())
        v["C3"] = {"sig_mel_greater": pos, "sig_sg_greater": neg, "n": 30, "criterion_met": pos == 30}
        v["C4"] = sum(sig(x[1:]) == 1 for x in e["C4"].values())
        v["C5"] = {c: abs(e[f"C5_{c}"][0]) <= 0.05 for c in HEADLINE_N}
        ds, dm = e["C6"]["singapore"], e["C6"]["melbourne"]
        v["C6"] = {"ratio": max(ds, dm) / min(ds, dm)}
        v["C7"] = {c: e[f"C7_{c}"][0] < 0 and e[f"C7_{c}"][2] < 0 for c in HEADLINE_N}
        out[k] = v
    h = out[1000]
    holds = {}
    alt = [out[200], out[8000]]
    holds["C1"] = all(a["C1"] == h["C1"] for a in alt)
    holds["C2"] = all(a["C2"][c] > len(L0_L4) / 2 for a in alt for c in HEADLINE_N)
    holds["C3"] = all(not a["C3"]["criterion_met"] for a in alt)
    holds["C4"] = all(a["C4"] > len(L0_L4) / 2 for a in alt)
    holds["C5"] = all(all(a["C5"].values()) for a in alt)
    holds["C6"] = all(a["C6"]["ratio"] <= 1.5 for a in alt)
    flag = {}
    for k in (200, 8000):
        for c in HEADLINE_N:
            rel = E[k]["C6"][c] / E[1000]["C6"][c] - 1
            flag[f"K{k}_{c}"] = rel
    holds["C6_moved_more_than_25pct"] = {key: abs(r) > 0.25 for key, r in flag.items()}
    holds["C6_relative_change"] = flag
    holds["C7"] = all(not any(a["C7"].values()) for a in alt)
    return out, holds


def pct(x):
    return f"{100 * x:+.1f}%"


def ci(x):
    return f"{pct(x[0])} ({100 * x[1]:+.1f}, {100 * x[2]:+.1f})"


def table(E, V, H):
    ks = [200, 1000, 8000]
    yn = lambda b: "**holds**" if b else "**does not hold**"
    rows = ["| # | Measure | K = 200 | K = 1,000 (headline) | K = 8,000 | Verdict |",
            "|---|---|---|---|---|---|"]
    rows.append(f"| C1 | Original design, Singapore N = 22 | " + " | ".join(ci(E[k]["C1_singapore"]) for k in ks)
                + f" | {yn(H['C1'])} |")
    rows.append(f"| C1 | Original design, Melbourne N = 8 | " + " | ".join(ci(E[k]["C1_melbourne"]) for k in ks) + " | |")
    rows.append("| C2 | L0–L4 cells with CI > 0, Singapore (of 8) | " + " | ".join(str(V[k]["C2"]["singapore"]) for k in ks)
                + f" | {yn(H['C2'])} |")
    rows.append("| C2 | L0–L4 cells with CI > 0, Melbourne (of 8) | " + " | ".join(str(V[k]["C2"]["melbourne"]) for k in ks) + " | |")
    rows.append("| C3 | L2–L4 city comparisons: Melbourne > Singapore / Singapore > Melbourne (significant, of 30) | "
                + " | ".join(f"{V[k]['C3']['sig_mel_greater']} / {V[k]['C3']['sig_sg_greater']}" for k in ks)
                + f" | {yn(H['C3'])} (criterion not met) |")
    rows.append("| C4 | L0–L4 cells where Singapore > Melbourne at real size, CI > 0 (of 8) | "
                + " | ".join(str(V[k]["C4"]) for k in ks) + f" | {yn(H['C4'])} |")
    for c, n in HEADLINE_N.items():
        rows.append(f"| C5 | L5 random hotspots, {c.title()} N = {n} | " + " | ".join(ci(E[k][f'C5_{c}']) for k in ks)
                    + (f" | {yn(H['C5'])} |" if c == "singapore" else " | |"))
    rows.append("| C6 | N* density per 100 km², Singapore / Melbourne (area-fair) | "
                + " | ".join(f"{E[k]['C6']['singapore']:.1f} / {E[k]['C6']['melbourne']:.1f}" for k in ks)
                + f" | {yn(H['C6'])} |")
    for c in HEADLINE_N:
        rows.append(f"| C7 | Slope of improvement per doubling of N, {c.title()} (pp) | "
                    + " | ".join(f"{E[k][f'C7_{c}'][3]:+.2f} ({100 * E[k][f'C7_{c}'][1] * 0.6931:+.2f}, {100 * E[k][f'C7_{c}'][2] * 0.6931:+.2f})" for k in ks)
                    + (f" | {yn(H['C7'])} |" if c == "singapore" else " | |"))
    rows.append("| – | Variogram range of training maps, Singapore / Melbourne (km) | "
                + " | ".join(f"{E[k]['variogram_range_km']['singapore']['original']:.0f} / {E[k]['variogram_range_km']['melbourne']['original']:.0f}" for k in ks)
                + " | descriptive |")
    return "\n".join(rows) + "\n"


if __name__ == "__main__":
    OUT.mkdir(parents=True, exist_ok=True)
    E = {k: estimates(k) for k in K_VALUES}
    V, H = verdicts(E)
    with open(OUT / "phase8_k_sensitivity.json", "w") as f:
        json.dump({"estimates": E, "checks": V, "holds": H}, f, indent=2, default=float)
    md = table(E, V, H)
    (OUT / "phase8_k_sensitivity_table.md").write_text(md)
    print(md)
    print(json.dumps(H, indent=2, default=float))
    for k in E:
        print(k, "C2 detail", {c: {lv: round(100 * x[0], 1) for lv, x in E[k][f"C2_{c}"].items()} for c in HEADLINE_N})
        print(k, "C4 detail", {lv: round(100 * x[0], 1) for lv, x in E[k]["C4"].items()})
        print(k, "RMSE", E[k]["test_rmse_original"])

# 02_network_geometry.py
"""
Phase 6 descriptive metrics (planned in the research plan; pre-stated in
METHODS.md, 2026-10-07). For the full-training networks at the Phase 6 budgets:

    nearest-neighbour distance   mean distance from each sensor to its
                                 nearest other sensor (km), and its
                                 coefficient of variation (SD / mean):
                                 low CV = evenly spaced, high = clustered
    distance to coast            mean distance from sensors to the
                                 coastline (km)

Networks: greedy (weather-informed, headline noise), k-means (evenly
spread) and, for Melbourne, the existing EPA stations. The coastline is
the boundary of the land polygons: Singapore planning areas (so the
Johor Strait counts as coast) and the union of Victorian council areas.

Descriptive only: no CIs.

Output: data/processed/phase6/phase6_network_geometry.csv

Usage:
    python 02_network_geometry.py
"""

import importlib.util
import sys
from pathlib import Path

import geopandas as gpd
import numpy as np
import pandas as pd
from shapely.geometry import Point

ROOT = Path(__file__).resolve().parents[3]
P4 = ROOT / "Workflow" / "Phase 4" / "Python files"
sys.path.insert(0, str(P4))
_spec = importlib.util.spec_from_file_location("cfg4", P4 / "config.py")
cfg = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(cfg)

N_VALUES = {"singapore": [8, 22, 40], "melbourne": [8, 22, 32, 40, 88]}
LAND = {"singapore": ("boundaries/singapore/MasterPlan2025PlanningAreaBoundaryNoSea.geojson", "EPSG:3414"),
        "melbourne": ("boundaries/melbourne/lga_polygon/lga_polygon.shp", "EPSG:7855")}


def coastline(city):
    path, crs = LAND[city]
    land = gpd.read_file(cfg.phase3.RAW_DIR / path).to_crs(crs)
    return land.geometry.make_valid().union_all().boundary


def nn_stats(xy):
    d = np.hypot(xy[:, None, 0] - xy[None, :, 0], xy[:, None, 1] - xy[None, :, 1])
    np.fill_diagonal(d, np.inf)
    nn = d.min(axis=1) / 1000
    return nn.mean(), nn.std() / nn.mean()


def run(city):
    cand = pd.read_csv(cfg.PHASE3_DIR / city / f"{city}_candidates.csv").sort_values("id").reset_index(drop=True)
    nets = pd.read_csv(cfg.processed_dir(city) / f"{city}_networks_trainall.csv")
    coast = coastline(city)
    coast_km = np.array([coast.distance(Point(x, y)) / 1000 for x, y in zip(cand["x"], cand["y"])])
    rows = [(city, "all candidate cells", len(cand), np.nan, np.nan, coast_km.mean())]
    label = f"f{cfg.HEADLINE_NOISE_FRACTION:g}"
    for strategy, noise in (("greedy", label), ("kmeans", "any"), ("existing", "any")):
        sub = nets[(nets["strategy"] == strategy) & (nets["noise"] == noise)]
        for n in sorted(set(sub["N"]) & set(N_VALUES[city] + ([8] if strategy == "existing" else []))):
            idx = sub[sub["N"] == n].sort_values("rank")["cell_index"].to_numpy()
            mean_nn, cv_nn = nn_stats(cand[["x", "y"]].to_numpy()[idx])
            rows.append((city, strategy, n, mean_nn, cv_nn, coast_km[idx].mean()))
    return pd.DataFrame(rows, columns=["city", "network", "N", "nn_mean_km", "nn_cv", "coast_mean_km"])


if __name__ == "__main__":
    df = pd.concat([run(c) for c in cfg.ALL_CITIES], ignore_index=True)
    out = ROOT / "data" / "processed" / "phase6"
    out.mkdir(parents=True, exist_ok=True)
    df.to_csv(out / "phase6_network_geometry.csv", index=False)
    print(df.round(2).to_string(index=False))

# 01_regime_networks.py
"""
Phase 6, Analysis 1 (pre-stated in METHODS.md, 2026-10-07): regime-specific
networks.

Tests the explanation left open by Phase 5: Singapore's steady monsoon
flow lets one fixed network serve every day, while Melbourne's changeable
weather does not.

For each city, emission setting and budget N:
  * a greedy network is chosen from each regime's 2021-2024 training maps
    only, plus the all-weather network from all training maps;
  * every network uses the same kriging covariance (fitted on all training
    maps of that setting) and the same noise (f = 0.25 x the city's overall
    training spatial SD), so only the training weather differs;
  * on each regime's 2025 test days, each network is scored:
      transfer penalty       RMSE(net j on regime k) / RMSE(net k on k) - 1, j != k
      fixed-network penalty  RMSE(all-weather net on k) / RMSE(net k on k) - 1
    averaged over regimes with weights w_k;
  * overlap between regime networks: Jaccard index of their cells, and the
    mean nearest-sensor distance between them / sqrt(area / N).
CIs: regime-stratified day bootstrap (2,000 draws), as in Phase 5.

Emission settings: "original" = the Phase 3 scenario design (the
full-training networks); "L0" = known emissions (base ingredient only),
secondary, because the original design's random hotspots mask weather
patterns.

Output: data/processed/phase6/phase6_regime_networks.json

Usage:
    python 01_regime_networks.py
"""

import importlib.util
import json
import sys
from itertools import combinations
from pathlib import Path

import dask
import numpy as np
import pandas as pd
import xarray as xr

dask.config.set(scheduler="synchronous")

ROOT = Path(__file__).resolve().parents[3]
P4 = ROOT / "Workflow" / "Phase 4" / "Python files"
sys.path.insert(0, str(P4))
import networks as N  # noqa: E402

_spec = importlib.util.spec_from_file_location("cfg4", P4 / "config.py")
cfg = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(cfg)

N_BOOT = 2000
N_VALUES = {"singapore": [8, 22, 40], "melbourne": [8, 22, 32, 40, 88]}
AREA_KM2 = {"singapore": 655.3, "melbourne": 2611.2}       # Phase 1 candidate land area
PAIRS = {"equal_count_N8": (8, 8), "equal_count_N22": (22, 22), "equal_count_N40": (40, 40),
         "equal_density_SG8_MEL32": (8, 32), "equal_density_SG22_MEL88": (22, 88)}


def maps_original(city):
    m = N.load_maps(city, test_set="all2025", train_set="all")
    return m["cells"], m["train"], m["test"]


def maps_L0(city, cells):
    out = []
    for period in ("train", "test2025"):
        ds = xr.open_dataset(cfg.PHASE3_DIR / city / f"{city}_ingredients_{period}.nc")
        meta = pd.DataFrame({"day": np.arange(ds.sizes["day"]), "member": 0,
                             "date": ds["date"].values, "regime": ds["regime"].values.astype(str),
                             "w_k": ds["w_k"].values})
        assert np.array_equal(ds["cell_id"].values, cells["cell_id"].values)
        out.append(N._pack(ds["response"].values[:, 0].astype(float), meta))
    return out


def regime_subset(split, regime):
    keep = (split["meta"]["regime"] == regime).to_numpy()
    m = split["meta"][keep].reset_index(drop=True)
    return split["X"][keep], np.full(len(m), 1.0 / len(m)), m


def nearest_distance_ratio(cells, A, B, n, area):
    xy = cells[["x", "y"]].to_numpy() / 1000
    a, b = xy[A], xy[B]
    d = np.hypot(a[:, None, 0] - b[None, :, 0], a[:, None, 1] - b[None, :, 1])
    mean_d = 0.5 * (d.min(axis=1).mean() + d.min(axis=0).mean())
    return mean_d / np.sqrt(area / n)


def boot_days(meta, rng):
    days = meta["day"].to_numpy()
    rows = {d: np.nonzero(days == d)[0] for d in np.unique(days)}
    u = np.array(list(rows))
    return [np.concatenate([rows[d] for d in rng.choice(u, len(u))]) for _ in range(N_BOOT)]


def analyse(city, setting, cells, train, test):
    regimes = sorted(train["meta"]["regime"].unique())
    w_k = train["meta"].groupby("regime")["w_k"].first().to_dict()
    Sigma_all = N.second_moment(train["X"], train["w"])
    vg = N.fit_variogram(cells, Sigma_all)
    K = N.covariance(cells, vg)
    sd = cfg.HEADLINE_NOISE_FRACTION * N.spatial_sd(train["X"], train["w"])
    n_max = max(N_VALUES[city])

    orders = {"all": N.greedy_rmse(K, Sigma_all, vg, sd**2, n_max)[0]}
    for r in regimes:
        Xr, wr, _ = regime_subset(train, r)
        orders[r] = N.greedy_rmse(K, N.second_moment(Xr, wr), vg, sd**2, n_max)[0]

    rng = np.random.default_rng([cfg.RANDOM_SEED, 6, len(city), len(setting)])
    test_by_r = {r: regime_subset(test, r) for r in regimes}
    boots = {r: boot_days(test_by_r[r][2], rng) for r in regimes}

    out = {"regimes": regimes, "w_k": w_k, "noise_sd": sd, "budgets": {}}
    draws = {}
    for n in N_VALUES[city]:
        nets = {k: v[:n] for k, v in orders.items()}
        W = {k: N.ok_weights(K, S, N.sensor_variance(vg, sd**2)) for k, S in nets.items()}
        # per-map MSE of every network on every regime's test maps
        mse = {(j, k): N.map_mse(test_by_r[k][0], nets[j], W[j], sd**2)
               for j in nets for k in regimes}

        def penalties(idx):
            tr, fx = 0.0, 0.0
            per = {}
            for k in regimes:
                i = idx[k]
                own = np.sqrt(mse[(k, k)][i].mean())
                others = [np.sqrt(mse[(j, k)][i].mean()) / own - 1 for j in regimes if j != k]
                fixed = np.sqrt(mse[("all", k)][i].mean()) / own - 1
                per[k] = (float(np.mean(others)), float(fixed))
                tr += w_k[k] * np.mean(others)
                fx += w_k[k] * fixed
            tot = sum(w_k.values())
            return tr / tot, fx / tot, per

        full = {k: slice(None) for k in regimes}
        tr0, fx0, per0 = penalties(full)
        bs = np.array([penalties({k: boots[k][b] for k in regimes})[:2] for b in range(N_BOOT)])
        area = AREA_KM2[city]
        overlap = {f"{a}-{b}": {"jaccard": len(set(nets[a]) & set(nets[b])) / len(set(nets[a]) | set(nets[b])),
                                "nearest_distance_ratio": float(nearest_distance_ratio(cells, nets[a], nets[b], n, area))}
                   for a, b in combinations(regimes, 2)}
        out["budgets"][str(n)] = {
            "transfer_penalty": [float(tr0), *np.percentile(bs[:, 0], [2.5, 97.5]).tolist()],
            "fixed_network_penalty": [float(fx0), *np.percentile(bs[:, 1], [2.5, 97.5]).tolist()],
            "per_regime_transfer_fixed": per0,
            "overlap": overlap,
            "mean_jaccard": float(np.mean([v["jaccard"] for v in overlap.values()])),
            "mean_nearest_distance_ratio": float(np.mean([v["nearest_distance_ratio"] for v in overlap.values()])),
            "networks": {k: [int(cells["cell_id"][i]) for i in v] for k, v in nets.items()},
        }
        draws[n] = bs
        b = out["budgets"][str(n)]
        print(f"  {city} {setting} N={n:3d}: transfer {100 * b['transfer_penalty'][0]:+.1f}% "
              f"({100 * b['transfer_penalty'][1]:+.1f}, {100 * b['transfer_penalty'][2]:+.1f}); "
              f"fixed {100 * b['fixed_network_penalty'][0]:+.1f}% "
              f"({100 * b['fixed_network_penalty'][1]:+.1f}, {100 * b['fixed_network_penalty'][2]:+.1f}); "
              f"Jaccard {b['mean_jaccard']:.2f}, distance ratio {b['mean_nearest_distance_ratio']:.2f}")
    return out, draws


def compare(sg, mel, dsg, dmel):
    out = {}
    for name, (ns, nm) in PAIRS.items():
        row = {}
        for m, col in (("transfer_penalty", 0), ("fixed_network_penalty", 1)):
            diff = dmel[nm][:, col] - dsg[ns][:, col]
            pt = mel["budgets"][str(nm)][m][0] - sg["budgets"][str(ns)][m][0]
            row[m] = [float(pt), *np.percentile(diff, [2.5, 97.5]).tolist()]
        row["jaccard_mel_minus_sg"] = mel["budgets"][str(nm)]["mean_jaccard"] - sg["budgets"][str(ns)]["mean_jaccard"]
        row["distance_ratio_mel_minus_sg"] = (mel["budgets"][str(nm)]["mean_nearest_distance_ratio"]
                                              - sg["budgets"][str(ns)]["mean_nearest_distance_ratio"])
        out[name] = row
    return out


if __name__ == "__main__":
    results, draws = {}, {}
    for setting in ("original", "L0"):
        results[setting], draws[setting] = {}, {}
        for city in cfg.ALL_CITIES:
            cells, train, test = maps_original(city)
            if setting == "L0":
                train, test = maps_L0(city, cells)
            results[setting][city], draws[setting][city] = analyse(city, setting, cells, train, test)
        results[setting]["city_difference_mel_minus_sg"] = compare(
            results[setting]["singapore"], results[setting]["melbourne"],
            draws[setting]["singapore"], draws[setting]["melbourne"])
    out = ROOT / "data" / "processed" / "phase6"
    out.mkdir(parents=True, exist_ok=True)
    with open(out / "phase6_regime_networks.json", "w") as f:
        json.dump(results, f, indent=2)
    print(f"wrote {out / 'phase6_regime_networks.json'}")

"""Build the Melbourne Urban Growth Boundary (UGB) polygon for the Phase 1 candidate grid.

Vicmap's UGB line layer (PLAN_UGB) can't be polygonized: the lines have
multi-km gaps (along the coast and in several inland stretches), so the
only closed loops are small enclaves. Instead we use the polygon layer
PLAN_UGA and subtract its "outside the UGB" polygons from the metro
council (LGA) area:

    inside UGB = dissolve(metro LGAs) - dissolve(PLAN_UGA where zone_code == "UGBA")

PLAN_UGA also holds zone_code "GAIC" polygons (Growth Areas Infrastructure
Contribution) -- these are growth suburbs *inside* the UGB (e.g. Aintree)
and must NOT be subtracted.

The raw difference leaves ~3,200 slivers where LGA and UGA edges are not
exactly aligned (median width ~0 m, 95th percentile ~3 m). These are
removed by a small morphological opening, then dropping parts and holes
under 0.1 km^2 -- far below what can affect a 2 km (4 km^2) grid cell.

Parts whose edges mostly don't follow either the UGB line or the metro
outer edge (coast / non-metro councils) are kept, but also written to a
`review_pieces` layer for a visual check in QGIS.

Inputs (statewide, EPSG:7855, from the Vicmap open-data WFS at
opendata.maps.vic.gov.au, layers open-data-platform:{plan_ugb,plan_uga,lga_polygon}):
    data/raw/boundaries/melbourne/{plan_ugb,plan_uga,lga_polygon}/
Output:
    data/raw/boundaries/melbourne/UGB_polygon.gpkg
        layer ugb_polygon    -- one feature, the cleaned inside-UGB area
        layer review_pieces  -- parts to eyeball against a basemap
"""
from pathlib import Path

import geopandas as gpd
from shapely.geometry import MultiPolygon, Polygon
from shapely.ops import unary_union

ROOT = Path(__file__).resolve().parents[3]
BOUNDARIES = ROOT / "data" / "raw" / "boundaries" / "melbourne"
OUT = BOUNDARIES / "UGB_polygon.gpkg"
CRS = "EPSG:7855"

# 31 metropolitan Melbourne councils + Mitchell (the UGB extends into it
# at Beveridge/Wallan).
METRO_LGAS = [
    "BANYULE", "BAYSIDE", "BOROONDARA", "BRIMBANK", "CARDINIA", "CASEY",
    "DAREBIN", "FRANKSTON", "GLEN EIRA", "GREATER DANDENONG", "HOBSONS BAY",
    "HUME", "KINGSTON", "KNOX", "MANNINGHAM", "MARIBYRNONG", "MAROONDAH",
    "MELBOURNE", "MELTON", "MERRI-BEK", "MITCHELL", "MONASH", "MOONEE VALLEY",
    "MORNINGTON PENINSULA", "NILLUMBIK", "PORT PHILLIP", "STONNINGTON",
    "WHITEHORSE", "WHITTLESEA", "WYNDHAM", "YARRA", "YARRA RANGES",
]

OPENING_M = 10          # removes slivers/spikes narrower than 2 * OPENING_M
MIN_AREA_M2 = 100_000   # 0.1 km^2: drop smaller parts, fill smaller holes
EDGE_TOL_M = 5          # how close a boundary must be to count as "on" a line
REVIEW_THRESHOLD = 0.5  # flag parts with < 50% of their edge on UGB line or metro edge


def load(name):
    gdf = gpd.read_file(BOUNDARIES / name / f"{name}.shp")
    assert gdf.crs.to_epsg() == 7855, f"{name} is {gdf.crs}, expected EPSG:7855"
    gdf["geometry"] = gdf.geometry.make_valid()
    return gdf


def parts_of(geom):
    return list(geom.geoms) if hasattr(geom, "geoms") else [geom]


def fill_small_holes(poly):
    holes = [h for h in poly.interiors if Polygon(h).area >= MIN_AREA_M2]
    return Polygon(poly.exterior, holes)


def main():
    lga = load("lga_polygon")
    uga = load("plan_uga")
    print("PLAN_UGA zone codes:", uga["zone_code"].value_counts().to_dict())
    outside = uga[uga["zone_code"] == "UGBA"]
    ugb_lines = load("plan_ugb")

    missing = set(METRO_LGAS) - set(lga["lga_name"])
    assert not missing, f"LGA names not found: {missing}"
    metro_lga = lga[lga["lga_name"].isin(METRO_LGAS)]
    metro = unary_union(metro_lga.geometry)

    raw = metro.difference(unary_union(outside.geometry))
    print(f"raw difference: {raw.area / 1e6:.0f} km2 in {len(parts_of(raw))} parts")

    opened = (raw.buffer(-OPENING_M, join_style="mitre")
                 .buffer(OPENING_M, join_style="mitre"))
    kept = [fill_small_holes(p) for p in parts_of(opened)
            if p.geom_type == "Polygon" and p.area >= MIN_AREA_M2]
    clean = MultiPolygon(sorted(kept, key=lambda p: -p.area))
    print(f"cleaned:        {clean.area / 1e6:.0f} km2 in {len(kept)} parts")

    ugb_zone = unary_union(ugb_lines.geometry).buffer(EDGE_TOL_M)
    metro_edge_zone = metro.boundary.buffer(EDGE_TOL_M)
    rows = []
    for p in clean.geoms:
        on_ugb = p.exterior.intersection(ugb_zone).length / p.exterior.length
        on_edge = p.exterior.intersection(metro_edge_zone).length / p.exterior.length
        if on_ugb + on_edge < REVIEW_THRESHOLD:
            pt = p.representative_point()
            lga_name = metro_lga[metro_lga.contains(pt)]["lga_name"].tolist()
            rows.append({
                "area_km2": round(p.area / 1e6, 2),
                "lga": ", ".join(lga_name),
                "pct_edge_on_ugb": round(on_ugb * 100),
                "pct_edge_on_metro_edge": round(on_edge * 100),
                "geometry": p,
            })
    review = gpd.GeoDataFrame(rows, geometry="geometry", crs=CRS)

    OUT.unlink(missing_ok=True)
    gpd.GeoDataFrame(
        {"name": ["Melbourne UGB"], "area_km2": [round(clean.area / 1e6, 1)],
         "n_parts": [len(kept)]},
        geometry=[clean], crs=CRS,
    ).to_file(OUT, layer="ugb_polygon", driver="GPKG")
    review.to_file(OUT, layer="review_pieces", driver="GPKG")

    print(f"review pieces:  {len(review)} ({review['area_km2'].sum():.1f} km2)")
    if len(review):
        print(review.drop(columns="geometry").sort_values("area_km2", ascending=False)
              .to_string(index=False))
    print(f"wrote {OUT}")


if __name__ == "__main__":
    main()

