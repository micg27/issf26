PH3 = cfg4.PHASE3_DIR


def check_A_B(city):
    e = xr.open_dataset(PH3 / city / f"{city}_scenarios_train_all.nc")["emission_total"].values
    r = e[:, 1:] / e[:, [0]]
    m = N.load_maps(city, "all2025", "all")["test"]
    D = m["meta"]["day"].nunique()
    Xr = N.centred(m["X"]).reshape(D, -1, m["X"].shape[1])
    syn = Xr[:, 1:]
    rand = syn - syn.mean(axis=1, keepdims=True)
    print(f"  A emission total ratio synthetic/base: mean {r.mean():.3f} (5-95% {np.percentile(r, 5):.2f}-{np.percentile(r, 95):.2f})")
    print(f"  B random share of synthetic spatial variance: {100 * np.mean(rand**2) / np.mean(syn**2):.0f}%")


def check_D(city):
    dom = xr.open_dataset(PH3 / city / f"{city}_domain.nc")
    met = transport.load_met(city, cfg4.phase3.PHASE2_DIR, pd.Timestamp("2023-01-01"), pd.Timestamp("2023-12-31 23:00"))
    f = transport.met_to_domain(met, dom)
    speed = np.hypot(f["u10"], f["v10"]).mean()
    spread = (f["u10"].std(axis=(1, 2)) + f["v10"].std(axis=(1, 2))).mean()
    print(f"  D wind (2023): spatial SD of u+v across domain = {100 * spread / speed:.0f}% of mean speed "
          f"({met.sizes['latitude']}x{met.sizes['longitude']} ERA5 points)")


def check_M(city, days):
    pdir = PH3 / city
    dom = xr.open_dataset(pdir / f"{city}_domain.nc")
    cal = json.load(open(pdir / f"{city}_calibration.json"))
    cand = pd.read_csv(pdir / f"{city}_candidates.csv")
    cells = (cand["domain_row"].to_numpy(), cand["domain_col"].to_numpy())
    flux = (cal["alpha_ug_per_s_per_person"] * dom["population"].values / 4e6)[None]
    off = cfg4.phase3.city_config(city)["utc_offset_hours"]
    for day in days:
        res = {}
        for spin in (24, 72):
            start = pd.Timestamp(day) - pd.Timedelta(hours=off + spin)
            f = transport.met_to_domain(
                transport.load_met(city, cfg4.phase3.PHASE2_DIR, start, start + pd.Timedelta(hours=spin + 24)), dom)
            r = transport.run(f, 2000.0, flux, [0.0], cal["K_m2_s"], [0.0], np.zeros_like(flux), sample_cells=cells)
            res[spin] = r["samples"][spin:, 0].mean(axis=0)
        print(f"  M {day}: 72 h vs 24 h spin-up mean change {100 * (res[72].mean() / res[24].mean() - 1):+.1f}%, "
              f"pattern r = {np.corrcoef(res[24], res[72])[0, 1]:.3f}")


def check_X(city):
    m = N.load_maps(city, "all2025", "all")
    te = m["test"]
    X, w, meta = te["X"], te["w"], te["meta"]
    nets = pd.read_csv(cfg4.processed_dir(city) / f"{city}_networks_trainall.csv")
    kj = json.load(open(cfg4.processed_dir(city) / f"{city}_kriging_trainall.json"))
    vg, sd = kj["variogram"], kj["noise_sd_ug_m3"]["f0.25"]
    K = N.covariance(m["cells"], vg)
    week = pd.to_datetime(meta["date"]).dt.isocalendar().week.to_numpy()
    rows = {k: np.nonzero(week == k)[0] for k in np.unique(week)}
    weeks = np.array(list(rows))
    n = cfg4.HEADLINE_N[city]

    def mse(strategy, noise):
        S = nets[(nets.strategy == strategy) & (nets.noise == noise) & (nets.N == n)].sort_values("rank").cell_index.tolist()
        W = N.ok_weights(K, S, N.sensor_variance(vg, sd**2))
        return N.map_mse(X, S, W, sd**2)

    g, k = mse("greedy", "f0.25"), mse("kmeans", "any")
    rng = np.random.default_rng(1)
    bs = []
    for _ in range(2000):
        i = np.concatenate([rows[x] for x in rng.choice(weeks, len(weeks))])
        bs.append(1 - np.sqrt(np.sum(w[i] * g[i]) / w[i].sum()) / np.sqrt(np.sum(w[i] * k[i]) / w[i].sum()))
    print(f"  X headline N={n}: {100 * (1 - np.sqrt(np.sum(w * g) / np.sum(w * k))):+.1f}%, "
          f"weekly-block CI {100 * np.percentile(bs, 2.5):+.1f} to {100 * np.percentile(bs, 97.5):+.1f}")


if __name__ == "__main__":
    for city in cfg4.ALL_CITIES:
        print(f"=== {city}")
        check_A_B(city)
        check_D(city)
        check_X(city)
    print("=== melbourne spin-up")
    check_M("melbourne", ["2025-06-13", "2025-05-10", "2025-07-07", "2025-03-15"])

# 01_evaluate.py
"""
Phase 5: score every Phase 4 network on the held-out 2025 test maps.

Networks were chosen from 2021-2024 training maps only, so this is an
out-of-sample test. Every network is scored with the same ordinary-kriging
reconstruction and exact expected error under sensor noise (networks.py).

Headline (pre-registered in METHODS.md, "Phase 4-5 design"):
    relative improvement = (RMSE_kmeans - RMSE_greedy) / RMSE_kmeans
at each city's headline N and headline noise (f = 0.25), with a 95% CI
from a stratified bootstrap over test days: days are resampled with
replacement within each regime, so every regime keeps its weight w_k.
Greedy and k-means are scored on the same resampled days (paired).

The city comparison is reported three ways, as pre-registered:
    own network size   Singapore N = 22 vs Melbourne N = 8
    equal count        both cities at the same N
    equal density      Melbourne N ~= 4 x Singapore N (candidate area ratio)

Outputs:
    data/processed/phase5/<city>/<city>_test_scores.csv  every strategy x noise x N
    data/processed/phase5/<city>/<city>_improvement.csv  greedy vs k-means vs N, with CIs
    data/processed/phase5/phase5_results.json            headline numbers
    outputs/phase5/...                                   figures

Usage:
    python 01_evaluate.py
"""

import argparse
import importlib.util
import json
import sys
from pathlib import Path

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

PROJECT_ROOT = Path(__file__).resolve().parents[3]
P4 = PROJECT_ROOT / "Workflow" / "Phase 4" / "Python files"
sys.path.insert(0, str(P4))
import networks as N  # noqa: E402

_spec = importlib.util.spec_from_file_location("phase4_config", P4 / "config.py")
cfg = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(cfg)

OUT_DATA = PROJECT_ROOT / "data" / "processed" / "phase5"
OUT_FIG = PROJECT_ROOT / "outputs" / "phase5"
TEST_SET = "selected"        # set from --test-set; "all2025" = post-results extension
TRAIN_SET = "selected"       # set from --train-set; "all" = networks chosen from every 2021-24 day
SUFFIX = ""
NET_SUFFIX = ""
K_TAG = ""                   # Phase 8: e.g. "_K200" = simulations and networks at K = 200
N_BOOT = 2000
RANDOM_N_STEP = 5            # random baseline every 5th N (plus headline N)
HEADLINE = f"f{cfg.HEADLINE_NOISE_FRACTION:g}"


def city_dirs(city):
    d, f = OUT_DATA / city, OUT_FIG / (city + SUFFIX)
    d.mkdir(parents=True, exist_ok=True)
    f.mkdir(parents=True, exist_ok=True)
    return d, f


def bootstrap_index(meta, n_boot, seed):
    """Stratified day bootstrap -> list of map-index arrays."""
    rng = np.random.default_rng(seed)
    days_by_regime = {r: g["day"].unique() for r, g in meta.groupby("regime")}
    maps_by_day = {d: np.nonzero(meta["day"].to_numpy() == d)[0] for d in meta["day"].unique()}
    out = []
    for _ in range(n_boot):
        idx = []
        for r, days in days_by_regime.items():
            for d in rng.choice(days, len(days), replace=True):
                idx.append(maps_by_day[d])
        out.append(np.concatenate(idx))
    return out


def weighted_rmse(mse, w, idx=None):
    if idx is None:
        return float(np.sqrt(np.sum(w * mse)))
    # Resampled maps keep their regime weight; renormalise in case a
    # resample changes how many maps each regime has (it doesn't here).
    ww = w[idx]
    return float(np.sqrt(np.sum(ww * mse[idx]) / ww.sum()))


def evaluate(city):
    print(f"=== {city}")
    data_dir, fig_dir = city_dirs(city)
    maps = (N.load_maps(city, TEST_SET, "all", k_tag=K_TAG) if K_TAG
            else N.load_maps(city, TEST_SET))
    te, cells = maps["test"], maps["cells"]
    X, w, meta = te["X"], te["w"], te["meta"]
    C = X.shape[1]
    p4 = cfg.processed_dir(city)
    nets = pd.read_csv(p4 / f"{city}_networks{NET_SUFFIX}.csv")
    kj = json.load(open(p4 / f"{city}_kriging{NET_SUFFIX}.json"))
    vg = kj["variogram"]
    K = N.covariance(cells, vg)
    noise = kj["noise_sd_ug_m3"]
    print(f"  {len(X)} test maps over {meta['day'].nunique()} days")

    def per_map_mse(S, sd):
        W = N.ok_weights(K, S, N.sensor_variance(vg, sd**2))
        return N.map_mse(X, S, W, sd**2)

    rows, mse_store = [], {}
    for label, sd in noise.items():
        for strat in ("greedy", "qr", "kmeans", "existing"):
            sub = nets[(nets["strategy"] == strat)
                       & (nets["noise"].isin([label] if strat == "greedy" else ["any"]))]
            for n, g in sub.groupby("N"):
                S = g.sort_values("rank")["cell_index"].tolist()
                mse = per_map_mse(S, sd)
                mse_store[(strat, label, n)] = mse
                rows.append((strat, label, n, weighted_rmse(mse, w)))
        print(f"  scored {label}")

    # Random baseline: mean over networks, headline noise, every RANDOM_N_STEP
    sd = noise[HEADLINE]
    n_vals = sorted(set(range(cfg.N_MIN, cfg.N_MAX[city] + 1, RANDOM_N_STEP))
                    | {cfg.HEADLINE_N[city]})
    for n in n_vals:
        vals = [weighted_rmse(per_map_mse(S, sd), w)
                for S in N.random_networks(C, n, cfg.N_RANDOM_NETWORKS, cfg.RANDOM_SEED)]
        rows.append(("random_mean", HEADLINE, n, float(np.mean(vals))))
        rows.append(("random_p05", HEADLINE, n, float(np.percentile(vals, 5))))

    scores = pd.DataFrame(rows, columns=["strategy", "noise", "N", "test_rmse"])
    scores.to_csv(data_dir / f"{city}_test_scores{SUFFIX}.csv", index=False)

    # Greedy vs k-means: improvement and paired bootstrap CI, every N, every noise.
    boots = bootstrap_index(meta, N_BOOT, [cfg.RANDOM_SEED, 5, len(city)])
    imp_rows = []
    for label in noise:
        for n in range(cfg.N_MIN, cfg.N_MAX[city] + 1):
            g, k = mse_store[("greedy", label, n)], mse_store[("kmeans", label, n)]
            point = 1 - weighted_rmse(g, w) / weighted_rmse(k, w)
            bs = np.array([1 - weighted_rmse(g, w, i) / weighted_rmse(k, w, i) for i in boots])
            imp_rows.append((label, n, point, *np.percentile(bs, [2.5, 97.5]), bs.std()))
    imp = pd.DataFrame(imp_rows, columns=["noise", "N", "improvement", "ci_low", "ci_high", "boot_sd"])
    imp.to_csv(data_dir / f"{city}_improvement{SUFFIX}.csv", index=False)

    # Per-regime improvement at the headline budget and noise.
    n0 = cfg.HEADLINE_N[city]
    g0, k0 = mse_store[("greedy", HEADLINE, n0)], mse_store[("kmeans", HEADLINE, n0)]
    by_regime = {}
    for r, sub in meta.groupby("regime"):
        i = sub.index.to_numpy()
        by_regime[r] = 1 - np.sqrt(np.mean(g0[i])) / np.sqrt(np.mean(k0[i]))

    # Equivalent sensors: smallest k-means N matching greedy's error at n0.
    sc = scores[scores["noise"] == HEADLINE]
    target = sc[(sc["strategy"] == "greedy") & (sc["noise"] == HEADLINE) & (sc["N"] == n0)]["test_rmse"].item()
    km = sc[sc["strategy"] == "kmeans"].sort_values("N")
    match = km[km["test_rmse"] <= target]
    equiv = int(match["N"].iloc[0]) if len(match) else None

    plot(city, scores, imp, fig_dir)
    return {"scores": scores, "imp": imp, "boots": boots, "mse": mse_store, "w": w,
            "by_regime": by_regime, "equiv_kmeans_N": equiv, "meta": meta}


def improvement_draws(res, label, n):
    g, k, w = res["mse"][("greedy", label, n)], res["mse"][("kmeans", label, n)], res["w"]
    return np.array([1 - weighted_rmse(g, w, i) / weighted_rmse(k, w, i) for i in res["boots"]])


def compare(sg, mel):
    """Melbourne minus Singapore improvement, with CIs (independent bootstraps)."""
    pairs = {
        "own_network_size": (cfg.HEADLINE_N["singapore"], cfg.HEADLINE_N["melbourne"]),
        "equal_count_N8": (8, 8),
        "equal_count_N22": (22, 22),
        "equal_count_N40": (40, 40),
        "equal_density_SG8_MEL32": (8, 32),
        "equal_density_SG22_MEL88": (22, 88),
        "equal_density_SG40_MEL160": (40, 160),
    }
    out = {}
    for name, (ns, nm) in pairs.items():
        ds, dm = improvement_draws(sg, HEADLINE, ns), improvement_draws(mel, HEADLINE, nm)
        def pt(res, n):
            row = res["imp"][(res["imp"]["noise"] == HEADLINE) & (res["imp"]["N"] == n)]
            return float(row["improvement"].item())
        diff = dm - ds
        out[name] = {"N_singapore": ns, "N_melbourne": nm,
                     "improvement_singapore": pt(sg, ns), "improvement_melbourne": pt(mel, nm),
                     "difference_mel_minus_sg": pt(mel, nm) - pt(sg, ns),
                     "difference_ci95": np.percentile(diff, [2.5, 97.5]).tolist()}
    return out


BANDS = {"singapore": [(5, 10), (11, 20), (21, 40)],
         "melbourne": [(5, 10), (11, 20), (21, 40), (41, 80), (81, 160)]}


def band_means(city, res):
    """DESCRIPTIVE, not pre-registered: mean improvement over bands of N.

    Single-N values are jagged because k-means lands on better or worse
    layouts from one N to the next. Averaging over a band of budgets
    smooths that out. The CI comes from the same paired day-bootstrap, by
    averaging each draw over the band.
    """
    out = {}
    for lo, hi in BANDS[city]:
        draws = np.mean([improvement_draws(res, HEADLINE, n) for n in range(lo, hi + 1)], axis=0)
        imp = res["imp"]
        pt = imp[(imp["noise"] == HEADLINE) & imp["N"].between(lo, hi)]["improvement"].mean()
        out[f"N{lo}-{hi}"] = [float(pt), *np.percentile(draws, [2.5, 97.5]).tolist()]
    return out


def plot(city, scores, imp, fig_dir):
    fig, axes = plt.subplots(1, 2, figsize=(12, 4.2))
    ax = axes[0]
    for strat, style in [("greedy", "-"), ("kmeans", "-"), ("qr", "--"), ("random_mean", ":")]:
        s = scores[(scores["strategy"] == strat) & (scores["noise"] == HEADLINE)].sort_values("N")
        ax.plot(s["N"], s["test_rmse"], style, label=strat)
    ex = scores[(scores["strategy"] == "existing") & (scores["noise"] == HEADLINE)]
    if len(ex):
        ax.plot(ex["N"], ex["test_rmse"], "k*", ms=10, label="existing EPA network")
    ax.axvline(cfg.HEADLINE_N[city], color="grey", ls=":", lw=1)
    km = scores[(scores["strategy"] == "kmeans") & (scores["noise"] == HEADLINE)]["test_rmse"]
    ax.set_ylim(0, 1.6 * km.max())
    ax.set_xlabel("number of sensors N")
    ax.set_ylabel("test RMSE, 2025 days (ug/m3)")
    ax.set_title(f"{city}: reconstruction error (noise f = {cfg.HEADLINE_NOISE_FRACTION})")
    ax.legend(fontsize=8)

    ax = axes[1]
    s = imp[imp["noise"] == HEADLINE]
    ax.plot(s["N"], 100 * s["improvement"], color="#c0392b")
    ax.fill_between(s["N"], 100 * s["ci_low"], 100 * s["ci_high"], color="#c0392b", alpha=0.2)
    ax.axhline(0, color="k", lw=0.8)
    ax.axvline(cfg.HEADLINE_N[city], color="grey", ls=":", lw=1)
    ax.set_xlabel("number of sensors N")
    ax.set_ylabel("greedy improvement over k-means (%)")
    ax.set_title("weather-informed vs evenly spread (95% CI)")
    fig.tight_layout()
    fig.savefig(fig_dir / "test_results.png", dpi=130)
    plt.close(fig)


def summarize(city, res):
    imp, sc = res["imp"], res["scores"]
    n0 = cfg.HEADLINE_N[city]
    h = imp[(imp["noise"] == HEADLINE) & (imp["N"] == n0)].iloc[0]
    def rm(strat, noise, n):
        r = sc[(sc["strategy"] == strat) & (sc["noise"] == noise) & (sc["N"] == n)]
        return float(r["test_rmse"].item()) if len(r) else None
    out = {
        "headline_N": n0,
        "test_rmse": {s: rm(s, HEADLINE, n0) for s in ("greedy", "kmeans", "qr", "random_mean")},
        "improvement_greedy_vs_kmeans": float(h["improvement"]),
        "ci95": [float(h["ci_low"]), float(h["ci_high"])],
        "improvement_by_regime": {k: float(v) for k, v in res["by_regime"].items()},
        "equivalent_kmeans_N": res["equiv_kmeans_N"],
        "improvement_by_noise": {
            r["noise"]: [float(r["improvement"]), float(r["ci_low"]), float(r["ci_high"])]
            for _, r in imp[imp["N"] == n0].iterrows()},
    }
    if city == "melbourne":
        ex = sc[(sc["strategy"] == "existing") & (sc["noise"] == HEADLINE)]
        out["test_rmse"]["existing"] = float(ex["test_rmse"].item())
        out["existing_N"] = int(ex["N"].item())
    return out


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="Phase 5 evaluation.")
    ap.add_argument("--test-set", choices=["selected", "all2025"], default="selected",
                    help="selected = pre-registered 18-19 test days; "
                         "all2025 = post-results extension to every 2025 day")
    ap.add_argument("--train-set", choices=["selected", "all"], default="selected",
                    help="which Phase 4 networks: chosen from the sampled training days "
                         "(pre-registered) or from every 2021-2024 day (extension)")
    ap.add_argument("--k", type=float, default=None,
                    help="Phase 8: K (m2/s) of the simulations; needs --test-set all2025 --train-set all")
    args = ap.parse_args()
    TEST_SET, TRAIN_SET = args.test_set, args.train_set
    if args.k is not None and (TEST_SET, TRAIN_SET) != ("all2025", "all"):
        ap.error("--k needs --test-set all2025 --train-set all")
    K_TAG = "" if args.k is None else f"_K{args.k:g}"
    NET_SUFFIX = ("" if TRAIN_SET == "selected" else "_trainall") + K_TAG
    SUFFIX = ("" if TEST_SET == "selected" else "_all2025") + NET_SUFFIX
    res = {c: evaluate(c) for c in cfg.ALL_CITIES}
    results = {c: summarize(c, r) for c, r in res.items()}
    for c, r in res.items():
        results[c]["band_mean_improvement_descriptive"] = band_means(c, r)
    results["city_comparison"] = compare(res["singapore"], res["melbourne"])
    OUT_DATA.mkdir(parents=True, exist_ok=True)
    results["test_set"] = TEST_SET
    results["train_set"] = TRAIN_SET
    results["K_m2_s"] = args.k
    with open(OUT_DATA / f"phase5_results{SUFFIX}.json", "w") as f:
        json.dump(results, f, indent=2)
    print(json.dumps(results, indent=2))

# 04_emission_predictability.py
"""
Emission-predictability experiment (pre-stated in METHODS.md, 2026-10-04).

Assembles the predictability ladder L0-L5 from the ingredient runs (Phase 3
06_emission_ingredients.py) by linear superposition, then for each level
(and each fixed-site set for L2-L4):
    * chooses greedy networks from the 2021-2024 training maps, with noise
      f = 0.25 relative to that level's training maps;
    * scores greedy against the unchanged k-means networks on the 2025 maps
      of the same level (same kriging, stratified paired day-bootstrap);
    * reports improvement at each budget, plus Melbourne-minus-Singapore
      differences at own size, equal count and equal density.

Levels (20 scenarios per day; point magnitudes lognormal sigma 1 with mean
p x total / J, drawn per site, day and scenario, the same draws scaled
by p at every level):
    L0  base only (emissions known exactly)
    L1  area noise only (p = 0, sigma_area = 0.5)
    L2  fixed sites, p = 0.1, no area noise
    L3  fixed sites, p = 0.3, no area noise
    L4  fixed sites, p = 0.3, sigma_area = 0.5
    L5  random sites re-drawn every scenario (existing Phase 3 design)

Output: data/processed/phase5/phase5_emission_predictability.json
        outputs/phase5/emission_predictability.png

Usage:
    python 04_emission_predictability.py
    python 04_emission_predictability.py --k 200   # Phase 8: K = 200 files, *_K200 outputs
"""

import argparse
import importlib.util
import json
import sys
from pathlib import Path

import dask
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import xarray as xr

dask.config.set(scheduler="synchronous")

ROOT = Path(__file__).resolve().parents[3]
K_TAG = ""   # Phase 8: e.g. "_K200" = ingredients, scenarios and outputs at K = 200
P4 = ROOT / "Workflow" / "Phase 4" / "Python files"
sys.path.insert(0, str(P4))
import networks as N  # noqa: E402

_spec = importlib.util.spec_from_file_location("cfg4", P4 / "config.py")
cfg = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(cfg)

N_BOOT = 2000
J = 5
N_AREA = 20
N_VALUES = {"singapore": [5, 8, 10, 15, 22, 30, 40],
            "melbourne": [5, 8, 10, 15, 22, 30, 32, 40, 60, 88, 120, 160]}
LEVELS = {  # name: (point mode, p, use area noise)
    "L0": (None, 0.0, False),
    "L1": (None, 0.0, True),
    "L2": ("fixed", 0.1, False),
    "L3": ("fixed", 0.3, False),
    "L4": ("fixed", 0.3, True),
    "L5": ("random", 0.3, True),
}
PAIRS = {"own_network_size": (22, 8), "equal_count_N8": (8, 8), "equal_count_N22": (22, 22),
         "equal_count_N40": (40, 40), "equal_density_SG8_MEL32": (8, 32),
         "equal_density_SG22_MEL88": (22, 88), "equal_density_SG40_MEL160": (40, 160)}


def load_ingredients(city, period):
    ds = xr.open_dataset(cfg.PHASE3_DIR / city / f"{city}_ingredients_{period}{K_TAG}.nc")
    meta = pd.DataFrame({"date": pd.to_datetime(ds["date"].values),
                         "regime": ds["regime"].values.astype(str),
                         "w_k": ds["w_k"].values})
    return ds["response"].values.astype(float), meta, ds.attrs["base_total_ug_s"], ds["cell_id"].values


def magnitudes(meta, site_set):
    """(day, member, J) magnitudes per unit p: mean total / J, lognormal sigma 1."""
    out = np.empty((len(meta), N_AREA, J))
    for d, date in enumerate(meta["date"]):
        rng = np.random.default_rng([cfg.RANDOM_SEED, 63, date.year, date.dayofyear, site_set])
        out[d] = rng.lognormal(-0.5, 1.0, (N_AREA, J))
    return out


def assemble(resp, meta, total, level, site_set):
    """Maps (day*member, cell) and their metadata for one level."""
    mode, p, area = LEVELS[level]
    base = resp[:, 0]                                         # (D, C)
    area_m = resp[:, 1:1 + N_AREA]                            # (D, M, C)
    local = area_m if area else np.repeat(base[:, None], N_AREA, axis=1)
    X = (1 - p) * local
    if mode == "fixed":
        k0 = 1 + N_AREA + J * site_set
        R = resp[:, k0:k0 + J]                                # (D, J, C) per 1 ug/s
        a = p * total / J * magnitudes(meta, site_set)        # (D, M, J)
        X = X + np.einsum("dmj,djc->dmc", a, R)
    D, M, C = X.shape
    m = pd.DataFrame({"day": np.repeat(np.arange(D), M), "member": np.tile(np.arange(M), D),
                      "regime": np.repeat(meta["regime"].values, M),
                      "w_k": np.repeat(meta["w_k"].values, M), "date": np.repeat(meta["date"].values, M)})
    return X.reshape(D * M, C), m


def existing_L5(city):
    maps = N.load_maps(city, test_set="all2025", train_set="all", k_tag=K_TAG)
    out = {}
    for split in ("train", "test"):
        keep = (maps[split]["meta"]["member"] > 0).to_numpy()
        out[split] = (maps[split]["X"][keep], maps[split]["meta"][keep].reset_index(drop=True))
    return out, maps["cells"]


def weights(m):
    n = m.groupby("regime")["regime"].transform("size").to_numpy()
    w = m["w_k"].to_numpy() / n
    return w / w.sum()


def boot_index(m, seed):
    rng = np.random.default_rng(seed)
    days, reg = m["day"].to_numpy(), m["regime"].to_numpy()
    by_reg = {r: np.unique(days[reg == r]) for r in np.unique(reg)}
    rows = {d: np.nonzero(days == d)[0] for d in np.unique(days)}
    return [np.concatenate([rows[d] for v in by_reg.values() for d in rng.choice(v, len(v))])
            for _ in range(N_BOOT)]


def evaluate_level(city, cells, kmeans_nets, Xtr, mtr, Xte, mte):
    wtr, wte = weights(mtr), weights(mte)
    Sigma = N.second_moment(Xtr, wtr)
    vg = N.fit_variogram(cells, Sigma)
    K = N.covariance(cells, vg)
    sd = cfg.HEADLINE_NOISE_FRACTION * N.spatial_sd(Xtr, wtr)
    order, _ = N.greedy_rmse(K, Sigma, vg, sd**2, max(N_VALUES[city]))
    boots = boot_index(mte, [cfg.RANDOM_SEED, 64, len(city)])

    def mse(S):
        W = N.ok_weights(K, S, N.sensor_variance(vg, sd**2))
        return N.map_mse(Xte, S, W, sd**2)

    def imp(g, k, i):
        return 1 - np.sqrt(np.sum(wte[i] * g[i]) / wte[i].sum()) / np.sqrt(np.sum(wte[i] * k[i]) / wte[i].sum())

    res, draws = {}, {}
    allrows = np.arange(len(Xte))
    for n in N_VALUES[city]:
        g, k = mse(order[:n]), mse(kmeans_nets[n])
        bs = np.array([imp(g, k, i) for i in boots])
        res[str(n)] = [float(imp(g, k, allrows)), *np.percentile(bs, [2.5, 97.5]).tolist()]
        draws[n] = bs
    return {"improvement": res, "noise_sd": sd, "variogram_range_km": vg["range_m"] / 1000,
            "train_spatial_sd": N.spatial_sd(Xtr, wtr)}, draws


def run_city(city):
    print(f"=== {city}")
    nets = pd.read_csv(cfg.processed_dir(city) / f"{city}_networks_trainall.csv")
    km = nets[nets["strategy"] == "kmeans"]
    kmeans_nets = {n: g.sort_values("rank")["cell_index"].tolist() for n, g in km.groupby("N")}
    L5, cells = existing_L5(city)
    rtr, mtr0, total, ids = load_ingredients(city, "train")
    rte, mte0, _, ids_te = load_ingredients(city, "test2025")
    assert np.array_equal(ids, cells["cell_id"].values) and np.array_equal(ids_te, ids)

    out, draws = {}, {}
    for level in LEVELS:
        sets = [0, 1] if LEVELS[level][0] == "fixed" else [None]
        for s in sets:
            key = level if s is None else f"{level}_set{'AB'[s]}"
            if level == "L5":
                (Xtr, mtr), (Xte, mte) = L5["train"], L5["test"]
            else:
                Xtr, mtr = assemble(rtr, mtr0, total, level, s or 0)
                Xte, mte = assemble(rte, mte0, total, level, s or 0)
            out[key], draws[key] = evaluate_level(city, cells, kmeans_nets, Xtr, mtr, Xte, mte)
            hn = cfg.HEADLINE_N[city]
            r = out[key]["improvement"][str(hn)]
            print(f"  {key:9s} N={hn}: {100 * r[0]:+.1f}% ({100 * r[1]:+.1f}, {100 * r[2]:+.1f})")
    return out, draws


def compare(sg, mel, dsg, dmel):
    out = {}
    for key in sg:
        out[key] = {}
        for name, (ns, nm) in PAIRS.items():
            diff = dmel[key][nm] - dsg[key][ns]
            pt = mel[key]["improvement"][str(nm)][0] - sg[key]["improvement"][str(ns)][0]
            out[key][name] = [float(pt), *np.percentile(diff, [2.5, 97.5]).tolist()]
    return out


def plot(results):
    order = ["L0", "L1", "L2_setA", "L2_setB", "L3_setA", "L3_setB", "L4_setA", "L4_setB", "L5"]
    fig, axes = plt.subplots(1, 3, figsize=(15, 4.3), sharey=True)
    for ax, (ns, nm, title) in zip(axes, [(22, 8, "own network size (SG 22, MEL 8)"),
                                          (22, 22, "equal count (N = 22)"),
                                          (22, 88, "equal density (SG 22, MEL 88)")]):
        for city, n, col in [("singapore", ns, "#2e86c1"), ("melbourne", nm, "#c0392b")]:
            v = np.array([results[city][k]["improvement"][str(n)] for k in order]) * 100
            x = np.arange(len(order)) + (-0.12 if city == "singapore" else 0.12)
            ax.errorbar(x, v[:, 0], yerr=[v[:, 0] - v[:, 1], v[:, 2] - v[:, 0]], fmt="o",
                        color=col, capsize=3, label=f"{city} (N = {n})")
        ax.axhline(0, color="k", lw=0.8)
        ax.set_xticks(range(len(order)))
        ax.set_xticklabels(order, rotation=45, fontsize=8)
        ax.set_title(title)
        ax.legend(fontsize=8)
    axes[0].set_ylabel("greedy improvement over k-means (%)")
    fig.suptitle("Weather-informed placement vs emission predictability "
                 "(L0 = known emissions ... L5 = random relocating sources)")
    fig.tight_layout()
    out = ROOT / "outputs" / "phase5"
    out.mkdir(parents=True, exist_ok=True)
    fig.savefig(out / f"emission_predictability{K_TAG}.png", dpi=130)
    plt.close(fig)


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="Emission-predictability experiment.")
