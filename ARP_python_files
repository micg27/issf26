# 11_extract_phase3_data.py
"""
Write one NetCDF file per selected day, containing the 24 hourly wind and
boundary-layer fields that Phase 3's advection-diffusion model will use.

Local day boundaries are converted back to UTC using the SAME helper that
script 04 used to build the features, so the day you simulate is exactly
the day you clustered. (Previously this logic was duplicated inline in two
scripts, which is how these drift apart.)

Also writes phase3_manifest.csv, mapping each output file to its regime,
split and w_k, so Phase 3 can iterate without re-deriving anything.

Usage:
    python 11_extract_phase3_data.py --all
"""

import pandas as pd
import xarray as xr

import config
import utils


EXTRACT_VARS = ["u10", "v10", "blh"]


def extract(city):

    utils.banner(f"EXTRACT PHASE 3 DATA: {city}")

    base = config.processed_dir(city)

    manifest_path = base / f"{city}_phase3_days.csv"

    if not manifest_path.exists():
        raise FileNotFoundError(
            f"{manifest_path} not found; run 10_build_phase3_days.py first."
        )

    selected = pd.read_csv(manifest_path, parse_dates=["date"])

    files = [
        base / f"{city}_hourly_{year}.nc"
        for year in config.YEARS
    ]

    ds = xr.open_mfdataset(files, combine="by_coords")
    ds = ds.sortby("time")

    out_dir = base / "phase3_weather"
    out_dir.mkdir(parents=True, exist_ok=True)

    records = []
    skipped = []

    for _, row in selected.iterrows():

        date = row["date"]

        utc_start, utc_end = utils.local_day_bounds_utc(date, city)

        day = ds.sel(time=slice(utc_start, utc_end))

        n_hours = day.sizes.get("time", 0)

        if n_hours != 24:
            print(
                f"  SKIP {date.date()}: {n_hours} hours "
                f"(expected 24)"
            )
            skipped.append(str(date.date()))
            continue

        filename = (
            f"{city}_{date.date()}_{row['regime']}_{row['split']}.nc"
        )

        outfile = out_dir / filename

        subset = day[EXTRACT_VARS]

        # Record provenance inside the file itself so a stray NetCDF is
        # never ambiguous later.
        subset.attrs.update(
            {
                "city": city,
                "local_date": str(date.date()),
                "regime": str(row["regime"]),
                "split": str(row["split"]),
                "selection": str(row["selection"]),
                "w_k": float(row["w_k"]),
                "utc_start": str(utc_start),
                "utc_end": str(utc_end),
                "use_dst": str(config.USE_DST),
            }
        )

        subset.to_netcdf(outfile)

        records.append(
            {
                "file": filename,
                "city": city,
                "date": date.date(),
                "regime": row["regime"],
                "split": row["split"],
                "selection": row["selection"],
                "w_k": row["w_k"],
            }
        )

    if not records:
        raise RuntimeError(
            "No days were extracted. Check your date range and offsets."
        )

    out_manifest = pd.DataFrame(records)

    out_manifest.to_csv(
        out_dir / f"{city}_phase3_manifest.csv", index=False
    )

    print(f"\n  Extracted {len(records)} days to {out_dir}")

    if skipped:
        print(f"  Skipped {len(skipped)}: {skipped}")

    print("\n  Files by regime and split:")
    print(
        pd.crosstab(
            out_manifest["regime"], out_manifest["split"]
        ).to_string()
    )


def main():

    cities = utils.parse_cities("Extract per-day fields for Phase 3.")

    for city in cities:
        extract(city)


if __name__ == "__main__":
    main()

# 02_preprocess_hourly.py
"""
Raw ERA5 -> clean hourly NetCDF, one file per city per year.

Replaces your 02_preprocess_hourly.py + the 02a_modification.py stub.
The logic is now a function, so it loops over cities and years instead of
requiring you to hand-edit CITY and YEAR and re-run.

Also handles NetCDF input as well as GRIB.

Usage:
    python 02_preprocess_hourly.py --all
    python 02_preprocess_hourly.py --city melbourne --year 2023
"""

import numpy as np
import xarray as xr

import config
import utils


def process(city, year):

    utils.banner(f"PREPROCESS: {city} {year}")

    out_dir = config.processed_dir(city)
    outfile = out_dir / f"{city}_hourly_{year}.nc"

    if outfile.exists():
        print(f"  Already exists, skipping: {outfile.name}")
        return

    files = utils.find_raw_files(city, year)

    print("  Input files:")
    for file in files:
        print(f"    {file.name}")

    # -----------------------------------------------------
    # 1. OPEN AND COLLECT REQUIRED VARIABLES
    # -----------------------------------------------------

    found = {}

    for file in files:

        for group in utils.open_any(file):

            group = utils.standardize_time(group)

            for var in config.REQUIRED_VARS:
                if var in group.data_vars and var not in found:
                    found[var] = group[[var]]

    missing = config.REQUIRED_VARS - set(found)

    if missing:
        raise ValueError(
            f"Missing required variables for {city} {year}: {missing}\n"
            f"Found: {sorted(found)}"
        )

    # -----------------------------------------------------
    # 2. MERGE
    # -----------------------------------------------------

    ds = xr.merge(list(found.values()), join="inner")

    ds = utils.standardize_time(ds)

    ds = ds.sortby("time")

    # -----------------------------------------------------
    # 3. SUBSET TO THE TARGET YEAR
    # -----------------------------------------------------
    #
    # Needed when the raw file spans several years (e.g. a single
    # multi-year download).
    # -----------------------------------------------------

    ds = ds.sel(time=str(year))

    if ds.sizes.get("time", 0) == 0:
        raise ValueError(
            f"No timesteps for {year} in the input files for {city}."
        )

    # -----------------------------------------------------
    # 4. DROP DUPLICATE TIMESTAMPS
    # -----------------------------------------------------

    times = ds["time"].values

    if len(np.unique(times)) != len(times):
        print("  Duplicate timestamps found; keeping first occurrence.")
        _, keep = np.unique(times, return_index=True)
        ds = ds.isel(time=np.sort(keep))

    # -----------------------------------------------------
    # 5. DERIVED VARIABLES
    # -----------------------------------------------------

    ds["wind_speed"] = np.hypot(ds["u10"], ds["v10"])
    ds["wind_speed"].attrs = {
        "long_name": "10 metre wind speed",
        "units": "m s-1",
    }

    # Meteorological convention: direction the wind blows FROM.
    # Kept for QC plots and reporting only. It is deliberately NOT a
    # clustering feature: degrees wrap at 360, so k-means would treat
    # 350 and 10 as far apart. Clustering uses u/v instead.
    ds["wind_direction"] = (
        270.0 - np.degrees(np.arctan2(ds["v10"], ds["u10"]))
    ) % 360.0
    ds["wind_direction"].attrs = {
        "long_name": "Meteorological wind direction (from)",
        "units": "degrees",
    }

    ds["t2m_c"] = ds["t2m"] - 273.15
    ds["t2m_c"].attrs = {
        "long_name": "2 metre temperature",
        "units": "degree_Celsius",
    }

    # -----------------------------------------------------
    # 6. REPORT AND SAVE
    # -----------------------------------------------------

    n_hours = ds.sizes["time"]
    expected = 8784 if year % 4 == 0 else 8760

    print(f"  Timesteps: {n_hours} (expected {expected})")

    if n_hours != expected:
        print(f"  WARNING: {expected - n_hours} hours missing.")

    dims = utils.spatial_dims(ds)
    print(f"  Grid dims: {[(d, ds.sizes[d]) for d in dims]}")

    ds.to_netcdf(outfile)

    print(f"  Saved {outfile}")


def main():

    cities, years = utils.parse_cities(
        "Preprocess raw ERA5 into hourly NetCDF.",
        with_year=True,
    )

    for city in cities:
        for year in years:
            process(city, year)


if __name__ == "__main__":
    main()

