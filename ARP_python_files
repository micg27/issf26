"""
Phase 7 (pre-stated in METHODS.md, 2026-10-25): the budget sweep.

Two questions from the research plan, over the pre-registered sweep
(Singapore N = 5-40, Melbourne N = 5-160), headline noise f = 0.25:

  Q2  diminishing returns (headline)
      Fit RMSE(N) = a * N^(-b) + c to each strategy's test-RMSE curve.
      Marginal gain g(N) = -RMSE'(N) / RMSE(N) from the fitted curve.
      N* = smallest N with g(N) < 1% (also 0.5% and 2%).
      Area-fair city comparison: Melbourne's threshold is applied per
      area-equivalent sensor, i.e. step * g(N) < 1% with
      step = area_MEL / area_SG ~ 3.98 (step = 1 for Singapore).
  Q1  does the advantage hold across N?
      OLS slope of improvement(N) = b0 + b1 * ln N. Prediction: b1 < 0.
      Secondary: Melbourne over N = 5-40 (equal count) and 20-160 (equal
      density with Singapore 5-40).
      Descriptive: N values with CI above / below / straddling zero, and
      sensors saved = k-means N matching greedy's RMSE (fitted curve) - N.

CIs: the same 2,000 regime-stratified day-bootstrap draws as Phase 5;
curves and slopes are refitted on every draw.

Settings: "original" = full-training networks on all 2025 test days
(primary); "L0" = emissions known exactly (secondary). Greedy is re-run
on L0 training maps (nested, so one run covers every N); k-means networks
are unchanged.

Output: data/processed/phase7/phase7_budget_sweep.json
        data/processed/phase7/<city>_<setting>_curves.csv
        outputs/phase7/budget_sweep.png

Usage:
    python 01_budget_sweep.py
    python 01_budget_sweep.py --k 200   # Phase 8: K = 200 files, *_K200 outputs
"""

import argparse
import importlib.util
import json
import sys
from pathlib import Path

import dask
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import xarray as xr
from scipy.optimize import curve_fit

dask.config.set(scheduler="synchronous")

ROOT = Path(__file__).resolve().parents[3]
P4 = ROOT / "Workflow" / "Phase 4" / "Python files"
P5 = ROOT / "Workflow" / "Phase 5" / "Python files"
sys.path.insert(0, str(P4))
import networks as N  # noqa: E402

_spec = importlib.util.spec_from_file_location("cfg4", P4 / "config.py")
cfg = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(cfg)
_spec = importlib.util.spec_from_file_location("eval5", P5 / "01_evaluate.py")
ev5 = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(ev5)

OUT_DATA = ROOT / "data" / "processed" / "phase7"
OUT_FIG = ROOT / "outputs" / "phase7"
N_BOOT = ev5.N_BOOT
K_TAG = ""   # Phase 8: e.g. "_K200" = simulations and networks at K = 200
HEADLINE = ev5.HEADLINE
AREA_KM2 = {"singapore": 655.3, "melbourne": 2611.2}       # Phase 1 candidate land area
STEP = {"singapore": 1.0, "melbourne": AREA_KM2["melbourne"] / AREA_KM2["singapore"]}
THRESHOLDS = [0.005, 0.01, 0.02]
HEADLINE_THRESHOLD = 0.01
N_GRID = np.arange(5, 20001, dtype=float)                  # where N* is searched
SLOPE_RANGES = {"singapore": {"full": (5, 40)},
                "melbourne": {"full": (5, 160), "equal_count_5-40": (5, 40),
                              "equal_density_20-160": (20, 160)}}
SAVED_AT = {"singapore": [8, 22, 40], "melbourne": [8, 22, 32, 40, 88, 160]}
GAIN_AT = {"singapore": [8, 22, 40], "melbourne": [8, 22, 88, 160]}   # incl. real network sizes
BANDS = {"singapore": [(5, 10), (11, 20), (21, 40)],                  # Phase 5's descriptive bands
         "melbourne": [(5, 10), (11, 20), (21, 40), (41, 80), (81, 160)]}


# ---------------------------------------------------------
# DATA
# ---------------------------------------------------------

def setting_original(city):
    m = N.load_maps(city, test_set="all2025", train_set="all", k_tag=K_TAG)
    kj = json.load(open(cfg.processed_dir(city) / f"{city}_kriging_trainall{K_TAG}.json"))
    nets = pd.read_csv(cfg.processed_dir(city) / f"{city}_networks_trainall{K_TAG}.csv")
    greedy = nets[(nets["strategy"] == "greedy") & (nets["noise"] == HEADLINE)]
    return {"cells": m["cells"], "test": m["test"], "vg": kj["variogram"],
            "sd": kj["noise_sd_ug_m3"][HEADLINE],
            "greedy": {n: g.sort_values("rank")["cell_index"].tolist() for n, g in greedy.groupby("N")}}


def setting_L0(city, cells):
    packed = []
    for period in ("train", "test2025"):
        ds = xr.open_dataset(cfg.PHASE3_DIR / city / f"{city}_ingredients_{period}{K_TAG}.nc")
        meta = pd.DataFrame({"day": np.arange(ds.sizes["day"]), "member": 0,
                             "date": ds["date"].values, "regime": ds["regime"].values.astype(str),
                             "w_k": ds["w_k"].values})
        assert np.array_equal(ds["cell_id"].values, cells["cell_id"].values)
        packed.append(N._pack(ds["response"].values[:, 0].astype(float), meta))
        ds.close()
    train, test = packed
    Sigma = N.second_moment(train["X"], train["w"])
    vg = N.fit_variogram(cells, Sigma)
    sd = cfg.HEADLINE_NOISE_FRACTION * N.spatial_sd(train["X"], train["w"])
    order, _ = N.greedy_rmse(N.covariance(cells, vg), Sigma, vg, sd**2, cfg.N_MAX[city])
    return {"cells": cells, "test": test, "vg": vg, "sd": sd,
            "greedy": {n: list(order[:n]) for n in range(cfg.N_MIN, cfg.N_MAX[city] + 1)}}


def per_map_mse(s, kmeans):
    """(maps, N) per-map MSE for greedy and k-means at every N."""
    K = N.covariance(s["cells"], s["vg"])
    extra = N.sensor_variance(s["vg"], s["sd"]**2)
    X = s["test"]["X"]
    n_vals = sorted(s["greedy"])
    out = {}
    for strat, nets in (("greedy", s["greedy"]), ("kmeans", kmeans)):
        out[strat] = np.column_stack(
            [N.map_mse(X, nets[n], N.ok_weights(K, nets[n], extra), s["sd"]**2) for n in n_vals])
    return np.array(n_vals), out


# ---------------------------------------------------------
# STATISTICS
# ---------------------------------------------------------

def power_law(n, a, b, c):
    return a * n**(-b) + c


def fit_curve(n, rmse, p0=None):
    p0 = p0 if p0 is not None else (rmse[0] * n[0]**0.5, 0.5, 0.5 * rmse[-1])
    try:
        p, _ = curve_fit(power_law, n, rmse, p0=p0, bounds=([0, 0, 0], [np.inf, 5, np.inf]),
                         maxfev=20000)
    except RuntimeError:
        return None
    return p


def n_star(p, threshold, step):
    """Smallest N with step * g(N) < threshold; inf if beyond N_GRID."""
    a, b, c = p
    g = a * b * N_GRID**(-b - 1) / power_law(N_GRID, a, b, c)
    hit = np.nonzero(step * g < threshold)[0]
    return float(N_GRID[hit[0]]) if len(hit) else float("inf")


def marginal_gain(p, n):
    a, b, c = p
    return float(a * b * n**(-b - 1) / power_law(n, a, b, c))


def kmeans_equivalent(p, target):
    a, b, c = p
    return float((a / (target - c))**(1 / b)) if target > c else float("inf")


def slope(n, imp, lo, hi):
    keep = (n >= lo) & (n <= hi)
    return float(np.polyfit(np.log(n[keep]), imp[keep], 1)[0])


def pct(x):
    x = np.asarray(x, float)
    x = x[np.isfinite(x)]
    return np.percentile(x, [2.5, 97.5]).tolist() if len(x) else [None, None]


def analyse(city, setting, s, kmeans):
    print(f"=== {city} / {setting}")
    n, mse = per_map_mse(s, kmeans)
    w, meta = s["test"]["w"], s["test"]["meta"]
    # bootstrap multiplicities (draw, map), same draws as Phase 5
    idx = ev5.bootstrap_index(meta, N_BOOT, [cfg.RANDOM_SEED, 5, len(city)])
    B = np.stack([np.bincount(i, minlength=len(w)) for i in idx]).astype(float) * w

    rm = {k: np.sqrt(w @ v) for k, v in mse.items()}                       # (N,)
    rm_b = {k: np.sqrt((B @ v) / B.sum(1, keepdims=True)) for k, v in mse.items()}  # (draw, N)
    imp, imp_b = 1 - rm["greedy"] / rm["kmeans"], 1 - rm_b["greedy"] / rm_b["kmeans"]
    ci = np.percentile(imp_b, [2.5, 97.5], axis=0)

    out = {"variogram_range_km": s["vg"]["range_m"] / 1000, "noise_sd": float(s["sd"]),
           "curve_fit": {}, "n_star": {}, "slopes": {}}
    fits = {}
    for strat in ("greedy", "kmeans"):
        p = fit_curve(n, rm[strat])
        fits[strat] = p
        resid = rm[strat] - power_law(n, *p)
        out["curve_fit"][strat] = {"a": p[0], "b": p[1], "c": p[2],
                                   "r2": float(1 - resid.var() / rm[strat].var()),
                                   "max_abs_resid": float(np.abs(resid).max())}
        boot_p = [fit_curve(n, r, p0=p) for r in rm_b[strat]]
        n_fail = sum(q is None for q in boot_p)
        res = {}
        for basis, step in (("per_sensor", 1.0), ("area_fair", STEP[city])):
            for t in THRESHOLDS:
                pt = n_star(p, t, step)
                bs = [n_star(q, t, step) for q in boot_p if q is not None]
                res[f"{basis}_{t:g}"] = {
                    "N_star": pt, "ci95": pct(bs),
                    "share_boot_beyond_grid": float(np.mean(np.isinf(bs))),
                    "beyond_sweep": bool(pt > cfg.N_MAX[city]),
                    "density_per_100km2": pt / AREA_KM2[city] * 100,
                    "density_ci95": [x / AREA_KM2[city] * 100 if x is not None else None for x in pct(bs)],
                    "spacing_km": float(np.sqrt(AREA_KM2[city] / pt))}
        res["boot_fit_failures"] = n_fail
        out["n_star"][strat] = res
        print(f"  {strat}: b = {p[1]:.2f}, N*(1%) = {res['per_sensor_0.01']['N_star']:.0f} "
              f"{res['per_sensor_0.01']['ci95']}, area-fair {res['area_fair_0.01']['N_star']:.0f}")

    for name, (lo, hi) in SLOPE_RANGES[city].items():
        b1 = slope(n, imp, lo, hi)
        bs = [slope(n, row, lo, hi) for row in imp_b]
        out["slopes"][name] = {"N_range": [lo, hi], "beta1": b1, "ci95": pct(bs),
                               "per_doubling_pp": 100 * b1 * np.log(2)}
        print(f"  slope {name}: {100 * b1:+.2f} pp per unit ln N {pct(100 * np.array(bs))}")

    out["ci_counts"] = {"above_zero": int((ci[0] > 0).sum()), "below_zero": int((ci[1] < 0).sum()),
                        "straddle": int(((ci[0] <= 0) & (ci[1] >= 0)).sum()), "total": len(n)}
    out["sensors_saved"] = {}
    for m in SAVED_AT[city]:
        j = int(np.nonzero(n == m)[0][0])
        eq = kmeans_equivalent(fits["kmeans"], rm["greedy"][j])
        out["sensors_saved"][str(m)] = {"saved": eq - m, "kmeans_equivalent_N": eq,
                                        "extrapolated": bool(eq > cfg.N_MAX[city])}
    out["marginal_gain_pct"] = {strat: {str(m): 100 * marginal_gain(fits[strat], m)
                                        for m in GAIN_AT[city]} for strat in fits}
    out["band_mean_improvement_descriptive"] = {}
    for lo, hi in BANDS[city]:
        keep = (n >= lo) & (n <= hi)
        out["band_mean_improvement_descriptive"][f"N{lo}-{hi}"] = [
            float(imp[keep].mean()), *pct(imp_b[:, keep].mean(1))]

    curves = pd.DataFrame({"N": n, "rmse_greedy": rm["greedy"], "rmse_kmeans": rm["kmeans"],
                           "fit_greedy": power_law(n, *fits["greedy"]),
                           "fit_kmeans": power_law(n, *fits["kmeans"]),
                           "improvement": imp, "ci_low": ci[0], "ci_high": ci[1]})
    curves.to_csv(OUT_DATA / f"{city}_{setting}_curves{K_TAG}.csv", index=False)
    return out, curves


def compare(res):
    """Melbourne minus Singapore N* on the area-fair basis, in sensors per 100 km2."""
    out = {}
    for setting in res["singapore"]:
        out[setting] = {}
        for strat in ("greedy", "kmeans"):
            sg = res["singapore"][setting]["n_star"][strat][f"area_fair_{HEADLINE_THRESHOLD:g}"]
            mel = res["melbourne"][setting]["n_star"][strat][f"area_fair_{HEADLINE_THRESHOLD:g}"]
            out[setting][strat] = {"density_singapore": sg["density_per_100km2"],
                                   "density_melbourne": mel["density_per_100km2"],
                                   "density_ci_singapore": sg["density_ci95"],
                                   "density_ci_melbourne": mel["density_ci95"]}
    return out


def plot(curves, scores):
    fig, axes = plt.subplots(2, 2, figsize=(12, 8))
    for col, city in enumerate(cfg.ALL_CITIES):
        ax = axes[0, col]
        c = curves[(city, "original")]
        for strat, colour in (("greedy", "#c0392b"), ("kmeans", "#2c3e50")):
            ax.plot(c["N"], c[f"rmse_{strat}"], ".", color=colour, ms=3, label=f"{strat} (test)")
            ax.plot(c["N"], c[f"fit_{strat}"], "-", color=colour, lw=1, label=f"{strat} fit")
        sc = scores[city]
        for strat, style in (("qr", "--"), ("random_mean", ":")):
            q = sc[(sc["strategy"] == strat) & (sc["noise"] == HEADLINE)].sort_values("N")
            ax.plot(q["N"], q["test_rmse"], style, color="grey", lw=1, label=strat)
        ax.set_ylim(0, 1.3 * c["rmse_kmeans"].max())
        ax.set_title(f"{city}: test RMSE vs N (original design, f = 0.25)")
        ax.set_xlabel("number of sensors N")
        ax.set_ylabel("RMSE (ug/m3)")
        ax.legend(fontsize=7)

        ax = axes[1, col]
        for setting, colour in (("original", "#c0392b"), ("L0", "#2471a3")):
            c = curves[(city, setting)]
            ax.plot(c["N"], 100 * c["improvement"], color=colour, label=setting)
            ax.fill_between(c["N"], 100 * c["ci_low"], 100 * c["ci_high"], color=colour, alpha=0.15)
            b = np.polyfit(np.log(c["N"]), c["improvement"], 1)
            ax.plot(c["N"], 100 * np.polyval(b, np.log(c["N"])), "--", color=colour, lw=1)
        ax.axhline(0, color="k", lw=0.8)
        ax.set_title(f"{city}: greedy improvement over k-means (95% CI, ln N fit)")
        ax.set_xlabel("number of sensors N")
        ax.set_ylabel("improvement (%)")
        ax.legend(fontsize=8)
    fig.tight_layout()
    OUT_FIG.mkdir(parents=True, exist_ok=True)
    fig.savefig(OUT_FIG / f"budget_sweep{K_TAG}.png", dpi=130)
    plt.close(fig)


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="Phase 7 budget sweep.")
    ap.add_argument("--k", type=float, default=None,
                    help="Phase 8: K (m2/s) of the simulations to use")
    k = ap.parse_args().k
    K_TAG = "" if k is None else f"_K{k:g}"
    OUT_DATA.mkdir(parents=True, exist_ok=True)
    results, curves, scores = {}, {}, {}
    for city in cfg.ALL_CITIES:
        nets = pd.read_csv(cfg.processed_dir(city) / f"{city}_networks_trainall.csv")
        km = nets[nets["strategy"] == "kmeans"]
        kmeans = {n: g.sort_values("rank")["cell_index"].tolist() for n, g in km.groupby("N")}
        scores[city] = pd.read_csv(ROOT / "data" / "processed" / "phase5" / city
                                   / f"{city}_test_scores_all2025_trainall{K_TAG}.csv")
        orig = setting_original(city)
        results[city] = {}
        for setting, s in (("original", orig), ("L0", setting_L0(city, orig["cells"]))):
            results[city][setting], curves[(city, setting)] = analyse(city, setting, s, kmeans)
    results["city_comparison_area_fair"] = compare(results)
    results["K_m2_s"] = k
    with open(OUT_DATA / f"phase7_budget_sweep{K_TAG}.json", "w") as f:
        json.dump(results, f, indent=2, default=float)
    plot(curves, scores)
    print(json.dumps(results["city_comparison_area_fair"], indent=2, default=float))

# make_excel_workbook.py
"""
Poster graphs as an Excel workbook: each sheet holds the data behind one
poster figure, next to a native Excel chart drawn from that data, so the
charts can be restyled or edited in Excel / PowerPoint.

Same data, colours and wording as make_poster_figures.py:
    1  plume maps         -> heat-map grid (cell colour scale), one per regime
    2  sensor networks    -> scatter charts of sensor positions (km)
    3  emission predictability (key result) -> column charts with 95% CI bars
    4  sensor-count curves -> line charts (CI as dashed lines)
    5  main test           -> line charts per city
    6  spreading-rate check (Phase 8) -> column charts with 95% CI bars

Output: Graphs/Poster picks/Excel/Poster charts.xlsx

Usage:
    python make_excel_workbook.py
"""

import json
from pathlib import Path

import numpy as np
import pandas as pd
import xarray as xr
import xlsxwriter
from xlsxwriter.utility import xl_range_abs

ROOT = Path(__file__).resolve().parents[2]
P3 = ROOT / "data" / "processed" / "phase3"
P4 = ROOT / "data" / "processed" / "phase4"
P5 = ROOT / "data" / "processed" / "phase5"
P7 = ROOT / "data" / "processed" / "phase7"
OUT = ROOT / "Graphs" / "Poster picks" / "Excel"

GREEN, TEAL, GREY, INK, MUTED, CELL = "#13703F", "#1F8BB8", "#8A8F8C", "#1D2B22", "#5C6B62", "#DFE6E1"
K_COL = {200: "#7FBF95", 1000: GREEN, 8000: "#08391F"}
CITIES = ("singapore", "melbourne")
CITY_NAME = {"singapore": "Singapore", "melbourne": "Melbourne"}
SHORT = {"singapore": "SG", "melbourne": "MEL"}
HEADLINE_N = {"singapore": 22, "melbourne": 8}
HEADLINE = "f0.25"
REGIME_NAME = {"SIN1": "Southwest monsoon", "SIN2": "Inter-monsoon", "SIN3": "Northeast monsoon",
               "MEL1": "Light south-easterlies", "MEL2": "Northerlies (before a front)",
               "MEL3": "Westerlies (after a front)"}
LEVELS = ["L0", "L1", "L2_setA", "L2_setB", "L3_setA", "L3_setB", "L4_setA", "L4_setB", "L5"]
LEVEL_LABEL = ["Known exactly", "Noisy output", "10% fixed sources (A)", "10% fixed sources (B)",
               "30% fixed sources (A)", "30% fixed sources (B)", "30% fixed + noise (A)",
               "30% fixed + noise (B)", "Randomly moving"]
STRATEGY = [("greedy", "Weather-informed", GREEN, "solid"), ("kmeans", "Evenly spread", TEAL, "solid"),
            ("qr", "QR pivoting", GREY, "dash"), ("random_mean", "Random", GREY, "round_dot")]


class Book:
    def __init__(self, path):
        self.wb = xlsxwriter.Workbook(path, {"nan_inf_to_errors": True})
        wb = self.wb
        self.title = wb.add_format({"bold": True, "font_size": 14, "font_color": INK})
        self.note = wb.add_format({"italic": True, "font_color": MUTED})
        self.head = wb.add_format({"bold": True, "bg_color": CELL, "font_color": INK,
                                   "text_wrap": True, "valign": "top", "border": 1, "border_color": "#C5CFC8"})
        self.num = wb.add_format({"num_format": "0.0"})
        self.num3 = wb.add_format({"num_format": "0.000"})
        self.txt = wb.add_format({})
        self.maphead = wb.add_format({"bold": True, "font_color": INK, "align": "center"})
        self.mapnote = wb.add_format({"italic": True, "font_color": MUTED, "align": "center"})
        self.hidden = wb.add_format({"num_format": ";;;"})     # value kept, not shown: colour only

    def sheet(self, name, title, note):
        ws = self.wb.add_worksheet(name)
        ws.write(0, 0, title, self.title)
        ws.write(1, 0, note, self.note)
        return ws

    def table(self, ws, row, col, df, fmt=None):
        """Write df with a header row at (row, col); returns {column: (first, last) cell refs}."""
        for j, c in enumerate(df.columns):
            ws.write(row, col + j, c, self.head)
            for i, v in enumerate(df[c]):
                if isinstance(v, str):
                    ws.write_string(row + 1 + i, col + j, v)
                elif v is None or (isinstance(v, float) and np.isnan(v)):
                    ws.write_blank(row + 1 + i, col + j, None)
                else:
                    ws.write_number(row + 1 + i, col + j, float(v), fmt or self.num)
            ws.set_column(col + j, col + j, max(11, min(26, len(c) * 0.9)))
        return {c: (row + 1, col + j, row + len(df), col + j) for j, c in enumerate(df.columns)}

    def chart(self, kind, subtype=None):
        ch = self.wb.add_chart({"type": kind, **({"subtype": subtype} if subtype else {})})
        ch.set_chartarea({"border": {"none": True}})
        ch.set_plotarea({"border": {"none": True}})
        ch.set_legend({"position": "top", "font": {"size": 10, "color": INK}})
        return ch

    def ref(self, ws, r):
        return [ws.name, *r]


def page(ws, r0, c0, r1, c1):
    """Print the chart area landscape on one page (also used to preview the charts)."""
    ws.set_landscape()
    ws.fit_to_pages(1, 1)
    ws.print_area(r0, c0, r1, c1)
    ws.hide_gridlines(2)


def axis(title, **kw):
    base = {"name": title, "name_font": {"size": 10, "bold": False, "color": INK},
            "num_font": {"size": 9, "color": MUTED}, "line": {"color": MUTED},
            "major_gridlines": {"visible": True, "line": {"color": "#E8ECE9"}}}
    base.update(kw)
    return base


def ci_bars(book, ws, r_val, r_lo, r_hi, df, val, lo, hi, row, col_minus, col_plus, colour):
    """Custom error bars need positive distances; write them in helper columns."""
    ws.write(row, col_minus, f"{val}: minus", book.head)
    ws.write(row, col_plus, f"{val}: plus", book.head)
    for i in range(len(df)):
        ws.write_number(row + 1 + i, col_minus, float(df[val].iloc[i] - df[lo].iloc[i]), book.num)
        ws.write_number(row + 1 + i, col_plus, float(df[hi].iloc[i] - df[val].iloc[i]), book.num)
    n = len(df)
    return {"type": "custom", "direction": "both", "end_style": 1,
            "minus_values": f"='{ws.name}'!{xl_range_abs(row + 1, col_minus, row + n, col_minus)}",
            "plus_values": f"='{ws.name}'!{xl_range_abs(row + 1, col_plus, row + n, col_plus)}",
            "line": {"color": colour, "width": 1.25}}


# ---------------------------------------------------------
# 1. PLUME MAPS (heat-map grids)
# ---------------------------------------------------------

def sheet_plumes(book, city):
    ds = xr.open_dataset(P3 / city / f"{city}_scenarios.nc")
    rep = np.nonzero(ds["selection"].values == "representative")[0]
    x, y = ds["cell_x"].values, ds["cell_y"].values
    ix = np.rint((x - x.min()) / 2000).astype(int)
    iy = np.rint((y.max() - y) / 2000).astype(int)          # north at the top
    nx, ny = ix.max() + 1, iy.max() + 1
    ws = book.sheet(f"1 Plumes {SHORT[city]}",
                    f"{CITY_NAME[city]}: simulated daily PM2.5 from local emissions, typical day of each weather pattern",
                    "Each square is one 2 km grid cell (north at the top). Colour: white = low, dark green = high; "
                    "each map has its own colour scale. Values in µg/m³. Raw data in the table on the right.")
    cw = 1.1 if city == "melbourne" else 1.8
    top, left, gap = 4, 0, 2
    long = pd.DataFrame({"cell_id": ds["cell_id"].values, "x_km": x / 1000, "y_km": y / 1000})
    for m, d in enumerate(rep):
        v = ds["local_pm25"].isel(day=d, member=0).mean("hour").values
        r = str(ds["regime"].values[d])
        day = pd.Timestamp(ds["date"].values[d]).strftime("%-d %b %Y")
        c0 = left + m * (nx + gap)
        ws.merge_range(top - 1, c0, top - 1, c0 + nx - 1, f"{REGIME_NAME[r]}, {day}", book.maphead)
        for k in range(len(v)):
            ws.write_number(top + iy[k], c0 + ix[k], round(float(v[k]), 3), book.hidden)
        ws.conditional_format(top, c0, top + ny - 1, c0 + nx - 1,
                              {"type": "2_color_scale", "min_color": "#F7FCF0", "max_color": GREEN})
        ws.set_column(c0, c0 + nx - 1, cw)
        ws.merge_range(top + ny + 1, c0, top + ny + 1, c0 + nx - 1,
                       f"Palest = {v.min():.2f}, darkest = {v.max():.2f} µg/m³", book.mapnote)
        long[f"{REGIME_NAME[r]} ({day})"] = np.round(v, 4)
    for rr in range(top, top + ny):
        ws.set_row(rr, cw * 7.5)
    page(ws, 0, 0, top + ny + 2, len(rep) * (nx + gap))
    c_tab = left + len(rep) * (nx + gap) + 1
    book.table(ws, top - 1, c_tab, long, book.num3)


# ---------------------------------------------------------
# 2. SENSOR NETWORKS (scatter)
# ---------------------------------------------------------

def sheet_networks(book, city):
    ds = xr.open_dataset(P3 / city / f"{city}_scenarios.nc")
    x, y = ds["cell_x"].values / 1000, ds["cell_y"].values / 1000
    x0, y0 = x.min(), y.min()
    nets = pd.read_csv(P4 / city / f"{city}_networks_trainall.csv")
    n = HEADLINE_N[city]
    panels = [("greedy", HEADLINE, "Weather-informed", GREEN, "circle"),
              ("kmeans", "any", "Evenly spread", TEAL, "square")]
    if (nets["strategy"] == "existing").any():
        panels.append(("existing", "any", "Existing EPA stations", INK, "triangle"))
    ws = book.sheet(f"2 Networks {SHORT[city]}",
                    f"{CITY_NAME[city]}: where each strategy places {n} sensors (the size of the city's real network)",
                    "Coordinates in km from the south-west corner of the study area. Grey squares: candidate 2 km cells.")
    cand = pd.DataFrame({"Candidate x (km)": x - x0, "Candidate y (km)": y - y0})
    rc = book.table(ws, 3, 0, cand)
    col = 3
    w_km, h_km = x.max() - x0, y.max() - y0
    width = 420
    height = int(width * h_km / w_km) + 70
    for p, (strat, noise, title, colour, marker) in enumerate(panels):
        sub = nets[(nets["strategy"] == strat) & (nets["noise"] == noise)]
        sub = sub[sub["N"] == (sub["N"].max() if strat == "existing" else n)]
        i = sub["cell_index"].to_numpy()
        df = pd.DataFrame({f"{title} x (km)": x[i] - x0, f"{title} y (km)": y[i] - y0})
        r = book.table(ws, 3, col, df)
        ch = book.chart("scatter")
        ch.add_series({"name": "Candidate cells", "categories": book.ref(ws, rc["Candidate x (km)"]),
                       "values": book.ref(ws, rc["Candidate y (km)"]),
                       "marker": {"type": "square", "size": 4 if city == "melbourne" else 7,
                                  "fill": {"color": CELL}, "border": {"none": True}}})
        ch.add_series({"name": f"{title} ({len(sub)} sensors)", "categories": book.ref(ws, r[df.columns[0]]),
                       "values": book.ref(ws, r[df.columns[1]]),
                       "marker": {"type": marker, "size": 9, "fill": {"color": colour},
                                  "border": {"color": colour}}})
        ch.set_title({"name": f"{title}: {len(sub)} sensors", "name_font": {"size": 12, "color": INK}})
        ch.set_x_axis({"min": -2, "max": float(np.ceil(w_km) + 2), "visible": False,
                       "major_gridlines": {"visible": False}})
        ch.set_y_axis({"min": -2, "max": float(np.ceil(h_km) + 2), "visible": False,
                       "major_gridlines": {"visible": False}})
        ch.set_legend({"none": True})
        ch.set_size({"width": width, "height": height})
        ws.insert_chart(3, 10 + p * 7, ch)
        col += 2
    page(ws, 0, 9, 3 + height // 20 + 3, 10 + len(panels) * 7)


# ---------------------------------------------------------
# 3 + 6. COLUMN CHARTS WITH CI BARS
# ---------------------------------------------------------

def column_chart(book, ws, row, title, series, cats_ref, y_min, y_max):
    ch = book.chart("column")
    for s in series:
        ch.add_series({"name": s["name"], "categories": cats_ref, "values": s["values"],
                       "fill": {"color": s["colour"]}, "border": {"none": True},
                       "y_error_bars": s["err"], "gap": 60, "overlap": -5})
    ch.set_title({"name": title, "name_font": {"size": 12, "color": INK}})
    ch.set_x_axis(axis("How predictable the pollution sources are (most → least predictable)",
                       num_font={"size": 9, "color": INK}, label_position="low",
                       major_gridlines={"visible": False}))
    ch.set_y_axis(axis("Accuracy gain (%)", min=y_min, max=y_max))
    ch.set_size({"width": 900, "height": 380})
    return ch


def sheet_predictability(book):
    res = json.load(open(P5 / "phase5_emission_predictability.json"))
    ws = book.sheet("3 Predictability",
                    "Weather-informed placement helps when pollution sources are predictable",
                    "Accuracy gain over evenly spread sensors (%). Error bars: 95% confidence intervals. "
                    "A and B: two random sets of source locations.")
    row = 3
    for ns, nm, title in [(22, 8, "Each city's real network size"), (22, 22, "Same number of sensors (22 each)"),
                          (22, 88, "Same sensor density")]:
        df = pd.DataFrame({"Pollution sources": LEVEL_LABEL})
        for city, n in (("singapore", ns), ("melbourne", nm)):
            v = np.array([res[city][k]["improvement"][str(n)] for k in LEVELS]) * 100
            lab = f"{CITY_NAME[city]} ({n} sensors)"
            df[lab], df[f"{lab} low"], df[f"{lab} high"] = v[:, 0], v[:, 1], v[:, 2]
        ws.write(row - 1, 0, title, book.head)
        r = book.table(ws, row, 0, df)
        series = []
        for j, (city, n) in enumerate((("singapore", ns), ("melbourne", nm))):
            lab = f"{CITY_NAME[city]} ({n} sensors)"
            err = ci_bars(book, ws, None, None, None, df, lab, f"{lab} low", f"{lab} high",
                          row, 7 + 2 * j, 8 + 2 * j, INK)
            series.append({"name": lab, "values": book.ref(ws, r[lab]),
                           "colour": GREEN if city == "singapore" else TEAL, "err": err})
        ch = column_chart(book, ws, row, title, series, book.ref(ws, r["Pollution sources"]), -10, 65)
        ws.insert_chart(row - 1, 12, ch)
        row += 21
    page(ws, 0, 12, row, 26)


def sheet_k(book):
    ks = [(200, "_K200", "Slow spreading (200 m²/s)"), (1000, "", "Main analysis (1,000 m²/s)"),
          (8000, "_K8000", "Fast spreading (8,000 m²/s)")]
    res = {k: json.load(open(P5 / f"phase5_emission_predictability{t}.json")) for k, t, _ in ks}
    ws = book.sheet("6 Spreading rate",
                    "Does the result depend on how fast pollution spreads?",
                    "Accuracy gain of weather-informed over evenly spread sensors (%) at each city's real network "
                    "size, at three spreading rates K. Error bars: 95% confidence intervals.")
    row = 3
    for city in CITIES:
        n = HEADLINE_N[city]
        df = pd.DataFrame({"Pollution sources": LEVEL_LABEL})
        for k, _, lab in ks:
            v = np.array([res[k][city][lv]["improvement"][str(n)] for lv in LEVELS]) * 100
            df[lab], df[f"{lab} low"], df[f"{lab} high"] = v[:, 0], v[:, 1], v[:, 2]
        title = f"{CITY_NAME[city]} ({n} sensors, its real network size)"
        ws.write(row - 1, 0, title, book.head)
        r = book.table(ws, row, 0, df)
        series = []
        for j, (k, _, lab) in enumerate(ks):
            err = ci_bars(book, ws, None, None, None, df, lab, f"{lab} low", f"{lab} high",
                          row, 11 + 2 * j, 12 + 2 * j, MUTED)
            series.append({"name": lab, "values": book.ref(ws, r[lab]), "colour": K_COL[k], "err": err})
        ch = column_chart(book, ws, row, title, series, book.ref(ws, r["Pollution sources"]), -10, 45)
        ws.insert_chart(row - 1, 18, ch)
        row += 21
    page(ws, 0, 18, row, 32)


# ---------------------------------------------------------
# 4 + 5. LINE CHARTS VS NUMBER OF SENSORS
# ---------------------------------------------------------

def line(ch, book, ws, xr_, yr, name, colour, dash="solid", width=2.25, marker=None):
    s = {"name": name, "categories": book.ref(ws, xr_), "values": book.ref(ws, yr),
         "line": {"color": colour, "width": width, "dash_type": dash}}
    s["marker"] = marker or {"type": "none"}
    if marker:
        s["line"] = {"none": True}
    ch.add_series(s)


def xy_chart(book, title, x_title, y_title, n_max, y_min=None, y_max=None):
    ch = book.chart("scatter", "straight")
    ch.set_title({"name": title, "name_font": {"size": 12, "color": INK}})
    ch.set_x_axis(axis(x_title, min=0, max=n_max, label_position="low", major_gridlines={"visible": False}))
    ch.set_y_axis(axis(y_title, **({"min": y_min} if y_min is not None else {}),
                       **({"max": y_max} if y_max is not None else {})))
    ch.set_size({"width": 620, "height": 360})
    return ch


def strategy_table(city):
    sc = pd.read_csv(P5 / city / f"{city}_test_scores_all2025_trainall.csv")
    sc = sc[sc["noise"] == HEADLINE]
    t = sc.pivot_table(index="N", columns="strategy", values="test_rmse").reset_index()
    return t


def sheet_sensor_count(book):
    ws = book.sheet("4 Sensor count",
                    "How many sensors? Map error and the gain from weather-informed placement as sensors are added",
                    "Top: map error (RMSE, µg/m³) with fitted curves. Bottom: accuracy gain over even spacing (%), "
                    "dashed = 95% confidence interval. Real network size: Singapore 22, Melbourne 8.")
    col = 0
    for p, city in enumerate(CITIES):
        c = pd.read_csv(P7 / f"{city}_original_curves.csv")
        l0 = pd.read_csv(P7 / f"{city}_L0_curves.csv")
        st = strategy_table(city)
        st = st[["N"] + [s for s in ("qr", "random_mean") if s in st]]
        df = pd.DataFrame({"Number of sensors": c["N"],
                           "Weather-informed error": c["rmse_greedy"], "Weather-informed fitted": c["fit_greedy"],
                           "Evenly spread error": c["rmse_kmeans"], "Evenly spread fitted": c["fit_kmeans"]})
        df = df.merge(st.rename(columns={"N": "Number of sensors", "qr": "QR pivoting error",
                                         "random_mean": "Random error"}), how="left")
        df["Gain, sources known (%)"] = 100 * l0["improvement"].values
        df["Gain, sources known: low"] = 100 * l0["ci_low"].values
        df["Gain, sources known: high"] = 100 * l0["ci_high"].values
        df["Gain, random hotspots (%)"] = 100 * c["improvement"].values
        df["Gain, random hotspots: low"] = 100 * c["ci_low"].values
        df["Gain, random hotspots: high"] = 100 * c["ci_high"].values
        ws.write(2, col, CITY_NAME[city], book.head)
        r = book.table(ws, 3, col, df, book.num3)
        X = r["Number of sensors"]
        n_max = int(df["Number of sensors"].max())

        ch = xy_chart(book, f"{CITY_NAME[city]}: map error falls as sensors are added",
                      "Number of sensors", "Map error, RMSE (µg/m³)", n_max, 0)
        for key, name, colour in (("Weather-informed", "Weather-informed", GREEN), ("Evenly spread", "Evenly spread", TEAL)):
            line(ch, book, ws, X, r[f"{key} error"], f"{name} (measured)", colour,
                 marker={"type": "circle", "size": 4, "fill": {"color": colour}, "border": {"none": True}})
            line(ch, book, ws, X, r[f"{key} fitted"], f"{name} (fitted curve)", colour)
        for key, name, dash in (("QR pivoting error", "QR pivoting", "dash"), ("Random error", "Random", "round_dot")):
            if key in r:
                line(ch, book, ws, X, r[key], name, GREY, dash, 1.5,
                     marker={"type": "circle", "size": 4, "fill": {"color": GREY}, "border": {"none": True}})
        ws.insert_chart(3, 31 + p * 10, ch)

        ch = xy_chart(book, f"{CITY_NAME[city]}: gain from weather-informed placement",
                      "Number of sensors", "Accuracy gain over even spacing (%)", n_max)
        for key, name, colour in (("sources known", "Emission sources known", GREEN),
