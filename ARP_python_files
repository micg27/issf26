# run_phase2.py
"""
Run Phase 2 end to end.

The pipeline deliberately stops after script 05 the first time, because
choosing k requires you to LOOK at the diagnostics. Once final_k is set in
config.py for every city, re-run and it continues through to Phase 3 data.

Usage:
    python run_phase2.py                  # stages 02-11, all cities
    python run_phase2.py --from 04        # resume from stage 04
    python run_phase2.py --only 07        # single stage
    python run_phase2.py --city melbourne
"""

import argparse
import subprocess
import sys
from pathlib import Path

import config


HERE = Path(__file__).resolve().parent


STAGES = [
    ("02", "02_preprocess_hourly.py", True),
    ("03", "03_qc_hourly.py", True),
    ("04", "04_build_daily_features.py", False),
    ("05", "05_cluster_sweep.py", False),
    ("06", "06_fit_final_clusters.py", False),
    ("07", "07_characterize_regimes.py", False),
    # 09 runs BEFORE 08: day sampling is stratified by split, so the
    # split assignment has to exist first.
    ("09", "09_split_train_test.py", False),
    ("08", "08_select_days.py", False),
    ("10", "10_build_phase3_days.py", False),
    ("11", "11_extract_phase3_data.py", False),
]


def run(script, city_args):

    command = [sys.executable, str(HERE / script)] + city_args

    print(f"\n>>> {' '.join(command)}")

    result = subprocess.run(command)

    if result.returncode != 0:
        raise SystemExit(
            f"\nStage {script} failed with code {result.returncode}. "
            f"Fix it before continuing."
        )


def main():

    parser = argparse.ArgumentParser(description="Run the Phase 2 pipeline.")

    parser.add_argument("--city", choices=config.ALL_CITIES)
    parser.add_argument("--from", dest="start", default="02")
    parser.add_argument("--only", default=None)

    args = parser.parse_args()

    city_args = ["--city", args.city] if args.city else ["--all"]

    cities = [args.city] if args.city else config.ALL_CITIES

    if args.only:
        stages = [s for s in STAGES if s[0] == args.only]
        if not stages:
            raise SystemExit(f"Unknown stage: {args.only}")
    else:
        indices = [i for i, s in enumerate(STAGES) if s[0] == args.start]
        if not indices:
            raise SystemExit(f"Unknown stage: {args.start}")
        stages = STAGES[indices[0]:]

    for code, script, _ in stages:

        # Gate: do not proceed past the sweep until k is chosen.
        if code == "06":

            unset = [
                city for city in cities
                if config.CITIES[city]["final_k"] is None
            ]

            if unset:
                print("\n" + "=" * 68)
                print("STOPPING BEFORE STAGE 06")
                print("=" * 68)
                print(
                    f"\nfinal_k is not set for: {', '.join(unset)}"
                )
                print(
                    "\nInspect outputs/meteorology/<city>/clustering/"
                    "cluster_validity.png"
                )
                print(
                    "and the candidate_k*.csv files, choose k, set it in "
                    "config.py,"
                )
                print("then re-run:  python run_phase2.py --from 06")
                return

        run(script, city_args)

    print("\n" + "=" * 68)
    print("PHASE 2 COMPLETE")
    print("=" * 68)
    print(
        "\nPhase 3 inputs are in "
        "data/processed/meteorology/<city>/phase3_weather/"
    )


if __name__ == "__main__":
    main()

# 07_characterize_regimes.py
"""
Describe each regime physically and compute the frequency weights
w_k = n_k / N that Phase 3 uses to weight scenarios.

Outputs:
  <city>_regime_summary.csv            per-regime stats including w_k
  <city>_regime_monthly_frequency.csv  seasonality check
  <city>_regime_weights.json           w_k in a form Phase 3 can import
  figures: diurnal wind vectors per regime, monthly occurrence

The diurnal figure is the important one for interpretation: it shows how
the wind vector rotates through the day in each regime, which is what
distinguishes a sea-breeze regime from a synoptically forced one.

Usage:
    python 07_characterize_regimes.py --all
"""

import json

import matplotlib

matplotlib.use("Agg")

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

import config
import utils


BLOCK_LABELS = {
    1: "00-06",
    2: "06-12",
    3: "12-18",
    4: "18-24",
}


def characterize(city):

    utils.banner(f"REGIME CHARACTERIZATION: {city}")

    base = config.processed_dir(city)
    out = config.output_dir(city, "regimes")

    daily = pd.read_csv(
        base / f"{city}_regimes.csv",
        parse_dates=["date"],
    )

    # -----------------------------------------------------
    # DERIVED QUANTITIES
    # -----------------------------------------------------

    for block in range(1, config.N_BLOCKS + 1):
        daily[f"speed{block}"] = np.hypot(
            daily[f"u{block}"], daily[f"v{block}"]
        )

    speed_cols = [
        f"speed{b}" for b in range(1, config.N_BLOCKS + 1)
    ]

    daily["mean_wind_speed"] = daily[speed_cols].mean(axis=1)

    # Vector mean speed: the magnitude of the daily-mean wind vector.
    # Much smaller than mean_wind_speed when the wind reverses during the
    # day, so the ratio is a direct measure of diurnal reversal, which is
    # exactly the sea-breeze signal you care about for Singapore.
    u_cols = [f"u{b}" for b in range(1, config.N_BLOCKS + 1)]
    v_cols = [f"v{b}" for b in range(1, config.N_BLOCKS + 1)]

    daily["u_daily"] = daily[u_cols].mean(axis=1)
    daily["v_daily"] = daily[v_cols].mean(axis=1)

    daily["vector_mean_speed"] = np.hypot(
        daily["u_daily"], daily["v_daily"]
    )

    daily["steadiness"] = (
        daily["vector_mean_speed"]
        / daily["mean_wind_speed"].replace(0, np.nan)
    )

    # -----------------------------------------------------
    # SUMMARY
    # -----------------------------------------------------

    agg = {
        "n_days": ("date", "count"),
        "mean_wind_speed": ("mean_wind_speed", "mean"),
        "vector_mean_speed": ("vector_mean_speed", "mean"),
        "steadiness": ("steadiness", "mean"),
        "mean_pblh": ("pblh_mean", "mean"),
        "std_pblh": ("pblh_mean", "std"),
    }

    for block in range(1, config.N_BLOCKS + 1):
        agg[f"u{block}"] = (f"u{block}", "mean")
        agg[f"v{block}"] = (f"v{block}", "mean")

    summary = daily.groupby("regime").agg(**agg).reset_index()

    summary["w_k"] = summary["n_days"] / len(daily)

    summary = summary.sort_values("regime").reset_index(drop=True)

    summary.to_csv(
        base / f"{city}_regime_summary.csv", index=False
    )

    # -----------------------------------------------------
    # WEIGHTS FOR PHASE 3
    # -----------------------------------------------------

    weights = dict(
        zip(summary["regime"], summary["w_k"].round(6))
    )

    total = float(sum(weights.values()))

    if abs(total - 1.0) > 1e-6:
        print(f"  WARNING: weights sum to {total}, not 1.")

    with open(base / f"{city}_regime_weights.json", "w") as f:
        json.dump(
            {
                "city": city,
                "n_days": int(len(daily)),
                "weights": weights,
            },
            f,
            indent=2,
        )

    # -----------------------------------------------------
    # MONTHLY OCCURRENCE
    # -----------------------------------------------------

    daily["month"] = daily["date"].dt.month

    monthly = pd.crosstab(
        daily["month"], daily["regime"], normalize="index"
    )

    monthly.to_csv(
        base / f"{city}_regime_monthly_frequency.csv"
    )

    # -----------------------------------------------------
    # FIGURE 1: DIURNAL WIND VECTORS BY REGIME
    # -----------------------------------------------------

    regimes = sorted(daily["regime"].unique())

    fig, axes = plt.subplots(
        1, len(regimes),
        figsize=(3.2 * len(regimes), 3.4),
        squeeze=False,
    )

    limit = float(
        np.nanmax(
            np.abs(summary[[f"u{b}" for b in range(1, 5)]
                           + [f"v{b}" for b in range(1, 5)]].values)
        )
    ) * 1.3 + 0.5

    for ax, regime in zip(axes[0], regimes):

        row = summary[summary["regime"] == regime].iloc[0]

        for block in range(1, config.N_BLOCKS + 1):
            ax.arrow(
                0, 0,
                row[f"u{block}"], row[f"v{block}"],
                head_width=limit * 0.05,
                length_includes_head=True,
                alpha=0.85,
            )
            ax.annotate(
                BLOCK_LABELS[block],
                (row[f"u{block}"], row[f"v{block}"]),
                fontsize=7,
            )

        ax.axhline(0, linewidth=0.5, color="grey")
        ax.axvline(0, linewidth=0.5, color="grey")
        ax.set_xlim(-limit, limit)
        ax.set_ylim(-limit, limit)
        ax.set_aspect("equal")
        ax.set_title(
            f"{regime}\nw={row['w_k']:.2f}, n={int(row['n_days'])}",
            fontsize=9,
        )
        ax.set_xlabel("u (m/s)", fontsize=8)

    axes[0][0].set_ylabel("v (m/s)", fontsize=8)

    fig.suptitle(
        f"{city.title()}: mean wind vector by 6-hour block", fontsize=11
    )
    fig.tight_layout()
    fig.savefig(out / "regime_diurnal_wind.png", dpi=200)
    plt.close(fig)

    # -----------------------------------------------------
    # FIGURE 2: MONTHLY OCCURRENCE
    # -----------------------------------------------------

    fig, ax = plt.subplots(figsize=(8, 4))

    monthly.plot(kind="bar", stacked=True, ax=ax, width=0.85)

    ax.set_xlabel("Month")
    ax.set_ylabel("Proportion of days")
    ax.set_title(f"{city.title()}: regime occurrence by month")
    ax.legend(title="Regime", bbox_to_anchor=(1.02, 1), loc="upper left")
    fig.tight_layout()
    fig.savefig(out / "regime_monthly_frequency.png", dpi=200)
    plt.close(fig)

    # -----------------------------------------------------
    # REPORT
    # -----------------------------------------------------

    display = summary[
        [
            "regime", "n_days", "w_k", "mean_wind_speed",
            "vector_mean_speed", "steadiness", "mean_pblh",
        ]
    ]

    print("\n" + display.round(3).to_string(index=False))

    print("\n  Monthly proportions:")
    print(monthly.round(3).to_string())

    print(
        "\n  Interpretation check: a regime with low steadiness (well "
        "under ~0.5)"
    )
    print(
        "  has a wind that reverses during the day, i.e. a sea-breeze "
        "type. A"
    )
    print(
        "  regime with steadiness near 1 is synoptically forced. Confirm "
        "the"
    )
    print(
        "  monthly table matches known climatology before continuing."
    )

    print(f"\n  Saved outputs to {base} and figures to {out}")


def main():

    cities = utils.parse_cities("Characterize meteorological regimes.")

    for city in cities:
        characterize(city)


if __name__ == "__main__":
    main()

# 08_select_days.py
"""
Pick the days that Phase 3 will actually simulate.

Two selections:
  1. Representative day per regime: the day closest to its cluster centroid
     in standardized space. Useful for figures and for a deterministic
     "typical case" run.
  2. A random sample of N_SAMPLE_PER_REGIME days per regime, which gives
     Phase 3 within-regime variability rather than a single point estimate.

RUNS AFTER 09, not before. Sampling is stratified by BOTH regime and split,
so every regime is guaranteed to contribute train AND test days. Sampling
independently of the split (as the original scripts did) can leave a regime
with zero held-out days purely by chance, which would silently break the
Phase 5 evaluation for that regime.

FIX vs your original: the cluster centroid is matched using the
cluster_index column saved by 06, not by alphabetically sorting regime
label strings.

Usage:
    python 08_select_days.py --all
"""

import json

import numpy as np
import pandas as pd

import config
import utils


def select(city):

    utils.banner(f"DAY SELECTION: {city}")

    base = config.processed_dir(city)

    split_path = base / f"{city}_regimes_split.csv"

    if not split_path.exists():
        raise FileNotFoundError(
            f"{split_path} not found.\n"
            f"Run 09_split_train_test.py BEFORE 08, so that sampling can "
            f"be stratified by split."
        )

    daily = pd.read_csv(split_path, parse_dates=["date"])

    if "cluster_index" not in daily.columns:
        raise ValueError(
            f"{city}_regimes.csv has no cluster_index column. "
            f"Re-run 06_fit_final_clusters.py."
        )

    centroids = pd.read_csv(
        base / f"{city}_cluster_centroids_standardized.csv"
    )

    with open(base / f"{city}_scaler.json") as f:
        scaler_info = json.load(f)

    if scaler_info["features"] != config.FEATURES:
        raise ValueError(
            "Saved scaler features do not match config.FEATURES. "
            "Re-run 06."
        )

    mean = np.array(scaler_info["mean"])
    scale = np.array(scaler_info["scale"])

    # -----------------------------------------------------
    # STANDARDIZE WITH THE SAVED SCALER
    # -----------------------------------------------------
    #
    # Reusing the fitted scaler rather than re-fitting keeps this
    # projection identical to the one used for clustering.
    # -----------------------------------------------------

    Z = (daily[config.FEATURES].values - mean) / scale

    # -----------------------------------------------------
    # REPRESENTATIVE DAY PER REGIME
    # -----------------------------------------------------

    representatives = []

    for _, centroid_row in centroids.iterrows():

        cluster_index = int(centroid_row["cluster_index"])
        regime = centroid_row["regime"]

        mask = daily["cluster_index"].values == cluster_index
        positions = np.where(mask)[0]

        if positions.size == 0:
            print(f"  WARNING: no days in cluster {cluster_index}")
            continue

        centroid = centroid_row[config.FEATURES].values.astype(float)

        distances = np.linalg.norm(Z[positions] - centroid, axis=1)

        best = positions[int(np.argmin(distances))]

        representatives.append(
            {
                "date": daily.loc[best, "date"],
                "regime": regime,
                "cluster_index": cluster_index,
                "distance_to_centroid": float(distances.min()),
                "selection": "representative",
            }
        )

    representatives = pd.DataFrame(representatives)

    representatives.to_csv(
        base / f"{city}_representative_days.csv", index=False
    )

    # -----------------------------------------------------
    # RANDOM SAMPLE PER REGIME
    # -----------------------------------------------------

    total = config.N_SAMPLE_PER_REGIME

    n_test = max(1, round(total * config.TEST_SIZE))
    n_train = max(1, total - n_test)

    quota = {"train": n_train, "test": n_test}

    print(
        f"\n  Target per regime: {n_train} train + {n_test} test "
        f"= {n_train + n_test}"
    )

    samples = []

    for regime, subset in daily.groupby("regime"):

        for split_name, target in quota.items():

            pool = subset[subset["split"] == split_name]

            if pool.empty:
                print(
                    f"  WARNING: regime {regime} has no {split_name} "
                    f"days at all. Phase 5 cannot evaluate it on "
                    f"{split_name}."
                )
                continue

            n = min(target, len(pool))

            if n < target:
                print(
                    f"  NOTE: regime {regime} has only {len(pool)} "
                    f"{split_name} days; taking all of them."
                )

            chosen = pool.sample(
                n=n, random_state=config.RANDOM_SEED
            )

            samples.append(
                chosen[["date", "regime", "cluster_index", "split"]]
            )

    samples = pd.concat(samples, ignore_index=True)
    samples["selection"] = "sampled"

    samples = samples.sort_values(
        ["regime", "date"]
    ).reset_index(drop=True)

    samples.to_csv(
        base / f"{city}_sampled_days.csv", index=False
    )

    # -----------------------------------------------------
    # REPORT
    # -----------------------------------------------------

    report = representatives[
        ["regime", "date", "distance_to_centroid"]
    ].copy()

    report["date"] = report["date"].dt.date
    report["distance_to_centroid"] = (
        report["distance_to_centroid"].round(3)
    )

    print("\n  Representative days:")
    print(report.to_string(index=False))

    print("\n  Sampled days by regime and split:")
    print(
        pd.crosstab(samples["regime"], samples["split"]).to_string()
    )

    print(f"\n  Saved outputs to {base}")


def main():

    cities = utils.parse_cities("Select days for Phase 3.")

    for city in cities:
        select(city)


if __name__ == "__main__":
    main()

# 04_build_daily_features.py
"""
Hourly NetCDF (all years) -> one row per local day of clustering features.

Features: mean u and v in each of four 6-hour local-time blocks, plus daily
mean boundary-layer height.

Usage:
    python 04_build_daily_features.py --all
    python 04_build_daily_features.py --city melbourne
"""

import pandas as pd
import xarray as xr

import config
import utils


def build(city):

    utils.banner(f"DAILY FEATURES: {city}")

    in_dir = config.processed_dir(city)

    files = [
        in_dir / f"{city}_hourly_{year}.nc"
        for year in config.YEARS
    ]

    missing = [f for f in files if not f.exists()]

    if missing:
        raise FileNotFoundError(
            "Missing processed files (run 02 first):\n  "
            + "\n  ".join(str(f) for f in missing)
        )

    ds = xr.open_mfdataset(files, combine="by_coords")
    ds = ds.sortby("time")

    # -----------------------------------------------------
    # 1. SPATIAL MEAN
    # -----------------------------------------------------
    #
    # Regimes are defined at city scale: one row per timestep, not per
    # grid cell. Spatial structure of transport is handled in Phase 3.
    # -----------------------------------------------------

    dims = utils.spatial_dims(ds)

    city_mean = ds.mean(dim=dims) if dims else ds

    df = (
        city_mean[["u10", "v10", "blh"]]
        .to_dataframe()
        .reset_index()
    )

    df["time"] = pd.to_datetime(df["time"])

    # -----------------------------------------------------
    # 2. LOCAL TIME
    # -----------------------------------------------------

    df["local_time"] = utils.to_local(df["time"], city)

    df["date"] = df["local_time"].dt.normalize()
    df["hour"] = df["local_time"].dt.hour

    df["block"] = df["hour"].map(utils.assign_block)

    # -----------------------------------------------------
    # 3. DROP INCOMPLETE DAYS
    # -----------------------------------------------------
    #
    # The first and last local days of the record are always partial
    # because of the UTC offset. If USE_DST is True, the two DST
    # transition days each year are also dropped (23 or 25 hours).
    # -----------------------------------------------------

    hours_per_day = df.groupby("date").size()

    complete = hours_per_day[hours_per_day == 24].index

    dropped = len(hours_per_day) - len(complete)

    print(f"  Days with 24 hours: {len(complete)}  (dropped {dropped})")

    df = df[df["date"].isin(complete)].copy()

    # -----------------------------------------------------
    # 4. BLOCK MEANS -> WIDE
    # -----------------------------------------------------

    block = (
        df.groupby(["date", "block"])[["u10", "v10"]]
        .mean()
        .reset_index()
    )

    u = block.pivot(index="date", columns="block", values="u10")
    v = block.pivot(index="date", columns="block", values="v10")

    u.columns = [f"u{i}" for i in u.columns]
    v.columns = [f"v{i}" for i in v.columns]

    # -----------------------------------------------------
    # 5. DAILY PBLH
    # -----------------------------------------------------

    pblh = df.groupby("date")["blh"].mean().rename("pblh_mean")

    # -----------------------------------------------------
    # 6. COMBINE
    # -----------------------------------------------------

    daily = pd.concat([u, v, pblh], axis=1)

    expected_cols = set(config.FEATURES)
    actual_cols = set(daily.columns)

    if expected_cols != actual_cols:
        raise ValueError(
            f"Feature columns do not match config.FEATURES.\n"
            f"  Missing: {expected_cols - actual_cols}\n"
            f"  Extra:   {actual_cols - expected_cols}"
        )

    daily = daily[config.FEATURES].reset_index()

    daily = daily.sort_values("date").reset_index(drop=True)

    # -----------------------------------------------------
    # 7. CHECK
    # -----------------------------------------------------

    print(f"\n  Rows: {len(daily)}")
    print(f"  Date range: {daily['date'].min().date()} "
          f"to {daily['date'].max().date()}")

    if daily.isna().any().any():
        print(daily.isna().sum())
        raise ValueError("Missing daily feature values detected.")

    print("\n  Feature summary:")
    print(daily[config.FEATURES].describe().round(2).T.to_string())

    # -----------------------------------------------------
    # 8. SAVE
    # -----------------------------------------------------

    out = in_dir / f"{city}_daily_features.csv"

    daily.to_csv(out, index=False)

    print(f"\n  Saved {out}")


def main():

    cities = utils.parse_cities("Build daily clustering features.")

    for city in cities:
        build(city)


if __name__ == "__main__":
    main()

# 05_cluster_sweep.py
"""
Sweep candidate k values and report cluster-validity diagnostics, so the
final choice of k is justified rather than assumed.

Reports four things, because no single index is decisive:
  - inertia          (elbow plot)
  - silhouette       (higher is better)
  - Calinski-Harabasz (higher is better)
  - Davies-Bouldin   (LOWER is better)

Plus cluster sizes, because a k that produces a 5-day cluster is useless
for Phase 3 no matter how good its silhouette is.

Usage:
    python 05_cluster_sweep.py --all
"""

import matplotlib

matplotlib.use("Agg")

import matplotlib.pyplot as plt
import pandas as pd

from sklearn.cluster import KMeans
from sklearn.metrics import (
    calinski_harabasz_score,
    davies_bouldin_score,
    silhouette_score,
)
from sklearn.preprocessing import StandardScaler

import config
import utils


def sweep(city):

    utils.banner(f"CLUSTER SWEEP: {city}")

    in_path = (
        config.processed_dir(city) / f"{city}_daily_features.csv"
    )

    if not in_path.exists():
        raise FileNotFoundError(
            f"{in_path} not found; run 04 first."
        )

    out = config.output_dir(city, "clustering")

    daily = pd.read_csv(in_path, parse_dates=["date"])

    X = daily[config.FEATURES]

    Z = StandardScaler().fit_transform(X)

    results = []

    for k in config.K_RANGE:

        model = KMeans(
            n_clusters=k,
            n_init=config.KMEANS_N_INIT,
            random_state=config.RANDOM_SEED,
        )

        labels = model.fit_predict(Z)

        counts = pd.Series(labels).value_counts()

        results.append(
            {
                "k": k,
                "inertia": model.inertia_,
                "silhouette": silhouette_score(Z, labels),
                "calinski_harabasz": calinski_harabasz_score(Z, labels),
                "davies_bouldin": davies_bouldin_score(Z, labels),
                "smallest_cluster": int(counts.min()),
                "largest_cluster": int(counts.max()),
                "smallest_frac": float(counts.min() / len(labels)),
            }
        )

        candidate = daily.copy()
        candidate["cluster"] = labels
        candidate.to_csv(out / f"candidate_k{k}.csv", index=False)

    results = pd.DataFrame(results)

    results.to_csv(out / "cluster_sweep.csv", index=False)

    print("\n" + results.round(3).to_string(index=False))

    # -----------------------------------------------------
    # DIAGNOSTIC FIGURE
    # -----------------------------------------------------

    fig, axes = plt.subplots(2, 2, figsize=(10, 7))

    panels = [
        ("inertia", "Inertia (elbow)", axes[0][0]),
        ("silhouette", "Silhouette (higher better)", axes[0][1]),
        ("calinski_harabasz", "Calinski-Harabasz (higher better)",
         axes[1][0]),
        ("davies_bouldin", "Davies-Bouldin (LOWER better)", axes[1][1]),
    ]

    for column, title, ax in panels:
        ax.plot(results["k"], results[column], marker="o")
        ax.set_xlabel("Number of clusters (k)")
        ax.set_title(title, fontsize=10)
        ax.set_xticks(list(config.K_RANGE))
        ax.grid(alpha=0.3)

    fig.suptitle(f"{city.title()}: cluster validity by k")
    fig.tight_layout()
    fig.savefig(out / "cluster_validity.png", dpi=200)
    plt.close(fig)

    print(f"\n  Figures and candidate labels saved to {out}")

    # -----------------------------------------------------
    # GUIDANCE
    # -----------------------------------------------------

    print(
        "\n  Choose k by BOTH the metrics above and physical "
        "interpretability."
    )
    print(
        "  Inspect candidate_k*.csv, then run 07 on a trial k to see "
        "whether the"
    )
    print(
        "  regimes map onto real meteorology (monsoon phases for "
        "Singapore;"
    )
    print(
        "  frontal / northerly / onshore types for Melbourne). A cluster "
        "holding"
    )
    print(
        "  under ~5% of days is usually too rare to sample for Phase 3."
    )
    print(
        f"\n  Then set CITIES['{city}']['final_k'] in config.py and run 06."
    )


def main():

    cities = utils.parse_cities("Sweep candidate k values.")

    for city in cities:
        sweep(city)


if __name__ == "__main__":
    main()

# 10_build_phase3_days.py
"""
THIS IS THE SCRIPT THAT WAS MISSING FROM YOUR PIPELINE.

Your 10_extract_phase3_data.py reads <city>_phase3_days.csv with columns
date, regime, split -- but nothing in 01-09 produced that file. Scripts 08
and 09 each had half of it:

    08 -> representative_days.csv, sampled_days.csv   (date, regime)
    09 -> regimes_split.csv                           (date, regime, split)

This joins them into the manifest Phase 3 consumes.

Outputs <city>_phase3_days.csv with columns:
    date, regime, cluster_index, split, selection, w_k

w_k is carried through so Phase 3 can weight each simulated scenario by
its regime's historical frequency without re-reading the summary file.

Usage:
    python 10_build_phase3_days.py --all
    python 10_build_phase3_days.py --all --include-representative
"""

import argparse
import json

import pandas as pd

import config
import utils


def build(city, include_representative):

    utils.banner(f"PHASE 3 MANIFEST: {city}")

    base = config.processed_dir(city)

    required = {
        "sampled": base / f"{city}_sampled_days.csv",
        "split": base / f"{city}_regimes_split.csv",
        "weights": base / f"{city}_regime_weights.json",
    }

    for name, path in required.items():
        if not path.exists():
            raise FileNotFoundError(
                f"Missing {name} file: {path}\n"
                f"Run scripts 07, 08 and 09 first."
            )

    sampled = pd.read_csv(required["sampled"], parse_dates=["date"])

    frames = [sampled]

    if include_representative:

        rep_path = base / f"{city}_representative_days.csv"

        representatives = pd.read_csv(rep_path, parse_dates=["date"])

        frames.append(
            representatives[
                ["date", "regime", "cluster_index", "selection"]
            ]
        )

    selected = pd.concat(frames, ignore_index=True)

    # A representative day may also have been drawn in the random sample.
    # Keep one row per date, preferring the "representative" tag.
    selected["priority"] = (
        selected["selection"].eq("representative").astype(int)
    )

    selected = (
        selected
        .sort_values(["date", "priority"], ascending=[True, False])
        .drop_duplicates(subset="date", keep="first")
        .drop(columns="priority")
    )

    # -----------------------------------------------------
    # JOIN THE SPLIT LABEL
    # -----------------------------------------------------

    splits = pd.read_csv(
        required["split"], parse_dates=["date"]
    )[["date", "split"]]

    # 08 already carries a split column; drop it so the merge below is the
    # single source of truth rather than producing split_x / split_y.
    selected = selected.drop(columns=["split"], errors="ignore")

    manifest = selected.merge(splits, on="date", how="left")

    unmatched = manifest["split"].isna().sum()

    if unmatched:
        raise ValueError(
            f"{unmatched} selected days had no split label. "
            f"Scripts 08 and 09 may have been run on different versions "
            f"of {city}_regimes.csv -- re-run both."
        )

    # -----------------------------------------------------
    # ATTACH REGIME WEIGHTS
    # -----------------------------------------------------

    with open(required["weights"]) as f:
        weights = json.load(f)["weights"]

    manifest["w_k"] = manifest["regime"].map(weights)

    if manifest["w_k"].isna().any():
        raise ValueError(
            "Some regimes have no weight. Re-run 07."
        )

    manifest = (
        manifest
        .sort_values(["regime", "date"])
        .reset_index(drop=True)
    )

    manifest = manifest[
        ["date", "regime", "cluster_index", "split", "selection", "w_k"]
    ]

    out = base / f"{city}_phase3_days.csv"

    manifest.to_csv(out, index=False)

    # -----------------------------------------------------
    # REPORT
    # -----------------------------------------------------

    print(f"\n  Total days selected: {len(manifest)}")

    print("\n  Days by regime and split:")
    print(
        pd.crosstab(
            manifest["regime"], manifest["split"]
        ).to_string()
    )

    print("\n  Regime weights carried forward:")
    for regime, weight in sorted(weights.items()):
        print(f"    {regime}: {weight:.4f}")

    print(f"\n  Saved {out}")


def main():

    parser = argparse.ArgumentParser(
        description="Build the Phase 3 day manifest."
    )

    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--city", choices=config.ALL_CITIES)
    group.add_argument("--all", action="store_true")

    parser.add_argument(
        "--include-representative",
        action="store_true",
        help=(
            "Also include the single centroid-nearest day per regime, "
            "tagged selection=representative."
        ),
    )

    args = parser.parse_args()

    cities = config.ALL_CITIES if args.all else [args.city]

    for city in cities:
        build(city, args.include_representative)


if __name__ == "__main__":
    main()

# 09_split_train_test.py
"""
Assign every day to train or test.

Two modes, set by config.SPLIT_MODE:

  "stratified_random"
      Random days, stratified so each regime keeps its proportions.
      Caveat worth stating in your methods: consecutive days are
      meteorologically correlated, so a random split leaks information
      between train and test. Day 100 in train and day 101 in test are
      not independent samples.

  "temporal"
      Hold out whole years (config.HOLDOUT_YEARS). Cleaner independence,
      and the more defensible choice if a judge asks. The trade-off is
      that regime proportions in the held-out year may differ from the
      training years, which is itself informative.

Usage:
    python 09_split_train_test.py --all
"""

import pandas as pd

from sklearn.model_selection import train_test_split

import config
import utils


def split(city):

    utils.banner(f"TRAIN/TEST SPLIT: {city}  (mode={config.SPLIT_MODE})")

    base = config.processed_dir(city)

    daily = pd.read_csv(
        base / f"{city}_regimes.csv",
        parse_dates=["date"],
    )

    if config.SPLIT_MODE == "stratified_random":

        train_idx, test_idx = train_test_split(
            daily.index,
            test_size=config.TEST_SIZE,
            random_state=config.RANDOM_SEED,
            stratify=daily["regime"],
        )

        daily["split"] = "train"
        daily.loc[test_idx, "split"] = "test"

    elif config.SPLIT_MODE == "temporal":

        is_holdout = daily["date"].dt.year.isin(config.HOLDOUT_YEARS)

        daily["split"] = "train"
        daily.loc[is_holdout, "split"] = "test"

        if not is_holdout.any():
            raise ValueError(
                f"No days found in HOLDOUT_YEARS={config.HOLDOUT_YEARS}"
            )

    else:
        raise ValueError(
            f"Unknown SPLIT_MODE: {config.SPLIT_MODE!r}"
        )

    # -----------------------------------------------------
    # CHECK EVERY REGIME APPEARS IN BOTH SPLITS
    # -----------------------------------------------------

    table = pd.crosstab(daily["regime"], daily["split"])

    for column in ["train", "test"]:
        if column not in table.columns:
            raise ValueError(f"No days assigned to {column}.")

    empty = table[(table["train"] == 0) | (table["test"] == 0)]

    if len(empty):
        print(
            f"  WARNING: some regimes are absent from one split:\n{empty}"
        )

    daily.to_csv(
        base / f"{city}_regimes_split.csv", index=False
    )

    print("\n" + table.to_string())

    print("\n  Proportions within regime:")
    print(
        pd.crosstab(
            daily["regime"], daily["split"], normalize="index"
        ).round(3).to_string()
    )

    print(f"\n  Saved {base / f'{city}_regimes_split.csv'}")


def main():

    cities = utils.parse_cities("Split days into train and test.")

    for city in cities:
        split(city)


if __name__ == "__main__":
    main()

# 03_qc_hourly.py
"""
Quality control on the processed hourly files.

Checks missing values, physical ranges, time continuity, and writes
histograms plus a sample time series. Also writes a machine-readable
qc_summary.csv you can cite in your methods section.

Usage:
    python 03_qc_hourly.py --all
    python 03_qc_hourly.py --city singapore --year 2021
"""

import matplotlib

matplotlib.use("Agg")

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import xarray as xr

import config
import utils


# Physically plausible ranges. Anything outside these is a red flag.
PLAUSIBLE = {
    "u10": (-60.0, 60.0),
    "v10": (-60.0, 60.0),
    "wind_speed": (0.0, 80.0),
    "blh": (0.0, 5000.0),
    "t2m_c": (-30.0, 55.0),
    "tp": (0.0, 0.5),
}


def qc(city, year, records):

    utils.banner(f"QC: {city} {year}")

    path = config.processed_dir(city) / f"{city}_hourly_{year}.nc"

    if not path.exists():
        print(f"  Missing {path.name}; run 02 first.")
        return

    out = config.output_dir(city, "qc")

    ds = xr.open_dataset(path)

    row = {"city": city, "year": year}

    # -----------------------------------------------------
    # 1. MISSING VALUES AND RANGES
    # -----------------------------------------------------

    print(f"\n  {'variable':16s} {'missing':>10s} {'min':>12s} {'max':>12s}")

    for var in ["u10", "v10", "wind_speed", "blh", "t2m_c", "tp"]:

        if var not in ds:
            continue

        missing = int(ds[var].isnull().sum())
        minimum = float(ds[var].min())
        maximum = float(ds[var].max())

        print(
            f"  {var:16s} {missing:10d} {minimum:12.3f} {maximum:12.3f}"
        )

        row[f"{var}_missing"] = missing
        row[f"{var}_min"] = minimum
        row[f"{var}_max"] = maximum

        low, high = PLAUSIBLE.get(var, (-np.inf, np.inf))

        if minimum < low or maximum > high:
            print(
                f"    WARNING: {var} outside plausible range "
                f"[{low}, {high}]"
            )

    if float(ds["wind_speed"].min()) < 0:
        raise ValueError("Negative wind speed detected.")

    # -----------------------------------------------------
    # 2. TIME CONTINUITY
    # -----------------------------------------------------

    times = pd.DatetimeIndex(ds["time"].values)

    expected = pd.date_range(times.min(), times.max(), freq="h")

    gaps = expected.difference(times)

    print(f"\n  Missing hourly timestamps: {len(gaps)}")

    if len(gaps):
        print(f"    first few: {list(gaps[:5])}")

    row["missing_timestamps"] = len(gaps)
    row["n_timesteps"] = len(times)

    # -----------------------------------------------------
    # 3. DOMAIN MEAN FOR PLOTS
    # -----------------------------------------------------

    dims = utils.spatial_dims(ds)
    city_mean = ds.mean(dim=dims) if dims else ds

    # -----------------------------------------------------
